{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "__SET_VIA_USER_SECRETS_OR_ENV__"
  },
  "JwtSettings": {
    "Secret": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "Issuer": "AccountingAPI",
    "Audience": "AccountingClient",
    "ExpiryMinutes": 60,
    "ClockSkewSeconds": 60
  },
  "AuthSecurity": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimiting": {
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      "RegisterCompany": {
        "PermitLimit": 3,
        "WindowSeconds": 600
      },
      "ChangePassword": {
        "PermitLimit": 5,
        "WindowSeconds": 600
      }
    }
  },
  "PayMongo": {
    "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "PublicKey": "__SET_VIA_USER_SECRETS_OR_ENV__"
  },
  "Recaptcha": {
    "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "ScoreThreshold": 0.5
  }
}
