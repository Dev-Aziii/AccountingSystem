@using Microsoft.AspNetCore.Components.Authorization
@using AccountingSystem.Client.Shared
@using MudBlazor

<CascadingAuthenticationState>
    <MudThemeProvider Theme="_shadcnTheme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <div class="alert alert-danger m-4">
                                <h4>Access Denied</h4>
                                <p>You are logged in, but you do not have permission to access this page.</p>
                            </div>
                        </LayoutView>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert" class="p-4">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private MudTheme _shadcnTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0f172a", 
            Secondary = "#64748b", 
            AppbarBackground = "#ffffff",
            AppbarText = "#0f172a",
            Background = "#f8fafc",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#0f172a",
            ActionDefault = "#64748b"
        }
    };
}