@inherits LayoutComponentBase
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager

<MudLayout Class="main-layout">
    <MudAppBar Class="app-bar-white" Elevation="0">
        <div class="app-bar-content">

            <!-- Hamburger -->
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Default"
                           Edge="Edge.Start"
                           Class="menu-toggle"
                           OnClick="@((e) => DrawerToggle())" />

            <!-- Brand -->
            <div class="brand-section">
                <img src="AccsysLogo.png" alt="AccSys Logo" class="app-logo" />
                <div class="brand-text">
                    <MudText Typo="Typo.h6" Class="app-title">AccSys</MudText>
                    <AuthorizeView>
                        <Authorized Context="authContext">
                            <MudText Typo="Typo.caption" Class="company-name">
                                @(authContext.User.FindFirst("CompanyName")?.Value ?? "Multi-Tenant Edition")
                            </MudText>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>


            <!-- User -->
            <AuthorizeView>
                <Authorized Context="authContext">
                    <div class="user-section">
                        <MudMenu AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text"
                                           Class="user-button"
                                           EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                                    <div class="user-info">
                                        <MudAvatar Class="user-avatar" Size="Size.Small">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                        </MudAvatar>
                                        <div class="user-text">
                                            <MudText Typo="Typo.body2" Class="user-name">
                                                @(authContext.User.FindFirst("FullName")?.Value
                                                                                                ?? authContext.User.Identity?.Name)
                                            </MudText>
                                        </div>
                                    </div>
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <div class="user-menu-content">
                                    <MudMenuItem Href="/profile"
                                                 Icon="@Icons.Material.Filled.Person"
                                                 Class="menu-item">
                                        My Profile
                                    </MudMenuItem>
                                    <MudDivider Class="my-1" />
                                    <MudMenuItem OnClick="Logout"
                                                 Icon="@Icons.Material.Filled.Logout"
                                                 Class="menu-item logout-item">
                                        Logout
                                    </MudMenuItem>
                                </div>
                            </ChildContent>
                        </MudMenu>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="auth-buttons">
                        <MudButton Variant="Variant.Filled"
                                   Class="login-button"
                                   Href="/"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Login
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Class="register-button"
                                   Href="/register"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AppRegistration">
                            Register
                        </MudButton>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Class="nav-drawer"
               Elevation="0">
        <div class="drawer-content">
            <div class="drawer-header">
                <MudText Typo="Typo.caption" Class="drawer-title">Navigation</MudText>
            </div>
            <NavMenu />
        </div>
    </MudDrawer>

    <MudMainContent Class="main-content">
        <div class="page-wrapper">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    string _searchText = string.Empty;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task Logout()
    {
        await AuthService.Logout();
        NavManager.NavigateTo("/");
    }
}
