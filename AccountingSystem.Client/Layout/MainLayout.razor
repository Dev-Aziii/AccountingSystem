@inherits LayoutComponentBase
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager

<MudLayout Class="shadcn-layout">
    <MudAppBar Class="shadcn-app-bar" Elevation="0">

        <div class="app-bar-content">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           Class="menu-toggle"
                           OnClick="@((e) => DrawerToggle())" />

            <div class="brand-section">
                <img src="AccsysLogo.png" alt="AccSys Logo" class="app-logo" />
                <div class="brand-text">
                    <span class="app-title">AccSys</span>
                    <AuthorizeView>
                        <Authorized Context="authContext">
                            <span class="company-name">
                                @(authContext.User.FindFirst("CompanyName")?.Value ?? "Multi-Tenant Edition")
                            </span>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>

            <MudSpacer />

            <AuthorizeView>
                <Authorized Context="authContext">
                    <div class="user-section">
                        <MudMenu AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="user-menu"
                                 ListClass="shadcn-menu-list">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text"
                                           Class="user-ghost-button"
                                           EndIcon="@Icons.Material.Outlined.ExpandMore">
                                    <div class="user-info">
                                        <MudAvatar Class="user-avatar" Size="Size.Small">
                                            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                                        </MudAvatar>
                                        <span class="user-name">
                                            @(authContext.User.FindFirst("FullName")?.Value ?? authContext.User.Identity?.Name)
                                        </span>
                                    </div>
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <div class="user-menu-content">
                                    <div class="menu-header">
                                        <div class="menu-header-title">My Account</div>
                                    </div>
                                    <MudDivider Class="my-1" />
                                    <MudMenuItem Href="/profile"
                                                 Icon="@Icons.Material.Outlined.AccountCircle"
                                                 Class="shadcn-menu-item">
                                        Profile
                                    </MudMenuItem>
                                    <MudDivider Class="my-1" />
                                    <MudMenuItem OnClick="Logout"
                                                 Icon="@Icons.Material.Outlined.Logout"
                                                 Class="shadcn-menu-item logout-item">
                                        Log out
                                    </MudMenuItem>
                                </div>
                            </ChildContent>
                        </MudMenu>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="auth-buttons">
                        <MudButton Variant="Variant.Text"
                                   Class="shadcn-btn-ghost"
                                   Href="/login">
                            Log in
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Class="shadcn-btn-primary"
                                   Href="/register">
                            Register
                        </MudButton>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Class="shadcn-drawer"
               Elevation="0">
        <div class="drawer-content">
            <NavMenu />
        </div>
    </MudDrawer>

    <MudMainContent Class="shadcn-main-content">
        <div class="page-wrapper">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<style>
    /* CSS Variables for Shadcn equivalents (fallback to hardcoded if not using variables) */
    :root {
        --border-color: #e2e8f0;
        --bg-background: #f8fafc;
        --bg-surface: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --radius-md: 6px;
    }

    /* Main Layout */
    .shadcn-layout {
        min-height: 100vh;
        background-color: var(--bg-background);
        color: var(--text-main);
    }

    /* Flat, bordered App Bar */
    .shadcn-app-bar {
        background-color: var(--bg-surface) !important;
        color: var(--text-main) !important;
        border-bottom: 1px solid var(--border-color);
    }

    .app-bar-content {
        width: 100%;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        height: 64px;
    }

    /* Flat ghost button for menu toggle */
    .menu-toggle {
        margin-right: 1rem;
        border-radius: var(--radius-md) !important;
        color: var(--text-muted) !important;
        transition: background-color 0.15s ease !important;
    }

        .menu-toggle:hover {
            background-color: #f1f5f9 !important;
            color: var(--text-main) !important;
        }

    /* Brand Section */
    .brand-section {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .app-logo {
        height: 28px;
        width: auto;
    }

    .brand-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .app-title {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.025em;
        line-height: 1.1;
        color: var(--text-main);
    }

    .company-name {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-muted);
    }

    /* User Section (Ghost Button style) */
    .user-ghost-button {
        padding: 6px 12px !important;
        border-radius: var(--radius-md) !important;
        color: var(--text-main) !important;
        transition: background-color 0.15s ease !important;
        text-transform: none !important; /* Remove uppercase */
    }

        .user-ghost-button:hover {
            background-color: #f1f5f9 !important;
        }

    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-avatar {
        background-color: #f1f5f9 !important;
        color: var(--text-main) !important;
        border: 1px solid var(--border-color);
        width: 28px !important;
        height: 28px !important;
    }

    .user-name {
        font-size: 0.875rem;
        font-weight: 500;
    }

    /* Dropdown Menu */
    .user-menu-content {
        min-width: 220px;
        padding: 4px;
    }

    .menu-header {
        padding: 8px 12px;
    }

    .menu-header-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-main);
    }

    .shadcn-menu-item {
        border-radius: 4px !important;
        font-size: 0.875rem !important;
        padding: 8px 12px !important;
        margin: 2px 0 !important;
        color: var(--text-main) !important;
    }

        .shadcn-menu-item:hover {
            background-color: #f1f5f9 !important;
        }

    .logout-item:hover {
        background-color: #fef2f2 !important;
        color: #ef4444 !important;
    }

    /* Auth Buttons */
    .auth-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .shadcn-btn-ghost {
        border-radius: var(--radius-md) !important;
        text-transform: none !important;
        font-weight: 500 !important;
        color: var(--text-main) !important;
    }

        .shadcn-btn-ghost:hover {
            background-color: #f1f5f9 !important;
        }

    .shadcn-btn-primary {
        border-radius: var(--radius-md) !important;
        text-transform: none !important;
        font-weight: 500 !important;
        background-color: var(--theme-primary) !important; /* Still respects your theme */
        color: white !important;
        box-shadow: none !important; /* Flat */
        padding: 6px 16px !important;
    }

        .shadcn-btn-primary:hover {
            opacity: 0.9;
        }

    /* Navigation Drawer */
    .shadcn-drawer {
        background-color: var(--bg-surface) !important;
        border-right: 1px solid var(--border-color) !important;
    }

    .drawer-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    fapp
    /* Main Content */
    .shadcn-main-content {
        min-height: calc(100vh - 64px);
    }

    .page-wrapper {
        padding: 1.5rem; /* Standard shadcn content padding */
        min-height: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Fixed Media Queries */
    @@media (max-width: 768px) {
        .user-name

    {
        display: none;
    }

    .page-wrapper {
        padding: 1rem;
    }

    }

    @@media (max-width: 480px) {
        .app-bar-content

    {
        padding: 0 0.75rem;
    }

    .company-name {
        display: none;
    }

    }
</style>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        NavManager.NavigateTo("/");
    }
}