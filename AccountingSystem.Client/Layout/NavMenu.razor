@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="shadcn-nav-wrapper">
    <MudNavMenu Dense="true" Class="shadcn-nav-menu">

        <AuthorizeView Roles="SuperAdmin">
            <MudNavLink Href="superadmin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Security">Super Admin</MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Overview</MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <MudNavLink Href="admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings">Administration</MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting">
            <MudNavLink Href="gl" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AccountBalance">General Ledger</MudNavLink>
            <MudNavLink Href="ap" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.RequestQuote">Accounts Payable</MudNavLink>
            <MudNavLink Href="ar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ReceiptLong">Accounts Receivable</MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <MudNavLink Href="reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Analytics">Reporting</MudNavLink>
        </AuthorizeView>

    </MudNavMenu>
</div>

<style>
    /* ── Wrapper ─────────────────────────────────────────── */
    .shadcn-nav-wrapper {
        padding: 0.5rem 0;
    }

    .shadcn-nav-menu {
        padding: 0 !important;
    }

    /* ── Nav Links ────────────────────────────────────────── */
    .shadcn-nav-menu .mud-nav-link {
        color: var(--text-muted) !important;
        margin: 1px 8px !important;
        border-radius: 6px !important;
        padding: 7px 10px !important;
        font-size: 0.875rem !important;
        font-weight: 500 !important;
        transition: background-color 0.15s ease, color 0.15s ease !important;
        line-height: 1.4;
    }

        /* Hover */
        .shadcn-nav-menu .mud-nav-link:hover {
            background-color: var(--bg-muted) !important;
            color: var(--text-main) !important;
        }

        /* Active — both classes MudBlazor can apply */
        .shadcn-nav-menu .mud-nav-link.active,
        .shadcn-nav-menu .mud-nav-link-active {
            background-color: var(--bg-muted) !important;
            color: var(--text-main) !important;
            font-weight: 600 !important;
        }

    /* ── Icons ────────────────────────────────────────────── */
    .shadcn-nav-menu .mud-nav-link-icon {
        color: inherit !important;
        margin-right: 10px !important;
        font-size: 1rem !important;
        opacity: 0.75;
        flex-shrink: 0;
    }

    .shadcn-nav-menu .mud-nav-link:hover .mud-nav-link-icon,
    .shadcn-nav-menu .mud-nav-link.active .mud-nav-link-icon,
    .shadcn-nav-menu .mud-nav-link-active .mud-nav-link-icon {
        opacity: 1;
    }
</style>
