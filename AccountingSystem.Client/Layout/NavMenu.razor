@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="nav-root">
    <MudNavMenu Dense="false" Class="nav-menu">

        <AuthorizeView Roles="SuperAdmin">
            <MudNavLink Href="superadmin/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Security">
                System Overview
            </MudNavLink>
            <MudNavLink Href="superadmin/tenants" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Business">
                Tenant Manager
            </MudNavLink>
            <MudNavLink Href="superadmin/users" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">
                Global Users
            </MudNavLink>
            <MudNavLink Href="superadmin/audit-logs" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">
                Admin Audit Logs
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <div class="nav-group-label">
                <span>Administration</span>
            </div>
            <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">
                User Management
            </MudNavLink>
            <MudNavLink Href="admin/audit-logs" Icon="@Icons.Material.Filled.History">
                Audit Logs
            </MudNavLink>
            <MudNavLink Href="admin/company-settings" Icon="@Icons.Material.Filled.Business">
                Company Settings
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting">
            <div class="nav-group-label">
                <span>General Ledger</span>
            </div>
            <MudNavLink Href="gl/journal" Icon="@Icons.Material.Filled.EditNote">
                Journal Entries
            </MudNavLink>
            <MudNavLink Href="gl/accounts" Icon="@Icons.Material.Filled.AccountTree">
                Chart of Accounts
            </MudNavLink>

            <div class="nav-group-label">
                <span>Accounts Payable</span>
            </div>
            <MudNavLink Href="ap/bills" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.NoteAdd">
                Create Vendor Bill
            </MudNavLink>
            <MudNavLink Href="ap/bills/list" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">
                Bills List
            </MudNavLink>
            <MudNavLink Href="ap/vendors" Icon="@Icons.Material.Filled.Store">
                Vendors
            </MudNavLink>

            <div class="nav-group-label">
                <span>Accounts Receivable</span>
            </div>
            <MudNavLink Href="ar/invoices" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.NoteAdd">
                Create Invoice
            </MudNavLink>
            <MudNavLink Href="ar/invoices/list" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">
                Invoice List
            </MudNavLink>
            <MudNavLink Href="ar/customers" Icon="@Icons.Material.Filled.Groups">
                Customers
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <div class="nav-group-label">
                <span>Reporting</span>
            </div>
            <MudNavLink Href="reports/financials" Icon="@Icons.Material.Filled.Analytics">
                Financial Statements
            </MudNavLink>
        </AuthorizeView>

    </MudNavMenu>
</div>

