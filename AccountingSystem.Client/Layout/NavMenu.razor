@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="nav-root">
    <MudNavMenu Dense="false" Class="nav-menu">

        <AuthorizeView Roles="SuperAdmin">
            <MudNavLink Href="superadmin/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Security">
                System Overview
            </MudNavLink>
            <MudNavLink Href="superadmin/tenants" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Business">
                Tenant Manager
            </MudNavLink>
            <MudNavLink Href="superadmin/users" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">
                Global Users
            </MudNavLink>
            <MudNavLink Href="superadmin/audit-logs" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">
                Admin Audit Logs
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <div class="nav-group-label">
                <span>Administration</span>
            </div>
            <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">
                User Management
            </MudNavLink>
            <MudNavLink Href="admin/audit-logs" Icon="@Icons.Material.Filled.History">
                Audit Logs
            </MudNavLink>
            <MudNavLink Href="admin/company-settings" Icon="@Icons.Material.Filled.Business">
                Company Settings
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting">
            <div class="nav-group-label">
                <span>General Ledger</span>
            </div>
            <MudNavLink Href="gl/journal" Icon="@Icons.Material.Filled.EditNote">
                Journal Entries
            </MudNavLink>
            <MudNavLink Href="gl/accounts" Icon="@Icons.Material.Filled.AccountTree">
                Chart of Accounts
            </MudNavLink>

            <div class="nav-group-label">
                <span>Accounts Payable</span>
            </div>
            <MudNavLink Href="ap/bills" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.NoteAdd">
                Create Vendor Bill
            </MudNavLink>
            <MudNavLink Href="ap/bills/list" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">
                Bills List
            </MudNavLink>
            <MudNavLink Href="ap/vendors" Icon="@Icons.Material.Filled.Store">
                Vendors
            </MudNavLink>

            <div class="nav-group-label">
                <span>Accounts Receivable</span>
            </div>
            <MudNavLink Href="ar/invoices" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.NoteAdd">
                Create Invoice
            </MudNavLink>
            <MudNavLink Href="ar/invoices/list" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">
                Invoice List
            </MudNavLink>
            <MudNavLink Href="ar/customers" Icon="@Icons.Material.Filled.Groups">
                Customers
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Accounting,Management">
            <div class="nav-group-label">
                <span>Reporting</span>
            </div>
            <MudNavLink Href="reports/financials" Icon="@Icons.Material.Filled.Analytics">
                Financial Statements
            </MudNavLink>
        </AuthorizeView>

    </MudNavMenu>
</div>

<style>
    /* ── Wrapper ── */
    .nav-root {
        padding: 0.625rem 0.625rem 2rem;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: rgba(22, 84, 127, 0.15) transparent;
    }

        .nav-root::-webkit-scrollbar {
            width: 4px;
        }

        .nav-root::-webkit-scrollbar-track {
            background: transparent;
        }

        .nav-root::-webkit-scrollbar-thumb {
            background: rgba(22, 84, 127, 0.15);
            border-radius: 4px;
        }

    .nav-menu {
        padding: 0 !important;
    }

    /* ── Group labels ── */
    .nav-group-label {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 1.25rem 0.75rem 0.375rem;
        position: relative;
    }

        .nav-group-label span {
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: #9ca3af;
            white-space: nowrap;
            position: relative;
            z-index: 1;
        }

    /* ── Nav links — base ── */
    .nav-menu .mud-nav-link {
        border-radius: 8px !important;
        margin: 1px 0 !important;
        padding: 0 !important;
        font-size: 0.83rem !important;
        font-weight: 500 !important;
        color: #374151 !important;
        transition: background 0.15s ease, color 0.15s ease !important;
        position: relative !important;
        overflow: hidden !important;
    }

        /* Left accent bar — hidden by default */
        .nav-menu .mud-nav-link::before {
            content: '';
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: rgb(22, 84, 127);
            opacity: 0;
            transform: scaleY(0.4);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        /* ── Hover ── */
        .nav-menu .mud-nav-link:hover {
            background: rgba(22, 84, 127, 0.06) !important;
            color: rgb(22, 84, 127) !important;
        }

            .nav-menu .mud-nav-link:hover::before {
                opacity: 0.45;
                transform: scaleY(1);
            }

        /* ── Active ── */
        .nav-menu .mud-nav-link.active {
            background: rgba(22, 84, 127, 0.1) !important;
            color: rgb(22, 84, 127) !important;
            font-weight: 600 !important;
        }

            .nav-menu .mud-nav-link.active::before {
                opacity: 1;
                transform: scaleY(1);
            }

    /* ── Icon ── */
    .nav-menu .mud-nav-link-icon {
        color: inherit !important;
        font-size: 1.1rem !important;
        opacity: 0.75;
        transition: opacity 0.15s ease;
    }

    .nav-menu .mud-nav-link:hover .mud-nav-link-icon,
    .nav-menu .mud-nav-link.active .mud-nav-link-icon {
        opacity: 1;
    }
</style>
