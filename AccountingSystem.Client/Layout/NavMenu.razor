@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudNavMenu>
    <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

    <AuthorizeView Roles="Admin">
        <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
            <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">User Management</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Accounting">
        <MudNavGroup Title="General Ledger" Icon="@Icons.Material.Filled.AccountBalance" Expanded="true">
            <MudNavLink Href="gl/journal" Icon="@Icons.Material.Filled.EditNote">Journal Entries</MudNavLink>
            <MudNavLink Href="gl/accounts" Icon="@Icons.Material.Filled.ListAlt">Chart of Accounts</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Accounts Payable" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="true">
            <MudNavLink Href="ap/bills" Icon="@Icons.Material.Filled.ReceiptLong">Vendor Bills</MudNavLink>
            <MudNavLink Href="ap/vendors" Icon="@Icons.Material.Filled.Store">Vendors</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Accounts Receivable" Icon="@Icons.Material.Filled.Sell" Expanded="true">
            <MudNavLink Href="ar/invoices" Icon="@Icons.Material.Filled.Description">Create Invoice</MudNavLink>
            <MudNavLink Href="ar/customers" Icon="@Icons.Material.Filled.Groups">Customers</MudNavLink>
            <MudNavLink Href="ar/receive-payment" Icon="@Icons.Material.Filled.Payment">Receive Payment</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Accounting,Management">
        <MudNavGroup Title="Reporting" Icon="@Icons.Material.Filled.Assessment" Expanded="true">
            <MudNavLink Href="reports/financials" Icon="@Icons.Material.Filled.Analytics">Financial Statements</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>