@page "/ap/vendors"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Accounting")]
@inject PayableService PayableService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Vendor Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Vendor Management</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
            Add New Vendor
        </MudButton>
    </div>

    <!-- TABS: Active vs Archived -->
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Active Vendors" OnClick="@(() => LoadList(false))">
            <MudTable Items="@vendors" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<VendorDTO, bool>(FilterFunc)" Loading="@_loading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Active List</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Contact Person</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>
                    <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Contact">@context.ContactPerson</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="() => OpenEditDialog(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Id)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Archived Vendors" OnClick="@(() => LoadList(true))">
            <MudTable Items="@vendors" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<VendorDTO, bool>(FilterFunc)" Loading="@_loading">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>
                    <MudTd DataLabel="Name" Style="color:gray;">@context.Name</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudTooltip Text="Restore Vendor">
                            <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" Color="Color.Success" OnClick="() => ConfirmRestore(context.Id)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<VendorDTO> vendors = new List<VendorDTO>();
    private string searchString = "";
    private bool _loading = true;
    private bool _showArchived = false;

    protected override async Task OnInitializedAsync() => await LoadList(false);

    private async Task LoadList(bool archived)
    {
        _showArchived = archived;
        _loading = true;
        try
        {
            var all = await PayableService.GetVendorsAsync(archived);
            if (archived)
                vendors = all.Where(v => v.IsDeleted).ToList();
            else
                vendors = all;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private bool FilterFunc(VendorDTO element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.ContactPerson?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<VendorDialog>("Add Vendor", options);
        if (!(await dialog.Result).Canceled) await LoadList(false);
    }

    private async Task OpenEditDialog(VendorDTO vendor)
    {
        var parameters = new DialogParameters { ["Vendor"] = vendor };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<VendorDialog>("Edit Vendor", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadList(false);
    }

    private async Task ConfirmDelete(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Archive", "Archive this vendor?", yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await PayableService.DeleteVendorAsync(id);
                Snackbar.Add("Vendor archived.", Severity.Success);
                await LoadList(false);
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ConfirmRestore(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Restore", "Restore this vendor?", yesText: "Restore", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await PayableService.RestoreVendorAsync(id);
                Snackbar.Add("Vendor restored.", Severity.Success);
                await LoadList(true);
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}