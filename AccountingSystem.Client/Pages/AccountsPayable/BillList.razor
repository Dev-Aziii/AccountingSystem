@page "/ap/bills/list"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using AccountingSystem.Shared.Enums
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Accounting")]
@inject PayableService PayableService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Vendor Bills</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="400px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Bills List
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Manage vendor bills and track payment obligations
                    </MudText>
                }
            </div>
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR TABLE -->
        <MudCard Elevation="3">
            <!-- Toolbar Skeleton -->
            <MudCardContent Class="pa-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="24px" />
                    <div class="d-flex align-center">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="40px" Class="mr-3" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="42px" />
                    </div>
                </div>

                <!-- Table Header Skeleton -->
                <div class="d-flex justify-space-between mb-3 pa-2" style="border-bottom: 2px solid rgba(0,0,0,0.1);">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                </div>

                <!-- Table Rows Skeleton -->
                @for (int i = 0; i < 10; i++)
                {
                    <div class="d-flex justify-space-between align-center mb-3 pa-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="16px" />
                        </div>
                        <div style="flex: 1.5;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" />
                        </div>
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="16px" />
                        </div>
                        <div style="flex: 1; text-align: right;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Style="margin-left: auto;" />
                        </div>
                        <div style="flex: 1; text-align: right;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Style="margin-left: auto;" />
                        </div>
                        <div style="flex: 0.8;">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="70px" Height="24px" />
                        </div>
                        <div style="flex: 0.8;">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="60px" Height="28px" />
                        </div>
                    </div>
                }

                <!-- Pagination Skeleton -->
                <div class="d-flex justify-center mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="32px" />
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudTable Items="@bills" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<BillDTO, bool>(FilterFunc)" Loading="@_loading">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Vendor Bills</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Search bills..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                <MudButton Variant="Variant.Filled"  StartIcon="@Icons.Material.Filled.Add" Href="/ap/bills" Class="create-btn ml-3">Create Bill</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Ref #</MudTh>
                <MudTh>Vendor</MudTh>
                <MudTh>Due Date</MudTh>
                <MudTh Style="text-align:right">Total</MudTh>
                <MudTh Style="text-align:right">Balance</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ref">@context.ReferenceNumber</MudTd>
                <MudTd DataLabel="Vendor">@context.VendorName</MudTd>
                <MudTd DataLabel="Due Date">@context.DueDate.ToShortDateString()</MudTd>
                <MudTd DataLabel="Total" Style="text-align:right">@context.Amount.ToString("N2")</MudTd>
                <MudTd DataLabel="Balance" Style="text-align:right; font-weight:bold;">@context.Balance.ToString("N2")</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Status == DocumentStatus.Paid)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Paid</MudChip>
                    }
                    else if (context.Status == DocumentStatus.PartiallyPaid)
                    {

                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Partial</MudChip>
                    }
                    else
                    {

                        <MudChip T="string" Size="Size.Small" Color="Color.Error">Unpaid</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (context.Balance > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => OpenPayDialog(context))">Pay</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<BillDTO> bills = new List<BillDTO>();
    private string searchString = "";
    private bool _loading = true;
    private bool _initialLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // Fix: Handle potential null return value
            bills = await PayableService.GetBillsAsync() ?? new List<BillDTO>();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenPayDialog(BillDTO bill)
    {
        var parameters = new DialogParameters { ["Bill"] = bill };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PayBillDialog>("Record Payment", parameters, options);
        var result = await dialog.Result;

        // Fix: Handle potential null result
        if (result != null && !result.Canceled) await LoadData();
    }

    private bool FilterFunc(BillDTO element) =>
        string.IsNullOrWhiteSpace(searchString) ||
        element.ReferenceNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        element.VendorName.Contains(searchString, StringComparison.OrdinalIgnoreCase);
}
