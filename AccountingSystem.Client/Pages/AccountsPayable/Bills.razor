@page "/ap/bills"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Components
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Globalization
@attribute [Authorize(Roles = "Admin,Accounting")]
@inject PayableService PayableService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Create Bill</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="380px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        New Vendor Bill
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Record vendor invoices and track accounts payable obligations
                    </MudText>
                }
            </div>
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR BILL FORM -->
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="86px" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>

            <MudCardActions Class="d-flex justify-end">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="130px" Height="42px" />
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <EditForm Model="@bill" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudCard>
                <MudCardContent>
                    <MudGrid>

                        <MudItem xs="12" sm="6">
                            <VendorSelect @bind-SelectedVendorId="bill.VendorId" />
                            <ValidationMessage For="@(() => bill.VendorId)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Reference Number"
                                          @bind-Value="bill.ReferenceNumber"
                                          Variant="Variant.Outlined" />
                            <ValidationMessage For="@(() => bill.ReferenceNumber)" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="Due Date"
                                           @bind-Date="billDate"
                                           Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField Label="Amount (₱)"
                                             @bind-Value="bill.Amount"
                                             Format="N2"
                                             Adornment="Adornment.Start"
                                             AdornmentText="₱"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <AccountSelect @bind-SelectedAccountId="bill.ExpenseAccountId"
                                           TypeFilter="Expense" />
                            <ValidationMessage For="@(() => bill.ExpenseAccountId)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Description"
                                          @bind-Value="bill.Description"
                                          Lines="3"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>
                </MudCardContent>

                <MudCardActions Class="d-flex justify-end">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="save-btn"
                               Disabled="@isSubmitting"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(isSubmitting ? "Saving..." : "Save Bill")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    }
</MudContainer>

@code {
    // Optional: culture if you later display totals or previews
    private readonly CultureInfo phCulture = new("en-PH");

    private CreateBillDTO bill = new()
    {
        DueDate = DateTime.Today.AddDays(30)
    };

    private DateTime? billDate
    {
        get => bill.DueDate;
        set => bill.DueDate = value ?? DateTime.Today;
    }

    private bool isSubmitting = false;
    private bool _initialLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Simulate initial load time for vendors/accounts
        await Task.Delay(100);
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (bill.VendorId == 0)
        {
            Snackbar.Add("Please select a vendor.", Severity.Warning);
            return;
        }

        if (bill.ExpenseAccountId == 0)
        {
            Snackbar.Add("Please select an expense account.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            await PayableService.CreateBillAsync(bill);
            Snackbar.Add("Bill created successfully.", Severity.Success);
            NavManager.NavigateTo("/ap/bills", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
