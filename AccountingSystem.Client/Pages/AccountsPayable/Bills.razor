@page "/ap/bills"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Accounting")]
@inject PayableService PayableService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Create Bill</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">New Vendor Bill</MudText>

    <EditForm Model="@bill" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <VendorSelect @bind-SelectedVendorId="bill.VendorId" />
                        <ValidationMessage For="@(() => bill.VendorId)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Reference Number" @bind-Value="bill.ReferenceNumber" Variant="Variant.Outlined" />
                        <ValidationMessage For="@(() => bill.ReferenceNumber)" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="Due Date" @bind-Date="billDate" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField Label="Amount" @bind-Value="bill.Amount" Format="N2" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <AccountSelect @bind-SelectedAccountId="bill.ExpenseAccountId" TypeFilter="Expense" />
                        <ValidationMessage For="@(() => bill.ExpenseAccountId)" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Description" @bind-Value="bill.Description" Lines="3" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-end">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Warning" Disabled="@isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                    @(isSubmitting ? "Saving..." : "Save Bill")
                </MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
</MudContainer>

@code {
    private CreateBillDTO bill = new CreateBillDTO { DueDate = DateTime.Today.AddDays(30) };
    private DateTime? billDate { get => bill.DueDate; set => bill.DueDate = value ?? DateTime.Today; } // Wrapper for MudDatePicker
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        if (bill.VendorId == 0) { Snackbar.Add("Please select a vendor.", Severity.Warning); return; }
        if (bill.ExpenseAccountId == 0) { Snackbar.Add("Please select an expense account.", Severity.Warning); return; }

        isSubmitting = true;
        try
        {
            await PayableService.CreateBillAsync(bill);
            Snackbar.Add("Bill created successfully.", Severity.Success);
            NavManager.NavigateTo("/ap/bills", forceLoad: true); // Reload to clear form or nav to list
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}