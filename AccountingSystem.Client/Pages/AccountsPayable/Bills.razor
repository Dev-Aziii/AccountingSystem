@page "/ap/bills"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Accounting")]
@inject PayableService PayableService
@inject LedgerService LedgerService
@inject NavigationManager NavManager

<PageTitle>Create Bill</PageTitle>

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark d-flex align-items-center">
            <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>New Vendor Bill</h4>
        </div>
        <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="@bill" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Vendor ID</label>
                        <InputNumber @bind-Value="bill.VendorId" class="form-control" placeholder="Enter Vendor ID" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Reference Number</label>
                        <InputText @bind-Value="bill.ReferenceNumber" class="form-control" placeholder="e.g. BILL-9928" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Due Date</label>
                        <InputDate @bind-Value="bill.DueDate" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <InputNumber @bind-Value="bill.Amount" class="form-control text-end" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Expense Account</label>
                        <InputSelect @bind-Value="bill.ExpenseAccountId" class="form-select">
                            <option value="0">Select Expense...</option>
                            @if (accounts != null)
                            {
                                foreach (var acct in accounts)
                                {
                                    <option value="@acct.Id">@acct.Code - @acct.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Description</label>
                    <InputTextArea @bind-Value="bill.Description" class="form-control" rows="2" />
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-warning px-5 fw-bold" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Save Bill
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CreateBillDTO bill = new CreateBillDTO { DueDate = DateTime.Today.AddDays(30) };
    private List<AccountDTO> accounts;
    private string errorMessage;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await LedgerService.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load accounts: " + ex.Message;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            await PayableService.CreateBillAsync(bill);
            NavManager.NavigateTo("/"); // Redirect to dashboard or bill list
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}