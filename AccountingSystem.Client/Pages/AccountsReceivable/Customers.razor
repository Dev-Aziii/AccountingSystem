@page "/ar/customers"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Accounting,Management")]
@inject ReceivableService ReceivableService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Customer Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="230px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="440px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Customer Management
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Manage customer relationships and track accounts receivable contacts
                    </MudText>
                }
            </div>
            @if (_initialLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="42px" />
            }
            else
            {
                <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                    <MudButton Variant="Variant.Outlined" Class="create-btn" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                        Add New Customer
                    </MudButton>
                </AuthorizeView>
            }
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR TABS AND TABLE -->
        <MudCard Elevation="2">
            <!-- Tabs Skeleton -->
            <div class="d-flex pa-4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="150px" Height="36px" Class="mr-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="170px" Height="36px" />
            </div>

            <MudCardContent Class="pa-6">
                <!-- Toolbar Skeleton -->
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="40px" />
                </div>

                <!-- Table Header Skeleton -->
                <div class="d-flex justify-space-between mb-3 pa-2">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="40px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                </div>

                <!-- Table Rows Skeleton -->
                @for (int i = 0; i < 8; i++)
                {
                    <div class="d-flex justify-space-between align-center mb-3 pa-2">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="30px" Height="16px" />
                        </div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="16px" />
                        </div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="16px" />
                        </div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" />
                        </div>
                        <div>
                            <div class="d-flex justify-end">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="mr-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination Skeleton -->
                <div class="d-flex justify-center mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="32px" />
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Active Customers" OnClick="@(() => LoadList(false))">
                <MudTable Items="@customers" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<CustomerDTO, bool>(FilterFunc)" Loading="@_loading">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Active List</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Phone</MudTh>
                        <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                            <MudTh>Actions</MudTh>
                        </AuthorizeView>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Phone">@context.Phone</MudTd>
                        <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                            <MudTd DataLabel="Actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="() => OpenEditDialog(context)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Id)" />
                            </MudTd>
                        </AuthorizeView>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            </MudTabPanel>

            <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                <MudTabPanel Text="Archived Customers" OnClick="@(() => LoadList(true))">
                    <MudTable Items="@customers" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<CustomerDTO, bool>(FilterFunc)" Loading="@_loading">
                        <HeaderContent>
                            <MudTh>ID</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="ID">@context.Id</MudTd>
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Email">@context.Email</MudTd>
                            <MudTd DataLabel="Actions">
                                <MudTooltip Text="Restore Customer">
                                    <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" Color="Color.Success" OnClick="() => ConfirmRestore(context.Id)" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager /></PagerContent>
                    </MudTable>
                </MudTabPanel>
            </AuthorizeView>
        </MudTabs>
    }
</MudContainer>

@code {
    private List<CustomerDTO> customers = new List<CustomerDTO>();
    private string searchString = "";
    private bool _loading = true;
    private bool _initialLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadList(false);
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task LoadList(bool archived)
    {
        _loading = true;
        try
        {
            var all = await ReceivableService.GetCustomersAsync(archived);
            if (archived)
                // Filter "All" list to show ONLY deleted
                customers = all?.Where(c => c.IsDeleted).ToList() ?? new List<CustomerDTO>();
            else
                // Trust API default filter for Active
                customers = all ?? new List<CustomerDTO>();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private bool FilterFunc(CustomerDTO element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("Add Customer", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadList(false);
    }

    private async Task OpenEditDialog(CustomerDTO customer)
    {
        var parameters = new DialogParameters { ["Customer"] = customer };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("Edit Customer", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadList(false);
    }

    private async Task ConfirmDelete(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Archive", "Archive this customer?", yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            try { await ReceivableService.DeleteCustomerAsync(id); Snackbar.Add("Customer archived.", Severity.Success); await LoadList(false); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ConfirmRestore(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Restore", "Restore this customer?", yesText: "Restore", cancelText: "Cancel");
        if (result == true)
        {
            try { await ReceivableService.RestoreCustomerAsync(id); Snackbar.Add("Customer restored.", Severity.Success); await LoadList(true); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}
