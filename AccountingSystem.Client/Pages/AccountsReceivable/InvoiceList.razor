@page "/ar/invoices/list"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using AccountingSystem.Shared.Enums
@using MudBlazor
@using System.Globalization
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Accounting")]
@inject ReceivableService ReceivableService
@inject ReportService ReportService
@inject LedgerService LedgerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Customer Invoices</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="420px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Customer Invoices
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Manage customer invoices and track payment collections
                    </MudText>
                }
            </div>
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR TABLE -->
        <MudCard Elevation="3">
            <!-- Toolbar Skeleton -->
            <MudCardContent Class="pa-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="24px" />
                    <div class="d-flex align-center">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="40px" Class="mr-3" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="150px" Height="42px" />
                    </div>
                </div>

                <!-- Table Header Skeleton -->
                <div class="d-flex justify-space-between mb-3 pa-2 ux-103">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="40px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                </div>

                <!-- Table Rows Skeleton -->
                @for (int i = 0; i < 10; i++)
                {
                    <div class="d-flex justify-space-between align-center mb-3 pa-2 ux-097">
                        <div class="ux-104">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="30px" Height="16px" />
                        </div>
                        <div class="ux-105">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" />
                        </div>
                        <div class="ux-004">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="16px" />
                        </div>
                        <div class="ux-107">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Style="margin-left: auto;" />
                        </div>
                        <div class="ux-107">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" Style="margin-left: auto;" />
                        </div>
                        <div class="ux-108">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="70px" Height="24px" />
                        </div>
                        <div class="ux-004">
                            <div class="d-flex gap-2">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="28px" />
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination Skeleton -->
                <div class="d-flex justify-center mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="32px" />
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Outlined.FilterList" Class="mr-2" />
                <MudText Typo="Typo.h6">Filters</MudText>
                <MudSpacer />
                @if (HasActiveFilters())
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mr-2">
                        @GetActiveFilterCount() active filter(s)
                    </MudChip>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="ClearFilters"
                               StartIcon="@Icons.Material.Outlined.Clear"
                               Disabled="_loading">
                        Clear All
                    </MudButton>
                }
            </div>

            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudSelect T="int"
                               Value="selectedFiscalYear"
                               ValueChanged="OnFiscalYearChanged"
                               Label="Fiscal Year"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Disabled="_loading">
                        <MudSelectItem T="int" Value="0">All Years</MudSelectItem>
                        @foreach (var year in fiscalYears)
                        {
                            <MudSelectItem T="int" Value="@year.FiscalYear">FY @year.FiscalYear</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string"
                               Value="selectedStatus"
                               ValueChanged="OnStatusChanged"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Disabled="_loading">
                        <MudSelectItem T="string" Value="@AllStatusValue">All Statuses</MudSelectItem>
                        <MudSelectItem T="string" Value="@nameof(DocumentStatus.Unpaid)">Unpaid</MudSelectItem>
                        <MudSelectItem T="string" Value="@nameof(DocumentStatus.PartiallyPaid)">Partially Paid</MudSelectItem>
                        <MudSelectItem T="string" Value="@nameof(DocumentStatus.Paid)">Paid</MudSelectItem>
                        <MudSelectItem T="string" Value="@nameof(DocumentStatus.Void)">Void</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="searchString"
                                  Label="Search"
                                  Placeholder="Search by customer or invoice id..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Disabled="_loading" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="@invoices" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<InvoiceDTO, bool>(FilterFunc)" Loading="@_loading">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Customer Invoices</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Add" Href="/ar/invoices" Class="create-btn ml-3">Create Invoice</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Customer</MudTh>
                <MudTh>Due Date</MudTh>
                <MudTh Style="text-align:right">Total</MudTh>
                <MudTh Style="text-align:right">Balance</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                <MudTd DataLabel="Due Date">@context.DueDate.ToShortDateString()</MudTd>
                <MudTd DataLabel="Total" Style="text-align:right">@context.TotalAmount.ToString("C2", _phCulture)</MudTd>
                <MudTd DataLabel="Balance" Style="text-align:right; font-weight:bold;">@context.Balance.ToString("C2", _phCulture)</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@GetStatusLabel(context.Status)</MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex gap-2">
                        @if (context.Balance > 0)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => OpenReceiveDialog(context))">Receive</MudButton>
                        }
                        <!-- NEW: Download PDF Button -->
                        <MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" Color="Color.Error" Size="Size.Small" OnClick="@(() => DownloadPdf(context.Id))" title="Download PDF" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<InvoiceDTO> invoices = new List<InvoiceDTO>();
    private List<FiscalYearSummaryDTO> fiscalYears = new List<FiscalYearSummaryDTO>();
    private const string AllStatusValue = "__ALL__";
    private string searchString = "";
    private int selectedFiscalYear;
    private int currentFiscalYear;
    private string selectedStatus = AllStatusValue;
    private bool _loading = true;
    private bool _initialLoading = true;
    private readonly CultureInfo _phCulture = CultureInfo.GetCultureInfo("en-PH");

    protected override async Task OnInitializedAsync()
    {
        await LoadFiscalYears();
        await LoadData();
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task LoadFiscalYears()
    {
        try
        {
            fiscalYears = (await LedgerService.GetFiscalYearSummariesAsync() ?? new List<FiscalYearSummaryDTO>())
                .OrderByDescending(f => f.FiscalYear)
                .ToList();

            var today = DateTime.Today;
            currentFiscalYear = fiscalYears
                .FirstOrDefault(f => f.PeriodStart.Date <= today && today <= f.PeriodEnd.Date)?.FiscalYear
                ?? fiscalYears.FirstOrDefault()?.FiscalYear
                ?? 0;

            if (selectedFiscalYear == 0 && currentFiscalYear > 0)
            {
                selectedFiscalYear = currentFiscalYear;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load fiscal years: {ex.Message}", Severity.Error);
            fiscalYears = new List<FiscalYearSummaryDTO>();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            int? fiscalYear = selectedFiscalYear > 0 ? selectedFiscalYear : null;
            invoices = await ReceivableService.GetInvoicesAsync(fiscalYear, ParseStatusFilter(selectedStatus)) ?? new List<InvoiceDTO>();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnFiscalYearChanged(int fiscalYear)
    {
        selectedFiscalYear = fiscalYear;
        await LoadData();
    }

    private async Task OnStatusChanged(string status)
    {
        selectedStatus = status;
        await LoadData();
    }

    private bool HasActiveFilters()
        => selectedFiscalYear != currentFiscalYear || selectedStatus != AllStatusValue || !string.IsNullOrWhiteSpace(searchString);

    private int GetActiveFilterCount()
    {
        int count = 0;
        if (selectedFiscalYear != currentFiscalYear) count++;
        if (selectedStatus != AllStatusValue) count++;
        if (!string.IsNullOrWhiteSpace(searchString)) count++;
        return count;
    }

    private async Task ClearFilters()
    {
        selectedFiscalYear = currentFiscalYear;
        selectedStatus = AllStatusValue;
        searchString = string.Empty;
        await LoadData();
    }

    private async Task OpenReceiveDialog(InvoiceDTO invoice)
    {
        var parameters = new DialogParameters { ["Invoice"] = invoice };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReceivePaymentDialog>("Receive Payment", parameters, options);
        var result = await dialog.Result;

        // Fix: Handle potential null result
        if (result != null && !result.Canceled) await LoadData();
    }

    private async Task DownloadPdf(int id)
    {
        try
        {
            Snackbar.Add("Generating PDF...", Severity.Info);
            await ReportService.DownloadInvoicePdf(id);
            Snackbar.Add("Download started.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
    }

    private static DocumentStatus? ParseStatusFilter(string statusValue)
        => statusValue == AllStatusValue
            ? null
            : Enum.TryParse<DocumentStatus>(statusValue, out var status)
            ? status
            : null;

    private static Color GetStatusColor(DocumentStatus status)
        => status switch
        {
            DocumentStatus.Paid => Color.Success,
            DocumentStatus.PartiallyPaid => Color.Warning,
            DocumentStatus.Void => Color.Secondary,
            _ => Color.Error
        };

    private static string GetStatusLabel(DocumentStatus status)
        => status switch
        {
            DocumentStatus.PartiallyPaid => "Partial",
            _ => status.ToString()
        };

    private bool FilterFunc(InvoiceDTO element) =>
        string.IsNullOrWhiteSpace(searchString) ||
        element.CustomerName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        element.Id.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase);
}
