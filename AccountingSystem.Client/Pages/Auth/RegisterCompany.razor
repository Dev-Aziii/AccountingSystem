@page "/register"
@layout LoginLayout
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>AccSys - Register</PageTitle>

<div class="split-register-container">

    <!-- LEFT FORM PANEL -->
    <div class="form-panel">
        <div class="form-inner">
            <div class="form-header">
                <div class="logo-wrap">
                    <img src="AccsysLogo.png" alt="AccSys Logo" class="form-logo" />
                </div>
                <h2 class="form-title">Create Your Account</h2>
                <p class="form-subtitle">Start your accounting journey with a free company trial</p>
            </div>

            <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
                <DataAnnotationsValidator />
                <div class="fields-group">
                    <MudTextField Label="Company Name"
                                  @bind-Value="registerModel.CompanyName"
                                  For="@(() => registerModel.CompanyName)"
                                  Variant="Variant.Outlined"
                                  Class="accsys-field mb-2"
                                  FullWidth="true" />

                    <MudTextField Label="Administrator Full Name"
                                  @bind-Value="registerModel.AdminFullName"
                                  For="@(() => registerModel.AdminFullName)"
                                  Variant="Variant.Outlined"
                                  Class="accsys-field mb-2"
                                  FullWidth="true" />

                    <MudTextField Label="Email Address"
                                  @bind-Value="registerModel.AdminEmail"
                                  For="@(() => registerModel.AdminEmail)"
                                  Variant="Variant.Outlined"
                                  Class="accsys-field mb-2"
                                  FullWidth="true" />

                    <MudTextField Label="Password"
                                  @bind-Value="registerModel.Password"
                                  For="@(() => registerModel.Password)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Class="accsys-field mb-3"
                                  FullWidth="true" />

                    <div class="recaptcha-wrap mb-3">
                        <div id="recaptcha_container"></div>
                    </div>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="accsys-btn"
                               FullWidth="true"
                               Disabled="@isLoading"
                               Size="Size.Large"
                               StartIcon="@(!isLoading ? Icons.Material.Filled.AppRegistration : "")">
                        @if (isLoading)
                        {
                            <div class="d-flex align-center gap-2">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>Creating Company...</span>
                            </div>
                        }
                        else
                        {
                            <span>Create Company Account</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

            <div class="form-footer">
                <MudDivider Class="mb-2" />
                <MudText Typo="Typo.body2" Class="mb-2">
                    Already have an account?
                    <MudLink Href="/" Class="signin-link">Sign In Here</MudLink>
                </MudText>
                <MudText Typo="Typo.caption" Class="help-text">
                    By creating an account, you agree to our terms of service
                </MudText>
            </div>
        </div>
    </div>

    <!-- RIGHT BRANDING PANEL -->
    <div class="branding-panel">
        <div class="branding-inner">
            <div class="deco-circle deco-circle--lg"></div>
            <div class="deco-circle deco-circle--sm"></div>
            <div class="deco-circle deco-circle--xs"></div>

            <div class="branding-illustration">
                <div class="img-skeleton @(illustrationLoaded ? "img-skeleton--hidden" : "")"></div>
                <img src="graphics2.png"
                     alt="AccSys Dashboard Illustration"
                     class="branding-img @(illustrationLoaded ? "branding-img--visible" : "")"
                     @onload="OnIllustrationLoaded" />
            </div>

            <div class="branding-text">
                <h1 class="branding-title">AccSys Solutions</h1>
                <p class="branding-subtitle">
                    Create your account and start managing your business finances with clarity,
                    control, and confidence.
                </p>
            </div>

            <div class="branding-features">
                <div class="feature-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="feature-icon"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>
                    <span>Reliable</span>
                </div>
                <div class="feature-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="feature-icon"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>
                    <span>Real-time </span>
                </div>
                <div class="feature-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="feature-icon"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>
                    <span>Secured</span>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-56px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(56px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -600px 0;
        }

        100% {
            background-position: 600px 0;
        }
    }

    .split-register-container {
        display: flex;
        height: 100vh;
        width: 100%;
        overflow: hidden;
    }

    /* LEFT FORM PANEL */
    .form-panel {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        padding: 1rem 1.25rem;
        overflow: hidden;
        animation: slideInLeft 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @@media (min-width: 768px) {
        .form-panel {
            width: 50%;
            padding: 1rem 2rem;
        }
    }

    @@media (min-width: 1024px) {
        .form-panel {
            padding: 1rem 2.5rem;
        }
    }

    .form-inner {
        width: 100%;
        max-width: 400px;
    }

    .form-header {
        text-align: center;
        margin-bottom: 0.65rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid #e8edf2;
        animation: fadeUp 0.5s 0.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .logo-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 0.4rem;
    }

    .form-logo {
        height: 46px;
        width: auto;
        filter: drop-shadow(0 4px 12px rgba(19, 70, 88, 0.18));
        transition: transform 0.3s ease;
    }

        .form-logo:hover {
            transform: scale(1.06);
        }

    .form-title {
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 0.2rem 0;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, #1a5d73 0%, #0d9488 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .form-subtitle {
        font-size: 0.78rem;
        color: #64748b;
        font-style: italic;
        margin: 0;
    }

    .fields-group {
        margin: 0.6rem 0;
        animation: fadeUp 0.5s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .accsys-field {
        margin-bottom: 0.5rem !important;
    }

        .accsys-field .mud-input-outlined {
            border-radius: 8px !important;
            background: #f0f5fb !important;
        }

        .accsys-field .mud-input-outlined-border {
            border-radius: 8px !important;
        }

        .accsys-field.mud-input-control:hover .mud-input-outlined {
            background: #e8f0f8 !important;
        }

        .accsys-field .mud-input-label-inputcontrol {
            color: #4a6274 !important;
            font-size: 0.8rem !important;
        }

        .accsys-field .mud-input-slot {
            padding-top: 16px !important;
            padding-bottom: 2px !important;
            min-height: 40px !important;
        }

    .recaptcha-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 0.5rem;
        transform: scale(0.88);
        transform-origin: center;
    }

    .accsys-btn {
        background: linear-gradient(to right, #1a5370, #429497) !important;
        border-radius: 8px !important;
        font-weight: 600 !important;
        font-size: 0.875rem !important;
        text-transform: none !important;
        min-height: 40px !important;
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(26, 83, 112, 0.35) !important;
        transition: all 0.25s ease !important;
        border: none !important;
    }

        .accsys-btn:hover:not(:disabled) {
            transform: translateY(-1px) !important;
            box-shadow: 0 8px 22px rgba(26, 83, 112, 0.45) !important;
            opacity: 0.95 !important;
        }

        .accsys-btn:disabled {
            opacity: 0.65 !important;
            transform: none !important;
        }

    .form-footer {
        text-align: center;
        padding-top: 0.25rem;
        animation: fadeUp 0.5s 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

        .form-footer .mud-divider {
            margin-bottom: 0.5rem !important;
        }

    .signin-link {
        color: #0d9488 !important;
        font-weight: 700 !important;
        text-decoration: none !important;
        transition: color 0.2s ease;
    }

        .signin-link:hover {
            color: #0a7a70 !important;
            text-decoration: underline !important;
        }

    .help-text {
        color: #94a3b8 !important;
        font-style: italic;
    }

    /* RIGHT BRANDING PANEL */
    .branding-panel {
        display: none;
        width: 50%;
        background: linear-gradient(135deg, #134658 0%, #0d9488 100%);
        position: relative;
        overflow: hidden;
        animation: slideInRight 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @@media (min-width: 768px) {
        .branding-panel {
            display: flex;
            align-items: center;
            justify-content: center;
        }
    }

    .branding-inner {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1.5rem 2rem;
        max-width: 440px;
        width: 100%;
    }

    .deco-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
        pointer-events: none;
    }

    .deco-circle--lg {
        width: 300px;
        height: 300px;
        bottom: -100px;
        left: -80px;
    }

    .deco-circle--sm {
        width: 180px;
        height: 180px;
        top: 20px;
        right: -55px;
        background: rgba(255,255,255,0.05);
    }

    .deco-circle--xs {
        width: 90px;
        height: 90px;
        top: 45%;
        right: 18%;
        background: rgba(255,255,255,0.04);
    }

    /* ── Illustration wrapper + skeleton ─────────────────────────── */
    .branding-illustration {
        width: 100%;
        max-width: 300px;
        margin-bottom: 1.25rem;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25), 0 6px 16px rgba(0,0,0,0.15);
        transition: transform 0.5s ease;
        position: relative;
        min-height: 200px;
    }

        .branding-illustration:hover {
            transform: scale(1.03) translateY(-3px);
        }

    /* Skeleton shimmer overlay */
    .img-skeleton {
        position: absolute;
        inset: 0;
        border-radius: 1rem;
        background: linear-gradient( 90deg, rgba(255,255,255,0.08) 25%, rgba(255,255,255,0.18) 50%, rgba(255,255,255,0.08) 75% );
        background-size: 600px 100%;
        animation: shimmer 1.6s infinite linear;
        transition: opacity 0.35s ease;
        z-index: 1;
    }

    .img-skeleton--hidden {
        opacity: 0;
        pointer-events: none;
    }

    /* Image starts invisible, fades in once loaded */
    .branding-img {
        width: 100%;
        display: block;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.45s ease;
        position: relative;
        z-index: 2;
    }

    .branding-img--visible {
        opacity: 1;
    }

    .branding-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 0.4rem 0;
        letter-spacing: -0.5px;
        text-shadow: 0 2px 12px rgba(0,0,0,0.2);
    }

    .branding-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,0.85);
        line-height: 1.6;
        margin: 0 0 1rem 0;
    }

    .branding-features {
        display: flex;
        gap: 1rem; 
        justify-content: center; 
        width: 100%;
        max-width: 420px; 
        margin: 0 auto; 
    }

    .feature-item {
        display: flex;
        align-items: center;
        justify-content: center; 
        gap: 0.6rem;
        width: 130px; 
        color: rgba(255, 255, 255, 0.92);
        font-size: 0.8rem;
        font-weight: 500;
        text-align: center;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.45rem 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .feature-icon {
        width: 16px;
        height: 16px;
        color: #a7f3d0;
        flex-shrink: 0;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .split-register-container {
            background: linear-gradient(160deg, #134658 0%, #1a7a7a 35%, #f0f5fb 35%);
            height: 100vh;
            overflow: hidden;
        }

        .form-panel {
            background: transparent;
            padding-top: 2.5rem;
            align-items: flex-start;
        }

        .form-inner {
            background: #ffffff;
            border-radius: 1.25rem;
            padding: 1.5rem;
            box-shadow: 0 12px 40px rgba(19, 70, 88, 0.2);
        }
    }
</style>

@code {
    private CompanyRegisterDTO registerModel = new CompanyRegisterDTO();
    private bool isLoading = false;
    private bool illustrationLoaded = false;

    private const string SiteKey = "6LcUNGEsAAAAAJKM0sgFbG3mKWAiYq-cXaz2Wv_8";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            await JS.InvokeVoidAsync("renderRecaptcha", "recaptcha_container", SiteKey);
        }
    }

    private void OnIllustrationLoaded()
    {
        illustrationLoaded = true;
        StateHasChanged();
    }

    private async Task HandleRegistration()
    {
        isLoading = true;
        try
        {
            string token = await JS.InvokeAsync<string>("getCaptchaResponse");

            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("Please complete the CAPTCHA verification.", Severity.Warning);
                isLoading = false;
                return;
            }

            registerModel.RecaptchaToken = token;
            await AuthService.RegisterCompany(registerModel);

            Snackbar.Add("Company registered successfully! Welcome.", Severity.Success);
            await Task.Delay(1500);
            NavManager.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
