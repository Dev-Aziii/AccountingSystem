@page "/register"
@layout LoginLayout
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>AccSys - Register</PageTitle>

<div class="register-container">
    <div class="register-card-container">
        <MudPaper Class="register-card pa-8" Elevation="0">

            <!-- LOGO AND HEADER -->
            <div class="register-header text-center mb-6">
                <div class="logo-container mb-4">
                    <img src="AccsysLogo.png" alt="Accsys Logo" class="logo-image" />
                </div>
                <MudText Typo="Typo.h4" Class="main-title mb-2">
                    Welcome to AccSys
                </MudText>
                <MudText Typo="Typo.body1" Class="register-subtitle">
                    Start your accounting journey with a free company trial
                </MudText>
            </div>

            <!-- REGISTRATION FORM -->
            <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
                <DataAnnotationsValidator />

                <div class="register-form">
                    <MudTextField Label="Company Name"
                                  @bind-Value="registerModel.CompanyName"
                                  For="@(() => registerModel.CompanyName)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Business"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Administrator Full Name"
                                  @bind-Value="registerModel.AdminFullName"
                                  For="@(() => registerModel.AdminFullName)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Person"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Email Address"
                                  @bind-Value="registerModel.AdminEmail"
                                  For="@(() => registerModel.AdminEmail)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Email"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Password"
                                  @bind-Value="registerModel.Password"
                                  For="@(() => registerModel.Password)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Class="mb-6 register-field"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Lock"
                                  Style="border-radius: 12px;" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="register-button"
                               FullWidth="true"
                               Disabled="@isLoading"
                               Size="Size.Large"
                               StartIcon="@(!isLoading ? Icons.Material.Filled.AppRegistration : "")">
                        @if (isLoading)
                        {
                            <div class="d-flex align-center">
                                <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                                <span>Creating Company...</span>
                            </div>
                        }
                        else
                        {
                            <span>Create Company Account</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

            <!-- FOOTER LINKS -->
            <div class="register-footer text-center mt-6">
                <MudDivider Class="mb-4" />
                <MudText Typo="Typo.body2" Class="mb-3">
                    Already have an account?
                    <MudLink Href="/" Class="signin-link">
                        Sign In Here
                    </MudLink>
                </MudText>
                <MudText Typo="Typo.caption" Class="register-help-text">
                    By creating an account, you agree to our terms of service
                </MudText>
            </div>

        </MudPaper>
    </div>
</div>

<style>
    .register-container {
        min-height: 100vh;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
    }

    .register-card-container {
        width: 100%;
        max-width: 520px;
        position: relative;
        z-index: 1;
    }

    /* Glassmorphism Card Style */
    .register-card {
        background: rgba(255, 255, 255, 0.25);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(20px);
        box-shadow: 0 8px 32px rgba(22, 84, 127, 0.1), 0 2px 8px rgba(0, 0, 0, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.4);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        /* Glass card overlay for extra depth */
        .register-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient( 135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0.1) 100% );
            pointer-events: none;
            border-radius: 24px;
        }

        .register-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 48px rgba(22, 84, 127, 0.15), 0 4px 16px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

    .register-header {
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(56, 146, 147, 0.15);
        position: relative;
        z-index: 2;
    }

    .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .logo-image {
        height: 80px;
        width: auto;
        filter: drop-shadow(0 4px 12px rgba(56, 146, 147, 0.2));
        transition: all 0.3s ease;
    }

        .logo-image:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 6px 16px rgba(56, 146, 147, 0.3));
        }

    /* Main AccSys Title Styling */
    .main-title {
        color: var(--theme-secondary) !important;
        font-weight: 900;
        letter-spacing: -0.8px;
        text-shadow: 0 3px 6px rgba(56, 146, 147, 0.15);
        text-align: center;
        background: linear-gradient(135deg, var(--theme-secondary) 0%, var(--theme-primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-size: 2.5rem;
        line-height: 1.2;
    }

    /* Website Subtitle Styling */
    .website-subtitle {
        color: var(--theme-primary) !important;
        font-weight: 600;
        text-align: center;
        opacity: 0.9;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .register-subtitle {
        color: var(--theme-primary) !important;
        font-weight: 400;
        opacity: 0.8;
        text-align: center;
        font-style: italic;
    }

    .register-form {
        margin: 2rem 0;
        position: relative;
        z-index: 2;
    }

    .register-field {
        margin-bottom: 1.5rem;
    }

        .register-field .mud-input-control {
            border-radius: 12px;
        }

        .register-field .mud-input-outlined {
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(10px);
        }

            .register-field .mud-input-outlined:hover {
                border-color: var(--theme-secondary);
                background: rgba(255, 255, 255, 0.5);
                box-shadow: 0 2px 8px rgba(56, 146, 147, 0.1);
            }

            .register-field .mud-input-outlined.mud-input-focused {
                border-color: var(--theme-secondary);
                box-shadow: 0 0 0 2px rgba(56, 146, 147, 0.2), 0 4px 12px rgba(56, 146, 147, 0.15);
                background: rgba(255, 255, 255, 0.6);
            }

    .register-button {
        background: linear-gradient(135deg, var(--theme-secondary) 0%, var(--theme-primary) 100%) !important;
        border-radius: 12px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        padding: 16px 24px !important;
        box-shadow: 0 8px 24px rgba(56, 146, 147, 0.3), 0 2px 8px rgba(0, 0, 0, 0.1) !important;
        transition: all 0.3s ease !important;
        color: white !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        font-size: 1rem !important;
        min-height: 56px !important;
        backdrop-filter: blur(10px);
    }

        .register-button:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 12px 32px rgba(56, 146, 147, 0.4), 0 4px 16px rgba(0, 0, 0, 0.15) !important;
            background: linear-gradient(135deg, var(--theme-secondary-dark) 0%, var(--theme-primary-dark) 100%) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
        }

        .register-button:disabled {
            opacity: 0.7;
            transform: none !important;
        }

    .register-footer {
        padding-top: 2rem;
        border-top: 1px solid rgba(56, 146, 147, 0.15);
        position: relative;
        z-index: 2;
    }

    .signin-link {
        color: var(--theme-primary) !important;
        font-weight: 600 !important;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

        .signin-link:hover {
            color: var(--theme-primary-dark) !important;
            text-decoration: underline !important;
            text-shadow: 0 2px 4px rgba(22, 84, 127, 0.2);
        }

    .register-help-text {
        color: rgba(56, 146, 147, 0.7) !important;
        font-style: italic;
    }

    media (max-width: 768px) {
        .register-container

    {
        padding: 1rem;
    }

    .register-card {
        padding: 2rem !important;
    }

    .logo-image {
        height: 60px;
    }

    .main-title {
        font-size: 2rem;
    }

    .website-subtitle {
        font-size: 0.8rem;
    }

    }

    media (max-width: 480px) {
        .register-card

    {
        padding: 1.5rem !important;
        border-radius: 16px;
    }

    .logo-image {
        height: 50px;
    }

    .main-title {
        font-size: 1.8rem;
        letter-spacing: -0.5px;
    }

    .website-subtitle {
        font-size: 0.75rem;
    }

    .register-form .register-field {
        margin-bottom: 1rem;
    }

    }

    /* Form validation styling */
    .register-field .validation-message {
        color: #d32f2f;
        font-size: 0.75rem;
        margin-top: 0.25rem;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
    }

    .register-field .mud-input-outlined.mud-input-error {
        border-color: #d32f2f;
        background: rgba(211, 47, 47, 0.05);
    }

        .register-field .mud-input-outlined.mud-input-error:hover {
            border-color: #d32f2f;
            background: rgba(211, 47, 47, 0.08);
        }

    /* Success state styling */
    .register-success-message {
        background: rgba(76, 175, 80, 0.1);
        border: 1px solid rgba(76, 175, 80, 0.3);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1rem;
        color: #2e7d32;
        text-align: center;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }
</style>

@code {
    private CompanyRegisterDTO registerModel = new CompanyRegisterDTO();
    private bool isLoading = false;

    private async Task HandleRegistration()
    {
        isLoading = true;
        try
        {
            await AuthService.RegisterCompany(registerModel);
            Snackbar.Add("🎉 Company registered successfully! Welcome to the system.", Severity.Success);

            // Delay to allow snackbar to show and for a better UX
            await Task.Delay(1500);
            NavManager.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}