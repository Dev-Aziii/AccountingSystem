@page "/register"
@layout LoginLayout
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>AccSys - Register</PageTitle>

<div class="register-container">
    <div class="register-card-container">
        <MudPaper Class="register-card pa-8" Elevation="0">

            <!-- LOGO AND HEADER -->
            <div class="register-header text-center mb-6">
                <div class="logo-container mb-4">
                    <img src="AccsysLogo.png" alt="Accsys Logo" class="logo-image" />
                </div>
                <MudText Typo="Typo.h4" Class="main-title mb-2">
                    Welcome to AccSys
                </MudText>
                <MudText Typo="Typo.body1" Class="register-subtitle">
                    Start your accounting journey with a free company trial
                </MudText>
            </div>

            <!-- REGISTRATION FORM -->
            <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
                <DataAnnotationsValidator />

                <div class="register-form">
                    <MudTextField Label="Company Name"
                                  @bind-Value="registerModel.CompanyName"
                                  For="@(() => registerModel.CompanyName)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Administrator Full Name"
                                  @bind-Value="registerModel.AdminFullName"
                                  For="@(() => registerModel.AdminFullName)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Email Address"
                                  @bind-Value="registerModel.AdminEmail"
                                  For="@(() => registerModel.AdminEmail)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 register-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Password"
                                  @bind-Value="registerModel.Password"
                                  For="@(() => registerModel.Password)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Class="mb-6 register-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <div class="d-flex justify-center mb-4">
                        <div id="recaptcha_container"></div>
                    </div>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="register-button"
                               FullWidth="true"
                               Disabled="@isLoading"
                               Size="Size.Large"
                               Starticon="@(!isLoading ? Icons.Material.Outlined.AppRegistration : "")">
                        @if (isLoading)
                        {
                            <div class="d-flex align-center">
                                <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                                <span>Creating Company...</span>
                            </div>
                        }
                        else
                        {
                            <span>Create Company Account</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

            <!-- FOOTER LINKS -->
            <div class="register-footer text-center mt-6">
                <MudDivider Class="mb-4" />
                <MudText Typo="Typo.body2" Class="mb-3">
                    Already have an account?
                    <MudLink Href="/" Class="signin-link">
                        Sign In Here
                    </MudLink>
                </MudText>
                <MudText Typo="Typo.caption" Class="register-help-text">
                    By creating an account, you agree to our terms of service
                </MudText>
            </div>

        </MudPaper>
    </div>
</div>
@code {
    private CompanyRegisterDTO registerModel = new CompanyRegisterDTO();
    private bool isLoading = false;

    // REPLACE with your actual v2 "I'm not a robot" SITE KEY from Google Console
    private const string SiteKey = "6LcUNGEsAAAAAJKM0sgFbG3mKWAiYq-cXaz2Wv_8";

    // FIX: Render the widget after the component has loaded the HTML
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Small delay to ensure the Google script has initialized if coming from a fast reload
            await Task.Delay(500);
            await JS.InvokeVoidAsync("renderRecaptcha", "recaptcha_container", SiteKey);
        }
    }

    private async Task HandleRegistration()
    {
        isLoading = true;
        try
        {
            // 1. Get Token from v2 Widget via JS
            string token = await JS.InvokeAsync<string>("getCaptchaResponse");

            if (string.IsNullOrEmpty(token))
            {
                Snackbar.Add("Please complete the CAPTCHA verification.", Severity.Warning);
                isLoading = false;
                return;
            }

            registerModel.RecaptchaToken = token;

            // 2. Send to API
            await AuthService.RegisterCompany(registerModel);

            Snackbar.Add("Company registered successfully! Welcome.", Severity.Success);
            await Task.Delay(1500);
            NavManager.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}