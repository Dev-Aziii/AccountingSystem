@page "/forgot-password"
@layout LoginLayout
@using AccountingSystem.Client.Services
@using AccountingSystem.Shared.DTOs
@using MudBlazor
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot Password - AccSys</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 mb-10">
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <div class="mb-4">
            <MudText Typo="Typo.h5">Reset your password</MudText>
            <MudText Typo="Typo.body2" Class="mt-1" Style="color: var(--text-muted);">
                Enter your email address and we will send a reset link if the account exists.
            </MudText>
        </div>

        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField Label="Email Address"
                          @bind-Value="model.Email"
                          For="@(() => model.Email)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@statusSeverity" Dense="true" Class="mb-4">
                    @statusMessage
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="@isSubmitting">
                @(isSubmitting ? "Sending..." : "Send Reset Link")
            </MudButton>
        </EditForm>

        <div class="mt-4 text-center">
            <MudLink Href="/">Back to sign in</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private ForgotPasswordDTO model = new();
    private bool isSubmitting;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        statusMessage = null;

        try
        {
            await AuthService.RequestPasswordReset(model);
            statusMessage = "If the account exists, a password reset link has been sent.";
            statusSeverity = Severity.Success;
            Snackbar.Add(statusMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to request password reset for {Email}.", model.Email);
            statusMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to send password reset email. Please try again."
                : ex.Message;
            statusSeverity = Severity.Error;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
