@page "/reset-password"
@layout LoginLayout
@using AccountingSystem.Client.Services
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Shared.Validation
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset Password - AccSys</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 mb-10">
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <div class="mb-4">
            <MudText Typo="Typo.h5">Set a new password</MudText>
            <MudText Typo="Typo.body2" Class="mt-1" Style="color: var(--text-muted);">
                Choose a strong password or passphrase that meets the current policy.
            </MudText>
        </div>

        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField Label="Email Address"
                          @bind-Value="model.Email"
                          For="@(() => model.Email)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField Label="New Password"
                          @bind-Value="model.NewPassword"
                          For="@(() => model.NewPassword)"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="@PasswordPolicy.Description"
                          Class="mb-3" />

            <MudTextField Label="Confirm New Password"
                          @bind-Value="model.ConfirmPassword"
                          For="@(() => model.ConfirmPassword)"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@statusSeverity" Dense="true" Class="mb-4">
                    @statusMessage
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="@(isSubmitting || string.IsNullOrWhiteSpace(model.Token))">
                @(isSubmitting ? "Resetting..." : "Reset Password")
            </MudButton>
        </EditForm>

        <div class="mt-4 text-center">
            <MudLink Href="/">Back to sign in</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordDTO model = new();
    private bool isSubmitting;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    protected override void OnParametersSet()
    {
        model.Email = Email ?? string.Empty;
        model.Token = Token ?? string.Empty;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        statusMessage = null;

        try
        {
            await AuthService.ResetPassword(model);
            statusMessage = "Password reset successfully. You can sign in with your new password now.";
            statusSeverity = Severity.Success;
            Snackbar.Add(statusMessage, Severity.Success);
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset password for {Email}.", model.Email);
            statusMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to reset password. Please try again."
                : ex.Message;
            statusSeverity = Severity.Error;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
