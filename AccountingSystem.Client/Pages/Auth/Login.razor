@page "/"
@layout LoginLayout
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>AccSys</PageTitle>

<div class="login-container">
    <div class="login-card-container">
        <MudPaper Class="login-card pa-8" Elevation="0">

            <!-- LOGO AND HEADER -->
            <div class="login-header text-center mb-6">
                <div class="logo-container mb-4">
                    <img src="AccsysLogo.png" alt="Accsys Logo" class="logo-image" />
                </div>
                <MudText Typo="Typo.h4" Class="main-title mb-2">
                    Welcome to AccSys
                </MudText>
                <MudText Typo="Typo.body1" Class="login-subtitle">
                    Sign in to access your accounting system
                </MudText>
            </div>

            <!-- LOGIN FORM -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="login-form">
                    <MudTextField Label="Email Address"   @bind-Value="loginModel.Email"      For="@(() => loginModel.Email)"
                                  Variant="Variant.Outlined"                   Class="mb-4 login-field"                      FullWidth="true"
                                  />

                    <MudTextField Label="Password"  @bind-Value="loginModel.Password"     For="@(() => loginModel.Password)"
                                  Variant="Variant.Outlined"                  InputType="InputType.Password"                                  Class="mb-6 login-field"
                                  FullWidth="true"                                  />

                    <MudButton ButtonType="ButtonType.Submit"                               Variant="Variant.Outlined" Class="login-button"
                               FullWidth="true" Disabled="@isLoading" Size="Size.Large"
                               Starticon="@(!isLoading ? Icons.Material.Filled.Login : "")">
                        @if (isLoading)
                        {
                            <div class="d-flex align-center">
                                <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                                <span>Signing In...</span>
                            </div>
                        }
                        else
                        {
                            <span>Sign In to Dashboard</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

            <!-- FOOTER LINKS -->
            <div class="login-footer text-center mt-6">
                <MudDivider Class="mb-4" />
                <MudText Typo="Typo.body2" Class="mb-3">
                    Don't have an account?
                    <MudLink Href="register" Class="register-link">
                        Register Your Company
                    </MudLink>
                </MudText>
                <MudText Typo="Typo.caption" Class="login-help-text">
                    Need help? Contact your system administrator
                </MudText>
            </div>

        </MudPaper>
    </div>
</div>



@code {
    private LoginDTO loginModel = new LoginDTO();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            var role = authState.User.FindFirst("role")?.Value;
            NavManager.NavigateTo(role == "SuperAdmin" ? "/superadmin/dashboard" : "/dashboard");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        try
        {
            var result = await AuthService.Login(loginModel);
            Snackbar.Add("Welcome back! Login successful.", Severity.Success);
            NavManager.NavigateTo(result.Role == "SuperAdmin" ? "/superadmin/dashboard" : "/dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Invalid email or password. Please try again.", Severity.Error);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}