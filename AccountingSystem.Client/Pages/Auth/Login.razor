@page "/"
@layout LoginLayout
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>AccSys</PageTitle>

<div class="login-container">
    <div class="login-card-container">
        <MudPaper Class="login-card pa-8" Elevation="0">

            <!-- LOGO AND HEADER -->
            <div class="login-header text-center mb-6">
                <div class="logo-container mb-4">
                    <img src="AccsysLogo.png" alt="Accsys Logo" class="logo-image" />
                </div>
                <MudText Typo="Typo.h4" Class="main-title mb-2">
                    Welcome to AccSys
                </MudText>
                <MudText Typo="Typo.body1" Class="login-subtitle">
                    Sign in to access your accounting system
                </MudText>
            </div>

            <!-- LOGIN FORM -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="login-form">
                    <MudTextField Label="Email Address"
                                  @bind-Value="loginModel.Email"
                                  For="@(() => loginModel.Email)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4 login-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <MudTextField Label="Password"
                                  @bind-Value="loginModel.Password"
                                  For="@(() => loginModel.Password)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Class="mb-6 login-field"
                                  FullWidth="true"
                                  Style="border-radius: 12px;" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="login-button"
                               FullWidth="true"
                               Disabled="@isLoading"
                               Size="Size.Large"
                               Starticon="@(!isLoading ? Icons.Material.Filled.Login : "")">
                        @if (isLoading)
                        {
                            <div class="d-flex align-center">
                                <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                                <span>Signing In...</span>
                            </div>
                        }
                        else
                        {
                            <span>Sign In to Dashboard</span>
                        }
                    </MudButton>
                </div>
            </EditForm>

            <!-- FOOTER LINKS -->
            <div class="login-footer text-center mt-6">
                <MudDivider Class="mb-4" />
                <MudText Typo="Typo.body2" Class="mb-3">
                    Don't have an account?
                    <MudLink Href="register" Class="register-link">
                        Register Your Company
                    </MudLink>
                </MudText>
                <MudText Typo="Typo.caption" Class="login-help-text">
                    Need help? Contact your system administrator
                </MudText>
            </div>

        </MudPaper>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
    }

    .login-card-container {
        width: 100%;
        max-width: 450px;
        position: relative;
        z-index: 1;
    }

    /* Glassmorphism Card Style */
    .login-card {
        background: rgba(255, 255, 255, 0.25);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(20px);
        box-shadow: 0 8px 32px rgba(22, 84, 127, 0.1), 0 2px 8px rgba(0, 0, 0, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.4);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        /* Glass card overlay for extra depth */
        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient( 135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0.1) 100% );
            pointer-events: none;
            border-radius: 24px;
        }

        .login-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 48px rgba(22, 84, 127, 0.15), 0 4px 16px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

    .login-header {
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(22, 84, 127, 0.15);
        position: relative;
        z-index: 2;
    }

    .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .logo-image {
        height: 80px;
        width: auto;
        filter: drop-shadow(0 4px 12px rgba(22, 84, 127, 0.2));
        transition: all 0.3s ease;
    }

        .logo-image:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 6px 16px rgba(22, 84, 127, 0.3));
        }

    /* Main AccSys Title Styling */
    .main-title {
        color: var(--theme-primary) !important;
        font-weight: 900;
        letter-spacing: -0.8px;
        text-shadow: 0 3px 6px rgba(22, 84, 127, 0.15);
        text-align: center;
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-size: 2.5rem;
        line-height: 1.2;
    }

    /* Website Subtitle Styling */
    .website-subtitle {
        color: var(--theme-secondary) !important;
        font-weight: 600;
        text-align: center;
        opacity: 0.9;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .login-subtitle {
        color: var(--theme-primary) !important;
        font-weight: 400;
        opacity: 0.8;
        text-align: center;
        font-style: italic;
    }

    .login-form {
        margin: 2rem 0;
        position: relative;
        z-index: 2;
    }

    .login-field {
        margin-bottom: 1.5rem;
    }

        .login-field .mud-input-control {
            border-radius: 12px;
        }

        .login-field .mud-input-outlined {
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(10px);
        }

            .login-field .mud-input-outlined:hover {
                border-color: var(--theme-primary);
                background: rgba(255, 255, 255, 0.5);
                box-shadow: 0 2px 8px rgba(22, 84, 127, 0.1);
            }

            .login-field .mud-input-outlined.mud-input-focused {
                border-color: var(--theme-primary);
                box-shadow: 0 0 0 2px rgba(22, 84, 127, 0.2), 0 4px 12px rgba(22, 84, 127, 0.15);
                background: rgba(255, 255, 255, 0.6);
            }

    .login-button {
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%) !important;
        border-radius: 12px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        padding: 16px 24px !important;
        box-shadow: 0 8px 24px rgba(22, 84, 127, 0.3), 0 2px 8px rgba(0, 0, 0, 0.1) !important;
        transition: all 0.3s ease !important;
        color: white !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        font-size: 1rem !important;
        min-height: 56px !important;
        backdrop-filter: blur(10px);
    }

        .login-button:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 12px 32px rgba(22, 84, 127, 0.4), 0 4px 16px rgba(0, 0, 0, 0.15) !important;
            background: linear-gradient(135deg, var(--theme-primary-dark) 0%, var(--theme-secondary-dark) 100%) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
        }

        .login-button:disabled {
            opacity: 0.7;
            transform: none !important;
        }

    .login-footer {
        padding-top: 2rem;
        border-top: 1px solid rgba(22, 84, 127, 0.15);
        position: relative;
        z-index: 2;
    }

    .register-link {
        color: var(--theme-secondary) !important;
        font-weight: 600 !important;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

        .register-link:hover {
            color: var(--theme-secondary-dark) !important;
            text-decoration: underline !important;
            text-shadow: 0 2px 4px rgba(56, 146, 147, 0.2);
        }

    .login-help-text {
        color: rgba(22, 84, 127, 0.7) !important;
        font-style: italic;
    }

    @@media (max-width: 768px) {
        .login-container {
            padding: 1rem;
        }

        .login-card {
            padding: 2rem !important;
        }

        .logo-image {
            height: 60px;
        }

        .main-title {
            font-size: 2rem;
        }

        .website-subtitle {
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 1.5rem !important;
            border-radius: 16px;
        }

        .logo-image {
            height: 50px;
        }

        .main-title {
            font-size: 1.8rem;
            letter-spacing: -0.5px;
        }

        .website-subtitle {
            font-size: 0.75rem;
        }
    }

    /* Form validation styling */
    .login-field .validation-message {
        color: #d32f2f;
        font-size: 0.75rem;
        margin-top: 0.25rem;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
    }

    .login-field .mud-input-outlined.mud-input-error {
        border-color: #d32f2f;
        background: rgba(211, 47, 47, 0.05);
    }

        .login-field .mud-input-outlined.mud-input-error:hover {
            border-color: #d32f2f;
            background: rgba(211, 47, 47, 0.08);
        }
</style>

@code {
    private LoginDTO loginModel = new LoginDTO();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            NavManager.NavigateTo("/dashboard");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        try
        {
            await AuthService.Login(loginModel);
            Snackbar.Add("Welcome back! Login successful.", Severity.Success);
            NavManager.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Invalid email or password. Please try again.", Severity.Error);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}