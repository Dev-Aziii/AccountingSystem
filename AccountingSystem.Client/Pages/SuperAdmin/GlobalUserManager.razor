@page "/superadmin/users"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@inject SuperAdminService SuperAdminService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Global User Management</PageTitle>

<style>
    .user-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .user-stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .user-stat-card {
        padding: 1rem 1.25rem;
        background: white;
        border-radius: 14px;
        border: 1px solid rgba(22, 84, 127, 0.1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .user-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: rgb(22, 84, 127);
        line-height: 1.2;
    }

    .user-stat-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: rgb(22, 84, 127);
        opacity: 0.65;
    }

    .user-table-card {
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(22, 84, 127, 0.1);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">
    <!-- HEADER -->
    <div class="user-page-header">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: rgb(22, 84, 127);">
                Global User Directory
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgb(56, 146, 147);">
                Manage all users across all tenant companies
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Style="background: linear-gradient(135deg, rgb(22, 84, 127) 0%, rgb(56, 146, 147) 100%); color: white; border-radius: 12px;"
                   StartIcon="@Icons.Material.Filled.Refresh"                   Size="Size.Small" OnClick="LoadData">
            Refresh
        </MudButton>
    </div>

    <!-- QUICK STATS -->
    <div class="user-stats-row">
        <div class="user-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.People" Style="color: #1565C0;" />
            <div>
                <div class="user-stat-value">@users.Count</div>
                <div class="user-stat-label">Total Users</div>
            </div>
        </div>
        <div class="user-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: #4CAF50;" />
            <div>
                <div class="user-stat-value">@users.Count(u => u.Status == "Active")</div>
                <div class="user-stat-label">Active</div>
            </div>
        </div>
        <div class="user-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color: #FF9800;" />
            <div>
                <div class="user-stat-value">@users.Count(u => u.Status == "Restricted")</div>
                <div class="user-stat-label">Restricted</div>
            </div>
        </div>
        <div class="user-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.Block" Style="color: #F44336;" />
            <div>
                <div class="user-stat-value">@users.Count(u => u.Status == "Blocked")</div>
                <div class="user-stat-label">Blocked</div>
            </div>
        </div>
        <div class="user-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.Business" Style="color: #6A1B9A;" />
            <div>
                <div class="user-stat-value">@users.Select(u => u.CompanyName).Distinct().Count()</div>
                <div class="user-stat-label">Companies</div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="user-table-card">
        <MudTable Elevation="0" Dense="true" Items="@users" Hover="true" Loading="@isLoading" Filter="new Func<GlobalUserDTO, bool>(FilterFunc)"
                  Style="background: transparent;">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="color: rgb(22, 84, 127); font-weight: 700;">All System Users</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Search users or companies..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"                              IconSize="Size.Small"
                              Class="mt-0" Style="max-width: 300px;" />
                <MudSelect T="string" @bind-Value="statusFilter" Label="Status" Class="ml-4" Style="max-width: 150px;">
                    <MudSelectItem T="string" Value='@("All")'>All</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Active")'>Active</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Restricted")'>Restricted</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Blocked")'>Blocked</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" @bind-Value="roleFilter" Label="Role" Class="ml-4" Style="max-width: 150px;">
                    <MudSelectItem T="string" Value='@("All")'>All Roles</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Admin")'>Admin</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Accounting")'>Accounting</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Management")'>Management</MudSelectItem>
                </MudSelect>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Company</MudTh>
                <MudTh>Full Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Joined</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: center;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Company">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small"
                                 Style="color: rgb(22, 84, 127); opacity: 0.5;" />
                        <b>@context.CompanyName</b>
                    </div>
                </MudTd>
                <MudTd DataLabel="Name">@context.FullName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@GetRoleColor(context.Role)">
                        @context.Role
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Joined">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                <MudTd DataLabel="Status">
                    @switch (context.Status)
                    {
                        case "Active":
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">Active
                            </MudChip>
                            break;
                        case "Restricted":
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">Restricted
                            </MudChip>
                            break;
                        case "Blocked":
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">Blocked</MudChip>
                            break;
                        default:
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Status</MudChip>
                            break;
                    }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: center;">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight">
                        @if (context.Status != "Active")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Default"
                                         OnClick="@(() => ChangeUserStatus(context, "Active"))">
                                Activate
                            </MudMenuItem>
                        }
                        @if (context.Status != "Restricted")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Warning" IconColor="Color.Default"
                                         OnClick="@(() => ChangeUserStatus(context, "Restricted"))">
                                Restrict
                            </MudMenuItem>
                        }
                        @if (context.Status != "Blocked")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Default"
                                         OnClick="@(() => ConfirmBlockUser(context))">
                                Block
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</MudContainer>

@code {
    private List<GlobalUserDTO> users = new List<GlobalUserDTO>();
    private bool isLoading = true;
    private string searchString = "";
    private string statusFilter = "All";
    private string roleFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            users = await SuperAdminService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeUserStatus(GlobalUserDTO user, string newStatus)
    {
        try
        {
            await SuperAdminService.UpdateUserStatusAsync(user.Id, newStatus);
            user.Status = newStatus;
            user.IsActive = newStatus == "Active";
            Snackbar.Add($"'{user.Email}' is now {newStatus}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadData();
        }
    }

    private async Task ConfirmBlockUser(GlobalUserDTO user)
    {
        var result = await DialogService.ShowMessageBox(
            "Block User",
            $"Are you sure you want to BLOCK '{user.FullName}' ({user.Email})? This will prevent them from logging in.",
            yesText: "Block", cancelText: "Cancel");

        if (result == true)
        {
            await ChangeUserStatus(user, "Blocked");
        }
    }

    private Color GetRoleColor(string? role) => role switch
    {
        "Admin" => Color.Primary,
        "Accounting" => Color.Info,
        "Management" => Color.Secondary,
        _ => Color.Default
    };

    private bool FilterFunc(GlobalUserDTO element)
    {
        bool matchesSearch = string.IsNullOrWhiteSpace(searchString) ||
            (element.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (element.CompanyName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (element.FullName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);

        bool matchesStatus = statusFilter == "All" || element.Status == statusFilter;
        bool matchesRole = roleFilter == "All" || element.Role == roleFilter;

        return matchesSearch && matchesStatus && matchesRole;
    }
}