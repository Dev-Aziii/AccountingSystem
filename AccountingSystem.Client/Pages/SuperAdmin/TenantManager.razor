@page "/superadmin/tenants"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@inject SuperAdminService SuperAdminService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Tenant Management</PageTitle>

<style>
    .tenant-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .tenant-stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .tenant-stat-card {
        padding: 1rem 1.25rem;
        background: white;
        border-radius: 14px;
        border: 1px solid rgba(22, 84, 127, 0.1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .tenant-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: rgb(22, 84, 127);
        line-height: 1.2;
    }

    .tenant-stat-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: rgb(22, 84, 127);
        opacity: 0.65;
    }

    .tenant-table-card {
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(22, 84, 127, 0.1);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">
    <!-- HEADER -->
    <div class="tenant-page-header">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: rgb(22, 84, 127);">
                Tenant Management
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgb(56, 146, 147);">
                Manage all registered companies in the system
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Style="background: linear-gradient(135deg, rgb(22, 84, 127) 0%, rgb(56, 146, 147) 100%); color: white; border-radius: 12px;"
                   StartIcon="@Icons.Material.Filled.Refresh"                   Size="Size.Medium" OnClick="LoadData">
            Refresh
        </MudButton>
    </div>

    <!-- QUICK STATS -->
    <div class="tenant-stats-row">
        <div class="tenant-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.Business" Style="color: #1565C0;" />
            <div>
                <div class="tenant-stat-value">@tenants.Count</div>
                <div class="tenant-stat-label">Total Tenants</div>
            </div>
        </div>
        <div class="tenant-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: #4CAF50;" />
            <div>
                <div class="tenant-stat-value">@tenants.Count(t => t.Status == "Active")</div>
                <div class="tenant-stat-label">Active</div>
            </div>
        </div>
        <div class="tenant-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Style="color: #FF9800;" />
            <div>
                <div class="tenant-stat-value">@tenants.Count(t => t.Status == "Suspended")</div>
                <div class="tenant-stat-label">Suspended</div>
            </div>
        </div>
        <div class="tenant-stat-card">
            <MudIcon Icon="@Icons.Material.Filled.Block" Style="color: #F44336;" />
            <div>
                <div class="tenant-stat-value">@tenants.Count(t => t.Status == "Blocked")</div>
                <div class="tenant-stat-label">Blocked</div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="tenant-table-card">
        <MudTable Items="@tenants" Hover="true" Loading="@isLoading" Filter="new Func<TenantDTO, bool>(FilterFunc)"
                  Dense="false" Elevation="0" Style="background: transparent;">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="color: rgb(22, 84, 127); font-weight: 700;">Registered Companies
                </MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Search tenants..."                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"                              IconSize="Size.Medium" Class="mt-0"
                              Style="max-width: 300px;" />
                <MudSelect T="string" @bind-Value="statusFilter" Label="Status" Class="ml-4" Style="max-width: 150px;">
                    <MudSelectItem T="string" Value='@("All")'>All</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Active")'>Active</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Suspended")'>Suspended</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Blocked")'>Blocked</MudSelectItem>
                </MudSelect>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Company Name</MudTh>
                <MudTh>Address</MudTh>
                <MudTh>Registered</MudTh>
                <MudTh>Users</MudTh>
                <MudTh>Last Activity</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: center;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                <MudTd DataLabel="Address">@(context.Address ?? "—")</MudTd>
                <MudTd DataLabel="Registered">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                <MudTd DataLabel="Users">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @context.UserCount users
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Last Activity">
                    @(context.LastActivityDate?.ToString("MMM dd, yyyy") ?? "No activity")
                </MudTd>
                <MudTd DataLabel="Status">
                    @switch (context.Status)
                    {
                        case "Active":
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Active
                            </MudChip>
                            break;
                        case "Suspended":
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Suspended
                            </MudChip>
                            break;
                        case "Blocked":
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Blocked</MudChip>
                            break;
                        default:
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Status</MudChip>
                            break;
                    }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: center;">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight">
                        @if (context.Status != "Active")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success"
                                         OnClick="@(() => ChangeStatus(context, "Active"))">
                                Activate
                            </MudMenuItem>
                        }
                        @if (context.Status != "Suspended")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.PauseCircle" IconColor="Color.Warning"
                                         OnClick="@(() => ChangeStatus(context, "Suspended"))">
                                Suspend
                            </MudMenuItem>
                        }
                        @if (context.Status != "Blocked")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error"
                                         OnClick="@(() => ConfirmBlock(context))">
                                Block
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</MudContainer>

@code {
    private List<TenantDTO> tenants = new List<TenantDTO>();
    private bool isLoading = true;
    private string searchString = "";
    private string statusFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            tenants = await SuperAdminService.GetAllCompaniesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeStatus(TenantDTO tenant, string newStatus)
    {
        try
        {
            await SuperAdminService.UpdateCompanyStatusAsync(tenant.Id, newStatus);
            tenant.Status = newStatus;
            tenant.IsActive = newStatus == "Active";
            Snackbar.Add($"'{tenant.Name}' is now {newStatus}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadData();
        }
    }

    private async Task ConfirmBlock(TenantDTO tenant)
    {
        var result = await DialogService.ShowMessageBox(
            "Block Company",
            $"Are you sure you want to BLOCK '{tenant.Name}'? This will permanently prevent all users from accessing the system until unblocked.",
            yesText: "Block", cancelText: "Cancel");

        if (result == true)
        {
            await ChangeStatus(tenant, "Blocked");
        }
    }

    private bool FilterFunc(TenantDTO element)
    {
        bool matchesSearch = string.IsNullOrWhiteSpace(searchString) ||
            (element.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (element.Address?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);

        bool matchesStatus = statusFilter == "All" || element.Status == statusFilter;

        return matchesSearch && matchesStatus;
    }
}