@page "/superadmin/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using MudBlazor.Charts
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@inject SuperAdminService SuperAdminService
@inject NavigationManager NavManager

<PageTitle>System Overview</PageTitle>



<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">
    <!-- HEADER -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            @if (isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="28px" Class="mb-1" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="16px" />
            }
            else
            {
                <MudText Typo="Typo.h5">
                    System Overview
                </MudText>
                <MudText Typo="Typo.body2">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy") &mdash; Super Administrator Dashboard
                </MudText>
            }
        </div>
        @if (!isLoading)
        {
            <MudButton Variant="Variant.Outlined"
                      
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Size="Size.Medium" OnClick="LoadData">
                Refresh
            </MudButton>
        }
    </div>

    @if (isLoading)
    {
        <div class="sa-dashboard-grid">
            @for (int i = 0; i < 4; i++)
            {
                <div class="sa-span-3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="90px" />
                </div>
            }
            <div class="sa-span-6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="350px" />
            </div>
            <div class="sa-span-6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="350px" />
            </div>
        </div>
    }
    else if (stats != null)
    {
        <div class="sa-dashboard-grid">
            <!-- ROW 1: KPI METRIC CARDS -->
            <div class="sa-span-3">
                <div class="sa-metric-card" @onclick='() => NavManager.NavigateTo("/superadmin/tenants")'>
                    <div class="sa-metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Medium" />
                    </div>
                    <div>
                        <div class="sa-metric-value">@stats.TotalCompanies</div>
                        <div class="sa-metric-label">Total Tenants</div>
                    </div>
                </div>
            </div>
            <div class="sa-span-3">
                <div class="sa-metric-card" @onclick='() => NavManager.NavigateTo("/superadmin/tenants")'>
                    <div class="sa-metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" />
                    </div>
                    <div>
                        <div class="sa-metric-value">@stats.ActiveCompanies</div>
                        <div class="sa-metric-label">Active Tenants</div>
                    </div>
                </div>
            </div>
            <div class="sa-span-3">
                <div class="sa-metric-card" @onclick='() => NavManager.NavigateTo("/superadmin/users")'>
                    <div class="sa-metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" />
                    </div>
                    <div>
                        <div class="sa-metric-value">@stats.TotalUsers</div>
                        <div class="sa-metric-label">Total Users</div>
                    </div>
                </div>
            </div>
            <div class="sa-span-3">
                <div class="sa-metric-card" @onclick='() => NavManager.NavigateTo("/superadmin/users")'>
                    <div class="sa-metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Medium" />
                    </div>
                    <div>
                        <div class="sa-metric-value">@(stats.SuspendedCompanies + stats.BlockedCompanies)</div>
                        <div class="sa-metric-label">Issues</div>
                    </div>
                </div>
            </div>

            <!-- ROW 2: STATUS BREAKDOWN CARDS -->
            <div class="sa-span-6">
                <div class="sa-featured-card">
                    <div class="sa-section-header">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                        <span class="sa-section-title">Tenant Status Breakdown</span>
                    </div>
                    <div class="d-flex gap-4 mb-4">
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.ActiveCompanies</b> Active</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.SuspendedCompanies</b> Suspended</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.BlockedCompanies</b> Blocked</MudText>
                        </div>
                    </div>
                    <div class="sa-chart-container">
                        @if (stats.TotalCompanies > 0)
                        {
                            <MudChart ChartType="ChartType.Donut"
                                      InputData="@tenantChartData"
                                      InputLabels="@tenantChartLabels"
                                      Width="100%" Height="250px"
                                      ChartOptions="@donutOptions" />
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center">
                                <MudText Typo="Typo.body2" Color="Color.Tertiary">No tenants registered yet</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="sa-span-6">
                <div class="sa-featured-card">
                    <div class="sa-section-header">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        <span class="sa-section-title">User Status Breakdown</span>
                    </div>
                    <div class="d-flex gap-4 mb-4">
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.ActiveUsers</b> Active</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.RestrictedUsers</b> Restricted</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <span class="sa-status-dot"></span>
                            <MudText Typo="Typo.body2"><b>@stats.BlockedUsers</b> Blocked</MudText>
                        </div>
                    </div>
                    <div class="sa-chart-container">
                        @if (stats.TotalUsers > 0)
                        {
                            <MudChart ChartType="ChartType.Donut"
                                      InputData="@userChartData"
                                      InputLabels="@userChartLabels"
                                      Width="100%" Height="250px"
                                      ChartOptions="@donutOptions" />
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center">
                                <MudText Typo="Typo.body2" Color="Color.Tertiary">No users registered yet</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ROW 3: TREND CHARTS -->
            <div class="sa-span-6">
                <div class="sa-featured-card">
                    <div class="sa-section-header">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                        <span class="sa-section-title">Tenant Registrations (12 Months)</span>
                    </div>
                    <div class="sa-chart-container">
                        <MudChart ChartType="ChartType.Bar"
                                  InputData="@registrationChartData"
                                  InputLabels="@registrationChartLabels"
                                  XAxisLabels="@registrationChartLabels"
                                  Width="100%" Height="250px"
                                  ChartOptions="@barOptions" />
                    </div>
                </div>
            </div>

            <div class="sa-span-6">
                <div class="sa-featured-card">
                    <div class="sa-section-header">
                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Small" />
                        <span class="sa-section-title">User Growth (12 Months)</span>
                    </div>
                    <div class="sa-chart-container">
                        <MudChart ChartType="ChartType.Line"
                                  InputData="@userGrowthChartData"
                                  InputLabels="@userGrowthChartLabels"
                                  XAxisLabels="@userGrowthChartLabels"
                                  Width="100%" Height="250px"
                                  ChartOptions="@lineOptions" />
                    </div>
                </div>
            </div>

            <!-- ROW 4: RECENT ACTIVITY -->
            <div class="sa-span-12">
                <div class="sa-featured-card">
                    <div class="sa-section-header">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                        <span class="sa-section-title">Recent Super Admin Actions</span>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   OnClick='() => NavManager.NavigateTo("/superadmin/audit-logs")'
                                  >
                            View All
                        </MudButton>
                    </div>
                    @if (stats.RecentActions.Any())
                    {
                        @foreach (var log in stats.RecentActions.Take(5))
                        {
                            <div class="sa-log-item">
                                <MudIcon Icon="@GetActionIcon(log.Action)" Size="Size.Small"
                                        color: {GetActionColor(log.Action)}; margin-top: 2px;")" />
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <b>@log.AdminEmail</b> @FormatAction(log.Action)
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                >@log.TargetType</MudChip>
                                        <b>@log.TargetName</b>
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(log.OldValue) && !string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            @log.OldValue &rarr; @log.NewValue
                                        </MudText>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                    @log.Timestamp.ToString("MMM dd, HH:mm")
                                </MudText>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center pa-6">
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">No recent actions recorded.</MudText>
                        </div>
                    }
                </div>
            </div>

            <!-- ROW 5: SYSTEM HEALTH -->
            <div class="sa-span-12">
                <div class="sa-featured-card">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        <div>
                            <MudText Typo="Typo.h6">System Operational</MudText>
                            <MudText Typo="Typo.body2">
                                All services running normally &bull; @stats.TotalCompanies tenants &bull; @stats.TotalUsers users
                            </MudText>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</MudContainer>

@code {
    private SystemDashboardDTO? stats;
    private bool isLoading = true;

    // Chart data
    private double[] tenantChartData = Array.Empty<double>();
    private string[] tenantChartLabels = Array.Empty<string>();
    private double[] userChartData = Array.Empty<double>();
    private string[] userChartLabels = Array.Empty<string>();
    private double[] registrationChartData = Array.Empty<double>();
    private string[] registrationChartLabels = Array.Empty<string>();
    private double[] userGrowthChartData = Array.Empty<double>();
    private string[] userGrowthChartLabels = Array.Empty<string>();

    private ChartOptions donutOptions = new()
    {
    };

    private ChartOptions barOptions = new()
    {
        YAxisTicks = 1
    };

    private ChartOptions lineOptions = new()
    {
        YAxisTicks = 1
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            stats = await SuperAdminService.GetDashboardStatsAsync();
            PrepareChartData();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrepareChartData()
    {
        if (stats == null) return;

        // Tenant donut chart
        tenantChartData = new double[] { stats.ActiveCompanies, stats.SuspendedCompanies, stats.BlockedCompanies };
        tenantChartLabels = new string[] { "Active", "Suspended", "Blocked" };

        // User donut chart 
        userChartData = new double[] { stats.ActiveUsers, stats.RestrictedUsers, stats.BlockedUsers };
        userChartLabels = new string[] { "Active", "Restricted", "Blocked" };

        // Registration bar chart
        if (stats.MonthlyRegistrations.Any())
        {
            registrationChartData = stats.MonthlyRegistrations.Select(m => (double)m.Count).ToArray();
            registrationChartLabels = stats.MonthlyRegistrations.Select(m => FormatMonthLabel(m.Month)).ToArray();
        }

        // User growth line chart
        if (stats.MonthlyUserGrowth.Any())
        {
            userGrowthChartData = stats.MonthlyUserGrowth.Select(m => (double)m.Count).ToArray();
            userGrowthChartLabels = stats.MonthlyUserGrowth.Select(m => FormatMonthLabel(m.Month)).ToArray();
        }
    }

    private string FormatMonthLabel(string yearMonth)
    {
        if (DateTime.TryParse(yearMonth + "-01", out var date))
            return date.ToString("MMM");
        return yearMonth;
    }

    private string GetActionIcon(string action) => action switch
    {
        "COMPANY_STATUS_CHANGE" => Icons.Material.Filled.Business,
        "USER_STATUS_CHANGE" => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.Info
    };

    private string GetActionColor(string action) => action switch
    {
        "COMPANY_STATUS_CHANGE" => "#1565C0",
        "USER_STATUS_CHANGE" => "#6A1B9A",
        _ => "#757575"
    };

    private string FormatAction(string action) => action switch
    {
        "COMPANY_STATUS_CHANGE" => "changed status of",
        "USER_STATUS_CHANGE" => "changed status of",
        _ => "performed action on"
    };
}