@page "/gl"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Accounting")]

<PageTitle>General Ledger</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-1">General Ledger</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--text-muted);">Post journal entries and maintain your chart of accounts.</MudText>

    <MudBreadcrumbs Items="@_links" Class="mb-6" />

    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var link in _links)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@link.Href">@link.Text</MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _links = new()
    {
        new("Journal Entries", href: "gl/journal"),
        new("Chart of Accounts", href: "gl/accounts")
    };
}
