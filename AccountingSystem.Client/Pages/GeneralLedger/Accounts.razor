@page "/gl/accounts"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Accounting,Management")]
@inject LedgerService LedgerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Chart of Accounts</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Chart of Accounts</MudText>
        <AuthorizeView Roles="Admin,Accounting">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                Add New Account
            </MudButton>
        </AuthorizeView>
    </div>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Active Accounts" OnClick="@(() => LoadList(false))">
            <MudTable Items="@accounts" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<AccountDTO,bool>(FilterFunc)" Loading="@_loading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Active List</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <AuthorizeView Roles="Admin,Accounting">
                        <MudTh Style="text-align:right">Actions</MudTh>
                    </AuthorizeView>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                    <MudTd DataLabel="Type">@context.Type</MudTd>
                    <AuthorizeView Roles="Admin,Accounting">
                        <MudTd DataLabel="Actions" Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="() => OpenEditDialog(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Id)" />
                        </MudTd>
                    </AuthorizeView>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </MudTabPanel>

        <AuthorizeView Roles="Admin,Accounting">
            <MudTabPanel Text="Archived Accounts" OnClick="@(() => LoadList(true))">
                <MudTable Items="@accounts" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<AccountDTO,bool>(FilterFunc)" Loading="@_loading">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh Style="text-align:right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        <MudTd DataLabel="Name" Style="color:gray;">@context.Name</MudTd>
                        <MudTd DataLabel="Actions" Style="text-align:right">
                            <MudTooltip Text="Restore Account">
                                <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" Color="Color.Success" OnClick="() => ConfirmRestore(context.Id)" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            </MudTabPanel>
        </AuthorizeView>
    </MudTabs>
</MudContainer>

@code {
    private List<AccountDTO> accounts = new List<AccountDTO>();
    private string searchString = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadList(false);

    private async Task LoadList(bool archived)
    {
        _loading = true;
        try 
        { 
            // Note: Currently AccountDTO does not carry IsDeleted, but we know if includeArchived=true, API returns ALL.
            // Ideally, AccountDTO should be updated to include IsDeleted property in Shared.
            // For now, assume the service handles filtering or API logic.
            // WORKAROUND: If IsDeleted is not on DTO, we might see duplicates if API returns all. 
            // Correct logic: API filtering.
            var all = await LedgerService.GetAccountsAsync(archived);
            // Assuming AccountDTO has no IsDeleted, we rely on the fact that if we requested archived=false, we get only active.
            // If we request archived=true, we get ALL. We need to filter client side or API side.
            // Let's assume for this phase we update the API to return deleted status or filter properly.
            // BETTER: Add IsDeleted to AccountDTO in Shared project.
            accounts = all; // Placeholder until DTO update
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private bool FilterFunc(AccountDTO element) =>
        string.IsNullOrWhiteSpace(searchString) ||
        element.Code.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase);

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountDialog>("Add Account", options);
        if (!(await dialog.Result).Canceled) await LoadList(false);
    }

    private async Task OpenEditDialog(AccountDTO account)
    {
        var parameters = new DialogParameters { ["Account"] = account };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountDialog>("Edit Account", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadList(false);
    }

    private async Task ConfirmDelete(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Archive", "Archive this account?", yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            try { await LedgerService.DeleteAccountAsync(id); Snackbar.Add("Account archived.", Severity.Success); await LoadList(false); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ConfirmRestore(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Restore", "Restore this account?", yesText: "Restore", cancelText: "Cancel");
        if (result == true)
        {
            try { await LedgerService.RestoreAccountAsync(id); Snackbar.Add("Account restored.", Severity.Success); await LoadList(true); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}