@page "/gl/accounts"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin,Accounting,Management")]
@inject LedgerService LedgerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Chart of Accounts</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="450px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Chart of Accounts
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Set up account classifications to track your business financial activities
                    </MudText>
                }
            </div>
            @if (_initialLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="42px" />
            }
            else
            {
                <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                    <MudButton Variant="Variant.Filled" Class="create-btn" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                        Add new Account
                    </MudButton>
                </AuthorizeView>
            }
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR TABS AND TABLE -->
        <MudCard Elevation="2">
            <!-- Tabs Skeleton -->
            <div class="d-flex pa-4 border-bottom-medium">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="36px" Class="mr-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="160px" Height="36px" />
            </div>

            <MudCardContent Class="pa-6">
                <!-- Toolbar Skeleton -->
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="40px" />
                </div>

                <!-- Table Header Skeleton -->
                <div class="d-flex justify-space-between mb-3 pa-2 border-bottom-strong">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                </div>

                <!-- Table Rows Skeleton -->
                @for (int i = 0; i < 8; i++)
                {
                    <div class="d-flex justify-space-between align-center mb-3 pa-2 border-bottom-soft">
                        <div class="flex-1">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" />
                        </div>
                        <div class="flex-2">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="16px" />
                        </div>
                        <div class="flex-1">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="90px" Height="24px" />
                        </div>
                        <div class="flex-1 text-right">
                            <div class="d-flex justify-end">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="mr-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination Skeleton -->
                <div class="d-flex justify-center mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="32px" />
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <!-- Tab 1: Active Accounts -->
            <MudTabPanel Text="Active Accounts" OnClick="@(() => LoadList(false))">
                <MudTable Items="@accounts" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<AccountDTO, bool>(FilterFunc)" Loading="@_loading">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Active List</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Type</MudTh>
                        <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                            <MudTh Class="text-right">Actions</MudTh>
                        </AuthorizeView>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                        <MudTd DataLabel="Type">
                            @switch (context.Type)
                            {
                                case "Asset":
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">Asset</MudChip>
                                    ; break;
                                case "Liability":

                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">Liability</MudChip>
                                    ; break;
                                case "Equity":

                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">Equity</MudChip>
                                    ; break;
                                case "Revenue":

                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Revenue</MudChip>
                                    ; break;
                                case "Expense":

                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">Expense</MudChip>
                                    ; break;
                                default:

                                    <MudChip T="string" Size="Size.Small">@context.Type</MudChip>
                                    ; break;
                            }
                        </MudTd>
                        <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                            <MudTd DataLabel="Actions" Class="text-right">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="() => OpenEditDialog(context)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Id)" />
                            </MudTd>
                        </AuthorizeView>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            </MudTabPanel>

            <!-- Tab 2: Archived Accounts -->
            <AuthorizeView Roles="Admin,Accounting" Context="authContext">
                <MudTabPanel Text="Archived Accounts" OnClick="@(() => LoadList(true))">
                    <MudTable Items="@accounts" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<AccountDTO, bool>(FilterFunc)" Loading="@_loading">
                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh Class="text-right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Code">@context.Code</MudTd>
                            <MudTd DataLabel="Name" Class="text-subtle">@context.Name</MudTd>
                            <MudTd DataLabel="Type">@context.Type</MudTd>
                            <MudTd DataLabel="Actions" Class="text-right">
                                <MudTooltip Text="Restore Account">
                                    <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" Color="Color.Success" OnClick="() => ConfirmRestore(context.Id)" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager /></PagerContent>
                    </MudTable>
                </MudTabPanel>
            </AuthorizeView>
        </MudTabs>
    }
</MudContainer>

@code {
    private List<AccountDTO> accounts = new List<AccountDTO>();
    private string searchString = "";
    private bool _loading = true;
    private bool _initialLoading = true;
    private bool _showArchived = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadList(false);
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task LoadList(bool archived)
    {
        _showArchived = archived;
        _loading = true;
        try
        {
            var all = await LedgerService.GetAccountsAsync(archived);
            if (all != null)
            {
                if (archived)
                    accounts = all.Where(a => a.IsDeleted).ToList();
                else
                    accounts = all.ToList();
            }
            else
            {
                accounts = new List<AccountDTO>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            accounts = new List<AccountDTO>();
        }
        finally { _loading = false; }
    }

    private bool FilterFunc(AccountDTO element) =>
        string.IsNullOrWhiteSpace(searchString) ||
        element.Code.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase);

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountDialog>("Add Account", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadList(false);
    }

    private async Task OpenEditDialog(AccountDTO account)
    {
        var parameters = new DialogParameters { ["Account"] = account };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountDialog>("Edit Account", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadList(false);
    }

    private async Task ConfirmDelete(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Archive", "Archive this account? It will be hidden from selection lists.", yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await LedgerService.DeleteAccountAsync(id);
                Snackbar.Add("Account archived.", Severity.Success);
                await LoadList(false); // Refresh Active list
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ConfirmRestore(int id)
    {
        bool? result = await DialogService.ShowMessageBox("Restore", "Restore this account?", yesText: "Restore", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await LedgerService.RestoreAccountAsync(id);
                Snackbar.Add("Account restored.", Severity.Success);
                await LoadList(true); // Refresh Archived list
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}
