@page "/reports/financials"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using System.Globalization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ReportService ReportService
@inject LedgerService LedgerService
@inject CompanyService CompanyService
@inject ISnackbar Snackbar

<PageTitle>Financial Reports</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8" id="printable-area">

    <MudPaper Class="page-header mb-6 no-print" Elevation="0">
        <div class="d-flex justify-space-between align-center flex-wrap ux-118">
            <div>
                <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                    Financial Statements
                </MudText>
                <MudText Typo="Typo.body1" Class="page-header-subtitle">
                    Fiscal-year financial position and performance
                </MudText>
            </div>
            <div class="d-flex align-center flex-wrap ux-119">
                <MudSelect T="int"
                           Value="selectedFiscalYear"
                           ValueChanged="OnFiscalYearChanged"
                           Label="Fiscal Year"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Disabled="@(isLoading || fiscalYears.Count == 0)"
                           Style="min-width: 170px;">
                    @foreach (var year in fiscalYears)
                    {
                        <MudSelectItem T="int" Value="@year.FiscalYear">FY @year.FiscalYear</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadData" Disabled="isLoading">Refresh</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PictureAsPdf" OnClick="PrintReport" Disabled="@(isLoading || selectedFiscalYear == 0)">Download PDF</MudButton>
            </div>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Class="pa-6" Elevation="2">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Class="mt-3">Loading financial data...</MudText>
        </MudPaper>
    }
    else if (currentCompany == null)
    {
        <MudAlert Severity="Severity.Warning">Company profile is missing.</MudAlert>
    }
    else if (selectedFiscalYear == 0 || incomeTrialBalance == null || balanceTrialBalance == null)
    {
        <MudAlert Severity="Severity.Info">No fiscal-year data available yet.</MudAlert>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="mt-4" Color="Color.Transparent" SliderColor="Color.Primary" Centered="true">

            <MudTabPanel Text="Trial Balance">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Trial Balance</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @selectedPeriodEnd.ToString("MMMM dd, yyyy") (FY @selectedFiscalYear)</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Hover="true" Dense="true" Style="overflow-x: auto;" Elevation="0">
                        <thead>
                            <tr class="mud-theme-light">
                                <th class="py-3"><b>ACCOUNT CODE</b></th>
                                <th class="py-3"><b>ACCOUNT NAME</b></th>
                                <th class="py-3 ux-120"><b>DEBIT</b></th>
                                <th class="py-3 ux-120"><b>CREDIT</b></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in balanceTrialBalance.Accounts.OrderBy(a => a.AccountCode))
                            {
                                var net = line.Debit - line.Credit;
                                var displayDebit = net > 0 ? net : 0;
                                var displayCredit = net < 0 ? Math.Abs(net) : 0;

                                <tr>
                                    <td class="mud-text-secondary">@line.AccountCode</td>
                                    <td>@line.AccountName</td>
                                    <td class="ux-101">@displayDebit.ToString("C2", _phCulture)</td>
                                    <td class="ux-101">@displayCredit.ToString("C2", _phCulture)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            @{
                                var totalNetDebit = balanceTrialBalance.Accounts.Sum(a => (a.Debit - a.Credit) > 0 ? (a.Debit - a.Credit) : 0);
                                var totalNetCredit = balanceTrialBalance.Accounts.Sum(a => (a.Debit - a.Credit) < 0 ? Math.Abs(a.Debit - a.Credit) : 0);
                            }
                            <tr>
                                <td colspan="2" class="py-4 ux-120"><b>TOTALS:</b></td>
                                <td class="py-4 ux-122"><b>@totalNetDebit.ToString("C2", _phCulture)</b></td>
                                <td class="py-4 ux-122"><b>@totalNetCredit.ToString("C2", _phCulture)</b></td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Income Statement">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Income Statement</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">For @selectedPeriodStart.ToString("MMMM dd, yyyy") to @selectedPeriodEnd.ToString("MMMM dd, yyyy") (FY @selectedFiscalYear)</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Elevation="0" Dense="true">
                        <tbody>
                            <tr class="mud-table-row ux-123"><td colspan="2" class="py-2"><b>REVENUE</b></td></tr>
                            @foreach (var line in GetAccountsByType(incomeTrialBalance, "Revenue"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td class="ux-101">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr class="ux-124">
                                <td class="pr-4 ux-120"><b>Total Revenue</b></td>
                                <td class="ux-101"><b>@TotalRevenue.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <tr><td colspan="2" class="py-2"></td></tr>
                            <tr class="mud-table-row ux-123"><td colspan="2" class="py-2"><b>OPERATING EXPENSES</b></td></tr>
                            @foreach (var line in GetAccountsByType(incomeTrialBalance, "Expense"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td class="ux-101">@((line.Debit - line.Credit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr class="ux-124">
                                <td class="pr-4 ux-120"><b>Total Expenses</b></td>
                                <td class="ux-101"><b>(@TotalExpense.ToString("C2", _phCulture))</b></td>
                            </tr>

                            <tr><td colspan="2" class="py-4"></td></tr>
                            <tr class="ux-125">
                                <td class="py-4 pl-4"><MudText Typo="Typo.h6"><b>NET INCOME</b></MudText></td>
                                <td class="py-4 text-right ux-126"><MudText Typo="Typo.h6"><b>@NetIncome.ToString("C2", _phCulture)</b></MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Balance Sheet">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Balance Sheet</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @selectedPeriodEnd.ToString("MMMM dd, yyyy") (FY @selectedFiscalYear)</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Elevation="0" Dense="true">
                        <tbody>
                            <tr class="mud-table-row ux-123"><td colspan="2" class="py-2"><b>ASSETS</b></td></tr>
                            @foreach (var line in GetAccountsByType(balanceTrialBalance, "Asset"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td class="ux-101">@((line.Debit - line.Credit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr class="ux-124">
                                <td class="pr-4 ux-120"><b>TOTAL ASSETS</b></td>
                                <td class="ux-122"><b>@TotalAssets.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <tr><td colspan="2" class="pt-6"></td></tr>
                            <tr class="mud-table-row ux-123"><td colspan="2" class="py-2"><b>LIABILITIES</b></td></tr>
                            @foreach (var line in GetAccountsByType(balanceTrialBalance, "Liability"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td class="ux-101">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr class="ux-124">
                                <td class="pr-4 ux-120"><b>Total Liabilities</b></td>
                                <td class="ux-101"><b>@TotalLiabilities.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <tr><td colspan="2" class="pt-4"></td></tr>
                            <tr class="mud-table-row ux-123"><td colspan="2" class="py-2"><b>EQUITY</b></td></tr>
                            @foreach (var line in GetAccountsByType(balanceTrialBalance, "Equity"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td class="ux-101">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr><td class="pl-8 mud-text-secondary"><i>Net Income (Current Fiscal Year)</i></td><td class="ux-101">@NetIncome.ToString("C2", _phCulture)</td></tr>
                            <tr class="ux-124">
                                <td class="pr-4 ux-120"><b>Total Equity</b></td>
                                <td class="ux-101"><b>@TotalEquity.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <tr><td colspan="2" class="py-4"></td></tr>
                            <tr class="ux-127">
                                <td class="py-4 pl-4"><MudText Typo="Typo.h6"><b>TOTAL LIABILITIES & EQUITY</b></MudText></td>
                                <td class="py-4 text-right ux-126"><MudText Typo="Typo.h6"><b>@((TotalLiabilities + TotalEquity).ToString("C2", _phCulture))</b></MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>
@code {
    private TrialBalanceDTO? incomeTrialBalance;
    private TrialBalanceDTO? balanceTrialBalance;
    private CompanyDTO? currentCompany;
    private Dictionary<string, string> accountTypes = new();
    private List<FiscalYearSummaryDTO> fiscalYears = new();

    private int selectedFiscalYear;
    private DateTime selectedPeriodStart;
    private DateTime selectedPeriodEnd;
    private bool isLoading;

    private readonly CultureInfo _phCulture = CultureInfo.GetCultureInfo("en-PH");

    private decimal TotalRevenue => GetAccountsByType(incomeTrialBalance, "Revenue").Sum(a => a.Credit - a.Debit);
    private decimal TotalExpense => GetAccountsByType(incomeTrialBalance, "Expense").Sum(a => a.Debit - a.Credit);
    private decimal NetIncome => TotalRevenue - TotalExpense;
    private decimal TotalAssets => GetAccountsByType(balanceTrialBalance, "Asset").Sum(a => a.Debit - a.Credit);
    private decimal TotalLiabilities => GetAccountsByType(balanceTrialBalance, "Liability").Sum(a => a.Credit - a.Debit);
    private decimal TotalEquity => GetAccountsByType(balanceTrialBalance, "Equity").Sum(a => a.Credit - a.Debit) + NetIncome;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var fiscalYearsTask = LedgerService.GetFiscalYearSummariesAsync();
            var accountsTask = LedgerService.GetAccountsAsync();
            var companyTask = CompanyService.GetCurrentCompanyAsync();

            await Task.WhenAll(fiscalYearsTask, accountsTask, companyTask);

            currentCompany = companyTask.Result;

            var accounts = accountsTask.Result;
            accountTypes = accounts != null
                ? accounts.ToDictionary(a => a.Code, a => a.Type)
                : new Dictionary<string, string>();

            fiscalYears = (fiscalYearsTask.Result ?? new List<FiscalYearSummaryDTO>())
                .OrderByDescending(f => f.FiscalYear)
                .ToList();

            if (fiscalYears.Count > 0)
            {
                selectedFiscalYear = fiscalYears[0].FiscalYear;
                await LoadYearData(selectedFiscalYear);
            }
            else
            {
                selectedFiscalYear = 0;
                incomeTrialBalance = null;
                balanceTrialBalance = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load reports: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFiscalYearChanged(int fiscalYear)
    {
        selectedFiscalYear = fiscalYear;
        await LoadYearData(fiscalYear);
    }

    private async Task LoadYearData(int fiscalYear)
    {
        var selected = fiscalYears.FirstOrDefault(f => f.FiscalYear == fiscalYear);
        if (selected == null)
            return;

        selectedPeriodStart = selected.PeriodStart.Date;
        selectedPeriodEnd = selected.PeriodEnd.Date;

        var incomeTask = ReportService.GetTrialBalance(selectedPeriodStart, selectedPeriodEnd, excludeClosingEntries: true);
        var balanceTask = ReportService.GetTrialBalance(null, selectedPeriodEnd);

        await Task.WhenAll(incomeTask, balanceTask);
        incomeTrialBalance = incomeTask.Result;
        balanceTrialBalance = balanceTask.Result;
    }

    private IEnumerable<AccountBalanceDTO> GetAccountsByType(TrialBalanceDTO? source, string type)
    {
        if (source == null)
            return Enumerable.Empty<AccountBalanceDTO>();

        return source.Accounts
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == type)
            .OrderBy(a => a.AccountCode);
    }

    private async Task PrintReport()
    {
        if (selectedFiscalYear == 0)
        {
            Snackbar.Add("Select a fiscal year first.", Severity.Warning);
            return;
        }

        try
        {
            Snackbar.Add("Generating Financial Report PDF...", Severity.Info);
            await ReportService.DownloadFinancialsPdf(selectedFiscalYear);
            Snackbar.Add("Download started.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
