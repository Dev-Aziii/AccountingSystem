@page "/reports/financials"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using System.Globalization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ReportService ReportService
@inject LedgerService LedgerService
@inject IJSRuntime JS

<PageTitle>Financial Reports</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8" ID="printable-area">

    <!-- ================= ACTION BAR ================= -->
    <div class="d-flex justify-space-between align-center mb-6 no-print">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-1"><b>Financial Statements</b></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Real-time financial position and performance</MudText>
        </div>
        <div>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadData"
                       Class="mr-2">
                Refresh
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintReport">
                Print / PDF
            </MudButton>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (trialBalance != null)
    {
        <MudTabs Elevation="0"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="mt-4"
                 Color="Color.Transparent"
                 SliderColor="Color.Primary"
                 Centered="true">

            <!-- ================= TRIAL BALANCE ================= -->
            <MudTabPanel Text="Trial Balance">
                <MudPaper Elevation="4" Class="pa-8 report-paper">

                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1">
                            <b>My Company Inc.</b>
                        </MudText>
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mb-1">
                            Trial Balance
                        </MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">
                            As of @DateTime.Now.ToString("MMMM dd, yyyy")
                        </MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width:50%;" />
                    </div>

                    <MudSimpleTable Class="financial-table" Hover="true" Dense="true" Elevation="0">
                        <colgroup>
                            <col style="width:15%;" />
                            <col style="width:45%;" />
                            <col style="width:20%;" />
                            <col style="width:20%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="th-left">ACCOUNT CODE</th>
                                <th class="th-left">ACCOUNT NAME</th>
                                <th class="th-right">DEBIT</th>
                                <th class="th-right">CREDIT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in trialBalance.Accounts.OrderBy(a => a.AccountCode))
                            {
                                <tr>
                                    <td class="td-left mud-text-secondary">@line.AccountCode</td>
                                    <td class="td-left">@line.AccountName</td>
                                    <td class="td-right">
                                        @(line.Debit != 0 ? line.Debit.ToString("C2", _phCulture) : "-")
                                    </td>
                                    <td class="td-right">
                                        @(line.Credit != 0 ? line.Credit.ToString("C2", _phCulture) : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="total-row">
                                <td colspan="2" class="td-right"><b>TOTALS</b></td>
                                <td class="td-right double-underline">
                                    <b>@trialBalance.TotalDebit.ToString("C2", _phCulture)</b>
                                </td>
                                <td class="td-right double-underline">
                                    <b>@trialBalance.TotalCredit.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <!-- ================= INCOME STATEMENT ================= -->
            <MudTabPanel Text="Income Statement">
                <MudPaper Elevation="4" Class="pa-8 report-paper">

                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center"><b>My Company Inc.</b></MudText>
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mb-1">
                            Income Statement
                        </MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">
                            For the period ending @DateTime.Now.ToString("MMMM dd, yyyy")
                        </MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width:50%;" />
                    </div>

                    <MudSimpleTable Class="financial-table" Dense="true" Elevation="0">
                        <colgroup>
                            <col style="width:70%;" />
                            <col style="width:30%;" />
                        </colgroup>
                        <tbody>
                            <tr class="section-row">
                                <td colspan="2">REVENUE</td>
                            </tr>
                            @foreach (var line in GetAccountsByType("Revenue"))
                            {
                                <tr>
                                    <td class="td-left indent">@line.AccountName</td>
                                    <td class="td-right">@line.Credit.ToString("C2", _phCulture)</td>
                                </tr>
                            }
                            <tr class="total-row">
                                <td class="td-right"><b>Total Revenue</b></td>
                                <td class="td-right double-underline">
                                    <b>@TotalRevenue.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>

                            <tr><td colspan="2" class="spacer-row"></td></tr>

                            <tr class="section-row">
                                <td colspan="2">OPERATING EXPENSES</td>
                            </tr>
                            @foreach (var line in GetAccountsByType("Expense"))
                            {
                                <tr>
                                    <td class="td-left indent">@line.AccountName</td>
                                    <td class="td-right">@line.Debit.ToString("C2", _phCulture)</td>
                                </tr>
                            }
                            <tr class="total-row">
                                <td class="td-right"><b>Total Expenses</b></td>
                                <td class="td-right double-underline">
                                    <b>(@TotalExpense.ToString("C2", _phCulture))</b>
                                </td>
                            </tr>

                            <tr class="net-income-row">
                                <td><b>NET INCOME</b></td>
                                <td class="td-right double-underline">
                                    <b>@NetIncome.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <!-- ================= BALANCE SHEET ================= -->
            <MudTabPanel Text="Balance Sheet">
                <MudPaper Elevation="4" Class="pa-8 report-paper">

                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center"><b>My Company Inc.</b></MudText>
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mb-1">
                            Balance Sheet
                        </MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">
                            As of @DateTime.Now.ToString("MMMM dd, yyyy")
                        </MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width:50%;" />
                    </div>

                    <MudSimpleTable Class="financial-table" Dense="true" Elevation="0">
                        <colgroup>
                            <col style="width:70%;" />
                            <col style="width:30%;" />
                        </colgroup>
                        <tbody>
                            <tr class="section-row">
                                <td colspan="2">ASSETS</td>
                            </tr>
                            @foreach (var line in GetAccountsByType("Asset"))
                            {
                                <tr>
                                    <td class="td-left indent">@line.AccountName</td>
                                    <td class="td-right">@((line.Debit - line.Credit).ToString("C2", _phCulture))</td>
                                </tr>
                            }
                            <tr class="total-row">
                                <td class="td-right"><b>Total Assets</b></td>
                                <td class="td-right double-underline">
                                    <b>@TotalAssets.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>

                            <tr><td colspan="2" class="spacer-row"></td></tr>

                            <tr class="section-row">
                                <td colspan="2">LIABILITIES</td>
                            </tr>
                            @foreach (var line in GetAccountsByType("Liability"))
                            {
                                <tr>
                                    <td class="td-left indent">@line.AccountName</td>
                                    <td class="td-right">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td>
                                </tr>
                            }
                            <tr class="total-row">
                                <td class="td-right"><b>Total Liabilities</b></td>
                                <td class="td-right">
                                    <b>@TotalLiabilities.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>

                            <tr><td colspan="2" class="spacer-row"></td></tr>

                            <tr class="section-row">
                                <td colspan="2">EQUITY</td>
                            </tr>
                            @foreach (var line in GetAccountsByType("Equity"))
                            {
                                <tr>
                                    <td class="td-left indent">@line.AccountName</td>
                                    <td class="td-right">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td>
                                </tr>
                            }
                            <tr>
                                <td class="td-left indent mud-text-secondary"><i>Net Income (Current Period)</i></td>
                                <td class="td-right">@NetIncome.ToString("C2", _phCulture)</td>
                            </tr>
                            <tr class="total-row">
                                <td class="td-right"><b>Total Equity</b></td>
                                <td class="td-right">
                                    <b>@TotalEquity.ToString("C2", _phCulture)</b>
                                </td>
                            </tr>

                            <tr class="net-income-row">
                                <td><b>TOTAL LIABILITIES & EQUITY</b></td>
                                <td class="td-right double-underline">
                                    <b>@((TotalLiabilities + TotalEquity).ToString("C2", _phCulture))</b>
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<!-- ================= STYLES ================= -->
<style>
    .financial-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
    }

    .th-left {
        text-align: left;
        padding: 8px;
        font-weight: bold;
        font-size: 0.85rem;
        border-bottom: 2px solid #ccc;
    }

    .th-right {
        text-align: right;
        padding: 8px;
        font-weight: bold;
        font-size: 0.85rem;
        border-bottom: 2px solid #ccc;
    }

    .td-left {
        text-align: left;
        padding: 6px 8px;
    }

    .td-right {
        text-align: right;
        padding: 6px 8px;
        font-family: monospace;
    }

    .indent {
        padding-left: 32px;
    }

    .section-row td {
        background-color: #f0f2f5;
        font-weight: bold;
        padding: 8px;
    }

    .total-row td {
        border-top: 2px solid #ccc;
        padding-top: 8px;
        font-weight: bold;
    }

    .net-income-row td {
        background-color: #e3f2fd;
        font-weight: bold;
        font-size: 1.05rem;
        padding: 10px;
    }

    .double-underline {
        border-bottom: 3px double black;
    }

    .spacer-row td {
        height: 16px;
    }

    /* ================= PRINT ================= */
    @@media print {
        body {
            background-color: white !important;
        }

        .no-print,
        .mud-appbar,
        .mud-drawer,
        .mud-drawer-overlay,
        .mud-tabs-toolbar {
            display: none !important;
        }

        .mud-main-content,
        .mud-container {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }

        .report-paper {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }
    }
</style>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes = new();
    private bool isLoading;

    private readonly CultureInfo _phCulture = CultureInfo.GetCultureInfo("en-PH");

    private decimal TotalRevenue => GetAccountsByType("Revenue").Sum(a => a.Credit - a.Debit);
    private decimal TotalExpense => GetAccountsByType("Expense").Sum(a => a.Debit - a.Credit);
    private decimal NetIncome => TotalRevenue - TotalExpense;
    private decimal TotalAssets => GetAccountsByType("Asset").Sum(a => a.Debit - a.Credit);
    private decimal TotalLiabilities => GetAccountsByType("Liability").Sum(a => a.Credit - a.Debit);
    private decimal TotalEquity => GetAccountsByType("Equity").Sum(a => a.Credit - a.Debit) + NetIncome;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var accTask = LedgerService.GetAccountsAsync();
            await Task.WhenAll(tbTask, accTask);

            trialBalance = tbTask.Result;
            accountTypes = accTask.Result.ToDictionary(a => a.Code, a => a.Type);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<AccountBalanceDTO> GetAccountsByType(string type) =>
        trialBalance?.Accounts.Where(a =>
            accountTypes.ContainsKey(a.AccountCode) &&
            accountTypes[a.AccountCode] == type)
        ?? Enumerable.Empty<AccountBalanceDTO>();

    private async Task PrintReport() =>
        await JS.InvokeVoidAsync("print");
}
