@page "/reports/financials"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ReportService ReportService
@inject LedgerService LedgerService
@inject IJSRuntime JS

<PageTitle>Financial Reports</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" ID="printable-area">

    <!-- No Print Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <MudText Typo="Typo.h4" Color="Color.Primary">Financial Statements</MudText>
        <div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData" Class="mr-2">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReport">Print / PDF</MudButton>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (trialBalance != null)
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="OnTabChanged">

            <!-- TRIAL BALANCE -->
            <MudTabPanel Text="Trial Balance">
                <div class="report-header text-center mb-6">
                    <MudText Typo="Typo.h5" Align="Align.Center"><b>My Company Inc.</b></MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">Trial Balance</MudText>
                    <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                </div>

                <MudTable Items="@trialBalance.Accounts.OrderBy(a => a.AccountCode)" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Account</MudTh>
                        <MudTh Style="text-align:right">Debit</MudTh>
                        <MudTh Style="text-align:right">Credit</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.AccountCode</MudTd>
                        <MudTd DataLabel="Account">@context.AccountName</MudTd>
                        <MudTd DataLabel="Debit" Style="text-align:right">@(context.Debit != 0 ? context.Debit.ToString("N2") : "-")</MudTd>
                        <MudTd DataLabel="Credit" Style="text-align:right">@(context.Credit != 0 ? context.Credit.ToString("N2") : "-")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">TOTALS:</MudTd>
                        <MudTd Style="text-align:right; font-weight:bold;">@trialBalance.TotalDebit.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right; font-weight:bold;">@trialBalance.TotalCredit.ToString("N2")</MudTd>
                    </FooterContent>
                </MudTable>
            </MudTabPanel>

            <!-- INCOME STATEMENT -->
            <MudTabPanel Text="Income Statement">
                <div class="report-header text-center mb-6">
                    <MudText Typo="Typo.h5" Align="Align.Center"><b>My Company Inc.</b></MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">Income Statement</MudText>
                    <MudText Typo="Typo.subtitle1" Align="Align.Center">For the period ending @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                </div>

                <MudSimpleTable Style="overflow-x: auto;">
                    <tbody>
                        <!-- Revenue -->
                        <tr class="mud-table-row" style="background-color:#f5f5f5"><td colspan="2"><b>REVENUE</b></td></tr>
                        @foreach (var line in GetAccountsByType("Revenue"))
                        {
                            <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right">@line.Credit.ToString("N2")</td></tr>
                        }
                        <tr style="border-top:2px solid #ccc"><td style="text-align:right"><b>Total Revenue</b></td><td style="text-align:right"><b>@TotalRevenue.ToString("N2")</b></td></tr>

                        <!-- Expenses -->
                        <tr class="mud-table-row" style="background-color:#f5f5f5"><td colspan="2"><b>OPERATING EXPENSES</b></td></tr>
                        @foreach (var line in GetAccountsByType("Expense"))
                        {
                            <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right">@line.Debit.ToString("N2")</td></tr>
                        }
                        <tr style="border-top:2px solid #ccc"><td style="text-align:right"><b>Total Expenses</b></td><td style="text-align:right"><b>(@TotalExpense.ToString("N2"))</b></td></tr>

                        <!-- Net Income -->
                        <tr style="background-color:#e3f2fd; font-size:1.2em">
                            <td class="py-4"><b>NET INCOME</b></td>
                            <td class="py-4" style="text-align:right"><b>@NetIncome.ToString("N2")</b></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>

            <!-- BALANCE SHEET -->
            <MudTabPanel Text="Balance Sheet">
                <div class="report-header text-center mb-6">
                    <MudText Typo="Typo.h5" Align="Align.Center"><b>My Company Inc.</b></MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">Balance Sheet</MudText>
                    <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                </div>

                <MudSimpleTable>
                    <tbody>
                        <!-- Assets -->
                        <tr class="mud-table-row" style="background-color:#f5f5f5"><td colspan="2"><b>ASSETS</b></td></tr>
                        @foreach (var line in GetAccountsByType("Asset"))
                        {
                            <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right">@((line.Debit - line.Credit).ToString("N2"))</td></tr>
                        }
                        <tr style="border-top:2px solid #ccc"><td style="text-align:right"><b>TOTAL ASSETS</b></td><td style="text-align:right; border-bottom: 3px double black;"><b>@TotalAssets.ToString("N2")</b></td></tr>

                        <!-- Liabilities -->
                        <tr><td colspan="2" class="pt-4"></td></tr>
                        <tr class="mud-table-row" style="background-color:#f5f5f5"><td colspan="2"><b>LIABILITIES</b></td></tr>
                        @foreach (var line in GetAccountsByType("Liability"))
                        {
                            <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right">@((line.Credit - line.Debit).ToString("N2"))</td></tr>
                        }
                        <tr style="border-top:2px solid #ccc"><td style="text-align:right"><b>Total Liabilities</b></td><td style="text-align:right"><b>@TotalLiabilities.ToString("N2")</b></td></tr>

                        <!-- Equity -->
                        <tr class="mud-table-row" style="background-color:#f5f5f5"><td colspan="2"><b>EQUITY</b></td></tr>
                        @foreach (var line in GetAccountsByType("Equity"))
                        {
                            <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right">@((line.Credit - line.Debit).ToString("N2"))</td></tr>
                        }
                        <tr><td class="pl-8 text-muted"><i>Net Income (Current Period)</i></td><td style="text-align:right">@NetIncome.ToString("N2")</td></tr>
                        <tr style="border-top:2px solid #ccc"><td style="text-align:right"><b>Total Equity</b></td><td style="text-align:right"><b>@TotalEquity.ToString("N2")</b></td></tr>

                        <!-- Total L&E -->
                        <tr style="background-color:#e8f5e9; font-size:1.1em">
                            <td class="py-4"><b>TOTAL LIABILITIES & EQUITY</b></td>
                            <td class="py-4" style="text-align:right; border-bottom: 3px double black;"><b>@((TotalLiabilities + TotalEquity).ToString("N2"))</b></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<style>
    @@media print {
        .no-print, .mud-appbar, .mud-drawer, .mud-tabs-toolbar {
            display: none !important;
        }

        .mud-main-content {
            padding: 0 !important;
            margin: 0 !important;
        }

        .mud-tabs-panels {
            box-shadow: none !important;
        }
    }
</style>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes;
    private bool isLoading = false;

    // Computed Properties
    private decimal TotalRevenue => GetAccountsByType("Revenue").Sum(a => a.Credit - a.Debit);
    private decimal TotalExpense => GetAccountsByType("Expense").Sum(a => a.Debit - a.Credit);
    private decimal NetIncome => TotalRevenue - TotalExpense;
    private decimal TotalAssets => GetAccountsByType("Asset").Sum(a => a.Debit - a.Credit);
    private decimal TotalLiabilities => GetAccountsByType("Liability").Sum(a => a.Credit - a.Debit);
    private decimal TotalEquity => GetAccountsByType("Equity").Sum(a => a.Credit - a.Debit) + NetIncome;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var accountsTask = LedgerService.GetAccountsAsync();
            await Task.WhenAll(tbTask, accountsTask);

            trialBalance = tbTask.Result;
            accountTypes = accountsTask.Result.ToDictionary(a => a.Code, a => a.Type);
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; }
    }

    private IEnumerable<AccountBalanceDTO> GetAccountsByType(string type)
    {
        if (trialBalance == null) return Enumerable.Empty<AccountBalanceDTO>();
        return trialBalance.Accounts.Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == type);
    }

    private async Task PrintReport() => await JS.InvokeVoidAsync("print");
    private void OnTabChanged(int index) { /* Optional logic when tab changes */ }
}