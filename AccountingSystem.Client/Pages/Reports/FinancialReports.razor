@page "/reports/financials"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using System.Globalization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ReportService ReportService
@inject LedgerService LedgerService
@inject CompanyService CompanyService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Financial Reports</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8" id="printable-area">

    <!-- Action Bar (Hidden when printing) -->
    <div class="d-flex justify-space-between align-center mb-6 no-print">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-1"><b>Financial Statements</b></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Real-time financial position and performance</MudText>
        </div>
        <div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData" Class="mr-2">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintReport">Download PDF</MudButton>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (trialBalance != null && currentCompany != null)
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="mt-4" Color="Color.Transparent" SliderColor="Color.Primary" Centered="true">

            <!-- TRIAL BALANCE -->
            <MudTabPanel Text="Trial Balance">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Trial Balance</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Hover="true" Dense="true" Style="overflow-x: auto;" Elevation="0">
                        <thead>
                            <tr class="mud-theme-light">
                                <th class="py-3"><b>ACCOUNT CODE</b></th>
                                <th class="py-3"><b>ACCOUNT NAME</b></th>
                                <!-- Fixed Alignment: Applied text-align:right directly to headers -->
                                <th class="py-3" style="text-align:right"><b>DEBIT</b></th>
                                <th class="py-3" style="text-align:right"><b>CREDIT</b></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in trialBalance.Accounts.OrderBy(a => a.AccountCode))
                            {
                                <tr>
                                    <td class="mud-text-secondary">@line.AccountCode</td>
                                    <td>@line.AccountName</td>
                                    <td style="text-align:right; font-family: monospace;">@(line.Debit != 0 ? line.Debit.ToString("C2", _phCulture) : "-")</td>
                                    <td style="text-align:right; font-family: monospace;">@(line.Credit != 0 ? line.Credit.ToString("C2", _phCulture) : "-")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid var(--mud-palette-text-primary);">
                                <td colspan="2" class="py-4" style="text-align:right"><b>TOTALS:</b></td>
                                <td class="py-4" style="text-align:right; font-family: monospace; border-bottom: 3px double black;"><b>@trialBalance.TotalDebit.ToString("C2", _phCulture)</b></td>
                                <td class="py-4" style="text-align:right; font-family: monospace; border-bottom: 3px double black;"><b>@trialBalance.TotalCredit.ToString("C2", _phCulture)</b></td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <!-- INCOME STATEMENT -->
            <MudTabPanel Text="Income Statement">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Income Statement</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">For the period ending @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Elevation="0" Dense="true">
                        <tbody>
                            <!-- Revenue -->
                            <tr class="mud-table-row" style="background-color: var(--mud-palette-background-grey);"><td colspan="2" class="py-2"><b>REVENUE</b></td></tr>
                            @foreach (var line in GetAccountsByType("Revenue"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right; font-family: monospace;">@line.Credit.ToString("C2", _phCulture)</td></tr>
                            }
                            <tr style="border-top:1px solid #ccc">
                                <td style="text-align:right" class="pr-4"><b>Total Revenue</b></td>
                                <td style="text-align:right; font-family: monospace;"><b>@TotalRevenue.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <!-- Expenses -->
                            <tr><td colspan="2" class="py-2"></td></tr>
                            <tr class="mud-table-row" style="background-color: var(--mud-palette-background-grey);"><td colspan="2" class="py-2"><b>OPERATING EXPENSES</b></td></tr>
                            @foreach (var line in GetAccountsByType("Expense"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right; font-family: monospace;">@line.Debit.ToString("C2", _phCulture)</td></tr>
                            }
                            <tr style="border-top:1px solid #ccc">
                                <td style="text-align:right" class="pr-4"><b>Total Expenses</b></td>
                                <td style="text-align:right; font-family: monospace;"><b>(@TotalExpense.ToString("C2", _phCulture))</b></td>
                            </tr>

                            <!-- Net Income -->
                            <tr><td colspan="2" class="py-4"></td></tr>
                            <tr style="background-color: #e3f2fd;">
                                <td class="py-4 pl-4"><MudText Typo="Typo.h6"><b>NET INCOME</b></MudText></td>
                                <td class="py-4 text-right" style="font-family: monospace; border-bottom: 3px double black;"><MudText Typo="Typo.h6"><b>@NetIncome.ToString("C2", _phCulture)</b></MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>

            <!-- BALANCE SHEET -->
            <MudTabPanel Text="Balance Sheet">
                <MudPaper Elevation="4" Class="pa-8 report-paper">
                    <div class="report-header text-center mb-8">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-1"><b>@currentCompany.Name</b></MudText>
                        @if (!string.IsNullOrEmpty(currentCompany.Address))
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center">@currentCompany.Address</MudText>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany.TaxId))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center">TIN: @currentCompany.TaxId</MudText>
                        }

                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mud-text-secondary mt-4 mb-1">Balance Sheet</MudText>
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">As of @DateTime.Now.ToString("MMMM dd, yyyy")</MudText>
                        <MudDivider Class="mt-4 mb-4 mx-auto" Style="width: 50%;" />
                    </div>

                    <MudSimpleTable Elevation="0" Dense="true">
                        <tbody>
                            <!-- Assets -->
                            <tr class="mud-table-row" style="background-color: var(--mud-palette-background-grey);"><td colspan="2" class="py-2"><b>ASSETS</b></td></tr>
                            @foreach (var line in GetAccountsByType("Asset"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right; font-family: monospace;">@((line.Debit - line.Credit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr style="border-top:1px solid #ccc">
                                <td style="text-align:right" class="pr-4"><b>TOTAL ASSETS</b></td>
                                <td style="text-align:right; font-family: monospace; border-bottom: 3px double black;"><b>@TotalAssets.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <!-- Liabilities -->
                            <tr><td colspan="2" class="pt-6"></td></tr>
                            <tr class="mud-table-row" style="background-color: var(--mud-palette-background-grey);"><td colspan="2" class="py-2"><b>LIABILITIES</b></td></tr>
                            @foreach (var line in GetAccountsByType("Liability"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right; font-family: monospace;">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr style="border-top:1px solid #ccc">
                                <td style="text-align:right" class="pr-4"><b>Total Liabilities</b></td>
                                <td style="text-align:right; font-family: monospace;"><b>@TotalLiabilities.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <!-- Equity -->
                            <tr><td colspan="2" class="pt-4"></td></tr>
                            <tr class="mud-table-row" style="background-color: var(--mud-palette-background-grey);"><td colspan="2" class="py-2"><b>EQUITY</b></td></tr>
                            @foreach (var line in GetAccountsByType("Equity"))
                            {
                                <tr><td class="pl-8">@line.AccountName</td><td style="text-align:right; font-family: monospace;">@((line.Credit - line.Debit).ToString("C2", _phCulture))</td></tr>
                            }
                            <tr><td class="pl-8 mud-text-secondary"><i>Net Income (Current Period)</i></td><td style="text-align:right; font-family: monospace;">@NetIncome.ToString("C2", _phCulture)</td></tr>
                            <tr style="border-top:1px solid #ccc">
                                <td style="text-align:right" class="pr-4"><b>Total Equity</b></td>
                                <td style="text-align:right; font-family: monospace;"><b>@TotalEquity.ToString("C2", _phCulture)</b></td>
                            </tr>

                            <!-- Total L&E -->
                            <tr><td colspan="2" class="py-4"></td></tr>
                            <tr style="background-color: #e8f5e9;">
                                <td class="py-4 pl-4"><MudText Typo="Typo.h6"><b>TOTAL LIABILITIES & EQUITY</b></MudText></td>
                                <td class="py-4 text-right" style="font-family: monospace; border-bottom: 3px double black;"><MudText Typo="Typo.h6"><b>@((TotalLiabilities + TotalEquity).ToString("C2", _phCulture))</b></MudText></td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<style>
    /* CSS to hide navigation and toolbar during print */
    @@media print {
        body {
            background-color: white !important;
        }

        .no-print {
            display: none !important;
        }

        .mud-appbar, .mud-drawer, .mud-drawer-overlay {
            display: none !important;
        }

        .mud-tabs-toolbar {
            display: none !important;
        }

        .mud-main-content {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }

        .mud-container {
            padding: 0 !important;
            max-width: 100% !important;
            margin: 0 !important;
        }

        .report-paper {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }
    }
</style>

@code {
    private TrialBalanceDTO? trialBalance;
    private CompanyDTO? currentCompany; // NEW: Hold company details
    private Dictionary<string, string> accountTypes = new Dictionary<string, string>();
    private bool isLoading = false;

    // Philippine Culture for formatting "₱"
    private CultureInfo _phCulture = CultureInfo.GetCultureInfo("en-PH");

    // Computed Properties
    private decimal TotalRevenue => GetAccountsByType("Revenue").Sum(a => a.Credit - a.Debit);
    private decimal TotalExpense => GetAccountsByType("Expense").Sum(a => a.Debit - a.Credit);
    private decimal NetIncome => TotalRevenue - TotalExpense;
    private decimal TotalAssets => GetAccountsByType("Asset").Sum(a => a.Debit - a.Credit);
    private decimal TotalLiabilities => GetAccountsByType("Liability").Sum(a => a.Credit - a.Debit);
    private decimal TotalEquity => GetAccountsByType("Equity").Sum(a => a.Credit - a.Debit) + NetIncome;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var accountsTask = LedgerService.GetAccountsAsync();
            var companyTask = CompanyService.GetCurrentCompanyAsync();

            await Task.WhenAll(tbTask, accountsTask, companyTask);

            trialBalance = tbTask.Result;
            currentCompany = companyTask.Result;

            // Fix: Handle potential null from accountsTask.Result
            var accounts = accountsTask.Result;
            accountTypes = accounts?.ToDictionary(a => a.Code, a => a.Type) ?? new Dictionary<string, string>();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; }
    }

    private IEnumerable<AccountBalanceDTO> GetAccountsByType(string type)
    {
        if (trialBalance == null) return Enumerable.Empty<AccountBalanceDTO>();
        return trialBalance.Accounts.Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == type);
    }

    private async Task PrintReport()
    {
        try
        {
            Snackbar.Add("Generating Financial Report PDF...", Severity.Info);
            await ReportService.DownloadFinancialsPdf();
            Snackbar.Add("Download started.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnTabChanged(int index) { }
}