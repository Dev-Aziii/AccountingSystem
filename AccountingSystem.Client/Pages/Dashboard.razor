                    }
                    else
                    {
                        <div style="text-align: center; padding: 2rem; color: #9ca3af;">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                            <div style="margin-top: 0.5rem;">Loading inflation data...</div>
