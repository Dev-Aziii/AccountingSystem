@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService
@inject WorldBankService WorldBankService
@inject FrankfurterService FrankfurterService

<PageTitle>Financial Dashboard</PageTitle>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">

    <!-- COMPACT HEADER -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            @if (isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="28px" Class="mb-1" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="16px" />
            }
            else
            {
                <MudText Typo="Typo.h5" Style="font-weight: 800; color: rgb(22, 84, 127);">
                    Financial Dashboard
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgb(56, 146, 147);">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </MudText>
            }
        </div>
        @if (!isLoading)
        {
            <MudButton Variant="Variant.Filled" Class="refresh-btn" StartIcon="@Icons.Material.Outlined.Refresh"
                Size="Size.Medium" OnClick="LoadData">
                Refresh
            </MudButton>
        }
    </div>

    @if (isLoading)
    {        
        <!-- SKELETON FOR MAIN GRID -->
        <div class="dashboard-grid">
            <!-- Card A Skeleton - Financial Summary (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <div style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div class="u-flex-1">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                        <div class="u-flex-1">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-3" />
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
                        @for (int i = 0; i < 4; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card B Skeleton - Active Transactions (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" Class="mb-3" />
                    <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                    <div style="display: flex; gap: 0.75rem; margin-top: auto;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                </MudPaper>
            </div>

            <!-- Card C Skeleton - USD to PHP (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card forex-featured" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="12px" Class="mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="140px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="45px" Class="mb-2" />
                    }
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="10px" style="margin-top: auto;" />
                </MudPaper>
            </div>

            <!-- Card D Skeleton - Philippines Economic Health (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    <div style="text-align: center; margin-bottom: 1.5rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-1" style="margin: 0 auto;" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" style="margin: 0 auto;" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="16px" Class="mb-2" />
                    }
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                </MudPaper>
            </div>

            <!-- Card E Skeleton - Inflation History (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                    }
                    <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card F Skeleton - Account Ledger (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="220px" Height="20px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="36px" />
                    </div>
                    @for (int i = 0; i < 10; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="40px" Class="mb-2" />
                    }
                </MudPaper>
            </div>

            <!-- Calendar Skeleton (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" Height="20px" Class="mb-3" />
                    <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="400px" />
                </MudPaper>
            </div>
        </div>
    }
    else
    {      

        <!-- MAIN CONTENT GRID -->
        <div class="dashboard-grid">

            <!-- CARD A: Financial Summary (span-6) -->
            <div class="span-6">
                <div class="featured-card">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div>
                            <span
                                style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(22, 84, 127); opacity: 0.7;">Financial
                                Summary</span>
                            <div
                                style="font-size: 0.85rem; color: rgb(56, 146, 147); font-weight: 500; margin-top: 0.25rem;">
                                Year-to-Date Overview</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Size="Size.Small"
                            Style="color: rgb(56, 146, 147);" />
                    </div>

                    <!-- Revenue & Expenses Bars -->
                    <div style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div class="u-flex-1">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="font-size: 0.8rem; color: #374151; font-weight: 500;">Revenue</span>
                                <span
                                    style="font-size: 0.9rem; font-weight: 700; color: #4CAF50;">₱@FormatCompact(TotalRevenue)</span>
                            </div>
                            <div style="height: 12px; background: #e5e7eb; border-radius: 6px; overflow: hidden;">
                                <div
                                    style="height: 100%; width: @(TotalRevenue > 0 && TotalRevenue >= TotalExpenses ? 100 : (TotalExpenses > 0 ? (double)TotalRevenue / (double)TotalExpenses * 100 : 0))%; background: linear-gradient(90deg, #4CAF50 0%, #81C784 100%); border-radius: 6px;">
                                </div>
                            </div>
                        </div>
                        <div class="u-flex-1">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="font-size: 0.8rem; color: #374151; font-weight: 500;">Expenses</span>
                                <span
                                    style="font-size: 0.9rem; font-weight: 700; color: #F44336;">₱@FormatCompact(TotalExpenses)</span>
                            </div>
                            <div style="height: 12px; background: #e5e7eb; border-radius: 6px; overflow: hidden;">
                                <div
                                    style="height: 100%; width: @(TotalExpenses > 0 && TotalExpenses >= TotalRevenue ? 100 : (TotalRevenue > 0 ? (double)TotalExpenses / (double)TotalRevenue * 100 : 0))%; background: linear-gradient(90deg, #F44336 0%, #E57373 100%); border-radius: 6px;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Profit Section -->
                    <div
                        style="background: linear-gradient(135deg, @(NetProfit >= 0 ? "rgba(76, 175, 80, 0.1)" : "rgba(244, 67, 54, 0.1)") 0%, @(NetProfit >= 0 ? "rgba(129, 199, 132, 0.05)" : "rgba(229, 115, 115, 0.05)") 100%); border-radius: 16px; padding: 1.25rem; margin-bottom: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div
                                    style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: @(NetProfit >= 0 ? "#4CAF50" : "#F44336"); opacity: 0.8; margin-bottom: 0.25rem;">
                                    Net Profit</div>
                                <div
                                    style="font-size: 2rem; font-weight: 800; color: @(NetProfit >= 0 ? "#4CAF50" : "#F44336");">
                                    ₱@FormatCompact(NetProfit)</div>
                            </div>
                            <div
                                style="width: 60px; height: 60px; border-radius: 50%; background: @(NetProfit >= 0 ? "linear-gradient(135deg, #4CAF50 0%, #81C784 100%)" : "linear-gradient(135deg, #F44336 0%, #E57373 100%)"); display: flex; align-items: center; justify-content: center;">
                                <MudIcon
                                    Icon="@(NetProfit >= 0 ? Icons.Material.Outlined.TrendingUp : Icons.Material.Outlined.TrendingDown)"
                                    Size="Size.Large" Style="color: white;" />
                            </div>
                        </div>
                    </div>

                    <!-- Quick Stats Row -->
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
                        <div
                            style="text-align: center; padding: 0.75rem; background: rgba(22, 84, 127, 0.05); border-radius: 10px;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: rgb(22, 84, 127);">₱@FormatCompact(CashBalance)
                            </div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #6b7280;">Cash</div>
                        </div>
                        <div
                            style="text-align: center; padding: 0.75rem; background: rgba(56, 146, 147, 0.05); border-radius: 10px;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: rgb(56, 146, 147);">₱@FormatCompact(TotalAssets)
                            </div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #6b7280;">Assets</div>
                        </div>
                        <div
                            style="text-align: center; padding: 0.75rem; background: rgba(96, 125, 139, 0.05); border-radius: 10px;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: rgb(96, 125, 139);">₱@FormatCompact(TotalLiabilities)
                            </div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #6b7280;">Liabilities</div>
                        </div>
                        <div
                            style="text-align: center; padding: 0.75rem; background: rgba(156, 39, 176, 0.05); border-radius: 10px;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: rgb(156, 39, 176);">
                                @ProfitMarginPercent.ToString("F1")%</div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #6b7280;">Margin</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD B: Active Transactions (span-3) -->
            <div class="span-3">
                <div class="featured-card">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                        <span
                            style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(22, 84, 127); opacity: 0.7;">Active
                            Transactions</span>
                        <MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" Size="Size.Small"
                            Style="color: rgb(56, 146, 147);" />
                    </div>
                    <div class="featured-value-large">@ActiveTransactions</div>
                    <div style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem;">Pending payments & collections
                    </div>

                    <!-- Split Stats -->
                    <div style="display: flex; gap: 1rem; margin: 1rem 0;">
                        <div
                            style="flex: 1; background: rgba(244, 67, 54, 0.1); border-radius: 10px; padding: 0.75rem; text-align: center;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: #F44336;">@BillsToPay</div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #F44336;">To Pay</div>
                        </div>
                        <div
                            style="flex: 1; background: rgba(76, 175, 80, 0.1); border-radius: 10px; padding: 0.75rem; text-align: center;">
                            <div style="font-size: 1.25rem; font-weight: 700; color: #4CAF50;">@InvoicesToCollect</div>
                            <div style="font-size: 0.65rem; text-transform: uppercase; color: #4CAF50;">To Collect</div>
                        </div>
                    </div>

                    <!-- Receivable & Payable Amounts -->
                    <div
                        style="display: flex; gap: 0.75rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid rgba(22, 84, 127, 0.1);">
                        <div
                            style="flex: 1; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; background: rgba(255, 193, 7, 0.08); border-radius: 8px; border-left: 3px solid #FFC107;">
                            <MudIcon Icon="@Icons.Material.Outlined.RequestQuote" Size="Size.Small" Style="color: #FF9800;" />
                            <div>
                                <div style="font-size: 0.95rem; font-weight: 700; color: #FF9800;">
                                    ₱@FormatCompact(ArOutstanding)</div>
                                <div style="font-size: 0.6rem; text-transform: uppercase; color: #FF9800; opacity: 0.8;">
                                    Receivable</div>
                            </div>
                        </div>
                        <div
                            style="flex: 1; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; background: rgba(255, 87, 34, 0.08); border-radius: 8px; border-left: 3px solid #FF5722;">
                            <MudIcon Icon="@Icons.Material.Outlined.Payment" Size="Size.Small" Style="color: #FF5722;" />
                            <div>
                                <div style="font-size: 0.95rem; font-weight: 700; color: #FF5722;">
                                    ₱@FormatCompact(ApOutstanding)</div>
                                <div style="font-size: 0.6rem; text-transform: uppercase; color: #FF5722; opacity: 0.8;">
                                    Payable</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD C: USD to PHP Exchange Rate (span-3) - INTERACTIVE COMPACT -->
            <div class="span-3">
                <div class="featured-card forex-featured">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                        <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(33, 150, 243); opacity: 0.8;">USD to PHP</span>
                        <MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" Size="Size.Small" Style="color: rgb(33, 150, 243);" />
                    </div>
                    <div style="font-size: 0.85rem; color: rgb(33, 150, 243); font-weight: 500; margin-bottom: 1rem;">Live Currency Converter</div>

                    @if (usdToPhpRate > 0)
                    {
                        <!-- Exchange Rate Display -->
                        <div style="background: linear-gradient(135deg, rgba(33, 150, 243, 0.15) 0%, rgba(33, 150, 243, 0.05) 100%); border-radius: 16px; padding: 1rem; margin-bottom: 1rem; border: 2px solid rgba(33, 150, 243, 0.3); text-align: center;">
                            <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #1976D2 0%, #2196F3 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem; font-weight: 800;">$</div>
                                <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" Style="color: #2196F3;" />
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #FFC107 0%, #FFD54F 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem; font-weight: 800;">₱</div>
                            </div>
                            <div class="usd-php-pulse" style="font-size: 1.75rem; font-weight: 800; color: #1976D2; line-height: 1;">@usdToPhpRate.ToString("F2")</div>
                            <div style="font-size: 0.65rem; color: #6b7280; margin-top: 0.25rem;">PHP per 1 USD</div>
                        </div>

                        <!-- Compact Converter - Input and Result on Same Line -->
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                            <!-- USD Input -->
                            <div class="u-flex-1">
                                <div style="display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.25rem;">
                                    <div style="width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(135deg, #1976D2 0%, #2196F3 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 800;">$</div>
                                    <span style="font-size: 0.7rem; color: #374151; font-weight: 600;">USD</span>
                                </div>
                                <MudNumericField @bind-Value="usdInputAmount" 
                                               Min="0" 
                                               Step="1M"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               HideSpinButtons="true"
                                               Style="background: white;" />
                            </div>

                            <!-- Arrow -->
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Style="color: #2196F3; margin-top: 1.25rem;" Size="Size.Small" />

                            <!-- PHP Result -->
                            <div class="u-flex-1">
                                <div style="display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.25rem;">
                                    <div style="width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(135deg, #FFC107 0%, #FFD54F 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 800;">₱</div>
                                    <span style="font-size: 0.7rem; color: #374151; font-weight: 600;">PHP</span>
                                </div>
                                <div style="background: linear-gradient(135deg, rgba(33, 150, 243, 0.1) 0%, rgba(33, 150, 243, 0.05) 100%); border: 1px solid rgba(33, 150, 243, 0.2); border-radius: 4px; padding: 0.5rem; text-align: center;">
                                    <div style="font-size: 1.1rem; font-weight: 700; color: #1976D2;">@((usdInputAmount * usdToPhpRate).ToString("N2"))</div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Conversion Buttons -->
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.75rem;">
                            @foreach (var amount in new[] { 100, 500, 1000 })
                            {
                                <MudButton Variant="Variant.Outlined" 
                                         Size="Size.Small"
                                         OnClick="@(() => usdInputAmount = amount)"
                                         Style="border-color: rgba(33, 150, 243, 0.3); color: #1976D2; font-weight: 600; font-size: 0.7rem;">
                                    $@amount
                                </MudButton>
                            }
                        </div>

                        <!-- Last Updated Footer -->
                        <div style="padding-top: 0.5rem; border-top: 1px solid rgba(33, 150, 243, 0.1); text-align: center;">
                            <div style="font-size: 0.65rem; color: #6b7280; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">
                                <MudIcon Icon="@Icons.Material.Outlined.Update" Size="Size.Small" Style="color: #6b7280; font-size: 0.9rem;" />
                                Live Rate • @DateTime.Now.ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 2rem; color: #9ca3af;">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                            <div style="margin-top: 0.5rem; font-size: 0.9rem;">Loading forex data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD D: Philippines Economic Health (span-6) -->
            <div class="span-6">
                <div class="featured-card worldbank-featured">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div>
                            <span
