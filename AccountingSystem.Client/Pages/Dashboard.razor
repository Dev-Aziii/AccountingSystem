@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ReportService ReportService

<PageTitle>Financial Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Financial Overview</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
            Refresh Data
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 200px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (trialBalance != null)
    {
        <!-- KPI Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="border-left: 6px solid var(--mud-palette-success);">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary text-uppercase">Total Debits</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Success">@trialBalance.TotalDebit.ToString("C0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="border-left: 6px solid var(--mud-palette-info);">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary text-uppercase">Total Credits</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Info">@trialBalance.TotalCredit.ToString("C0")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Recent Activity Table (Trial Balance Preview) -->
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-2">
                <div>
                    <MudText Typo="Typo.h6">Current Trial Balance</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">As of @trialBalance.GeneratedAt.ToLocalTime()</MudText>
                </div>
                @if (trialBalance.Accounts.Count > 10)
                {
                    <MudLink Href="reports/financials" Underline="Underline.None" Color="Color.Primary">View Full Report</MudLink>
                }
            </div>

            <MudTable Items="@trialBalance.Accounts.Take(10)" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Account Name</MudTh>
                    <MudTh Style="text-align:right">Debit</MudTh>
                    <MudTh Style="text-align:right">Credit</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code"><b>@context.AccountCode</b></MudTd>
                    <MudTd DataLabel="Account Name">@context.AccountName</MudTd>
                    <MudTd DataLabel="Debit" Style="text-align:right">
                        <MudText Color="@(context.Debit > 0 ? Color.Success : Color.Default)">
                            @(context.Debit > 0 ? context.Debit.ToString("N2") : "-")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Credit" Style="text-align:right">
                        <MudText Color="@(context.Credit > 0 ? Color.Info : Color.Default)">
                            @(context.Credit > 0 ? context.Credit.ToString("N2") : "-")
                        </MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private TrialBalanceDTO? trialBalance;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            trialBalance = await ReportService.GetTrialBalance();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}