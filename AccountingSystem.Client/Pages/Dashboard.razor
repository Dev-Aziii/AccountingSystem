                                    @(inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
                            </div>
                            <div
                                style="flex: 1; text-align: center; padding: 0.5rem; background: rgba(156, 39, 176, 0.08); border-radius: 8px;">
                                <div
                                    style="font-size: 0.65rem; text-transform: uppercase; color: rgb(103, 58, 183); opacity: 0.8;">
                                    5-Year Avg</div>
                                <div style="font-size: 1rem; font-weight: 700; color: rgb(156, 39, 176);">
                                    @(inflationData.Take(5).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
