@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService

<PageTitle>Financial Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">

    <!-- HEADER -->
    <MudPaper Class="dashboard-header pa-6 mb-8" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                <MudText Typo="Typo.h5" Class="mb-2 header-title">
                    Executive Financial Dashboard
                </MudText>
                <MudText Typo="Typo.body1" Class="header-subtitle">
                    Real-time insights into liquidity, profitability, and financial obligations
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       Class="refresh-btn"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Size="Size.Large"
                       OnClick="LoadData">
                Refresh Data
            </MudButton>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <div class="loading-container d-flex justify-center align-center pa-8" style="height: 300px;">
            <div class="text-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate />
                <MudText Typo="Typo.h6" Class="mt-4 custom-text-primary">Loading Dashboard...</MudText>
            </div>
        </div>
    }
    else
    {
        <!-- KPI SECTION -->
        <div class="section-title">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" />
            Key Performance Indicators
        </div>

        <MudGrid Spacing="3" Class="mb-10">

            <!-- ROW 1 -->
            <!-- CASH -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Cash & Bank Balance</MudText>
                            <MudText Class="kpi-value peso">@CashBalance.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Immediately available funds</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(76, 175, 80, 0.1); color: #4CAF50; font-weight: 600;">
                                Liquid Assets
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- NET PROFIT -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Net Profit (YTD)</MudText>
                            <MudText Class="kpi-value peso">@NetProfit.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Revenue minus expenses</MudText>
                            <MudChip T="string" Class="mt-3" 
                                     Style="@($"background: {(NetProfit >= 0 ? "rgba(76, 175, 80, 0.1)" : "rgba(244, 67, 54, 0.1)")}; color: {(NetProfit >= 0 ? "#4CAF50" : "#F44336")}; font-weight: 600;")">
                                @(NetProfit >= 0 ? "Profitable" : "Loss")
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- TOTAL ASSETS -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Total Assets</MudText>
                            <MudText Class="kpi-value peso">@TotalAssets.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Company resources</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(33, 150, 243, 0.1); color: #2196F3; font-weight: 600;">
                                Total Value
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- ROW 2 -->
            <!-- ACCOUNTS RECEIVABLE -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Accounts Receivable</MudText>
                            <MudText Class="kpi-value peso">@ArOutstanding.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Customer outstanding</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(255, 193, 7, 0.1); color: #FFC107; font-weight: 600;">
                                To Collect
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- ACCOUNTS PAYABLE -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Accounts Payable</MudText>
                            <MudText Class="kpi-value peso">@ApOutstanding.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Vendor obligations</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(255, 87, 34, 0.1); color: #FF5722; font-weight: 600;">
                                To Pay
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- TOTAL LIABILITIES -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Total Liabilities</MudText>
                            <MudText Class="kpi-value peso">@TotalLiabilities.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Total obligations</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(96, 125, 139, 0.1); color: #607D8B; font-weight: 600;">
                                Obligations
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <!-- LOWER SECTION -->
        <MudGrid Spacing="6">

            <!-- CALENDAR -->
            <MudItem xs="12" lg="8">
                <div class="calendar-section pa-6">
                    <div class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" />
                        Payment & Collection Schedule
                    </div>

                    <div class="d-flex gap-4 mb-6">
                        <div class="legend-item">
                            <MudIcon Icon="@Icons.Material.Filled.CircleNotifications"
                                     Style="color: #4CAF50;" Size="Size.Small" />
                            <span>Invoices Due</span>
                        </div>
                        <div class="legend-item">
                            <MudIcon Icon="@Icons.Material.Filled.CircleNotifications"
                                     Style="color: #F44336;" Size="Size.Small" />
                            <span>Bills Due</span>
                        </div>
                    </div>

                    <MudCalendar Items="_events"
                                 MonthCellMinHeight="80"
                                 Elevation="0"
                                 Outlined="false"
                                 Style="border-radius: 16px; overflow: hidden;" />
                </div>
            </MudItem>

            <!-- LEDGER SNAPSHOT -->
            <MudItem xs="12" lg="4">
                <div class="ledger-section pa-6">
                    <div class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" />
                        Ledger Snapshot
                    </div>

                    <MudTable Items="@(trialBalance?.Accounts.Take(8))"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Class="custom-table"
                              Style="border-radius: 12px; overflow: hidden;">

                        <HeaderContent>
                            <MudTh Style="font-size: 0.9rem;">Account Details</MudTh>
                            <MudTh align="Align.Right" Style="font-size: 0.9rem;">Balance (₱)</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd Style="padding: 16px 12px;">
                                <div>
                                    <MudText Typo="Typo.body2" Class="custom-text-primary" Style="font-weight: 600;">
                                        @context.AccountName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="custom-text-secondary" Style="font-weight: 500;">
                                        @context.AccountCode
                                    </MudText>
                                </div>
                            </MudTd>
                            <MudTd align="Align.Right" Style="padding: 16px 12px;">
                                <MudText Style="font-weight: 700; font-size: 1rem;" Class="custom-text-primary">
                                    @((context.Debit - context.Credit).ToString("N0"))
                                </MudText>
                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                    <div class="text-center mt-6">
                        <MudButton Variant="Variant.Filled"
                                   Class="custom-button"
                                   Href="reports/financials"
                                   StartIcon="@Icons.Material.Filled.Assessment"
                                   Size="Size.Large"
                                   Style="color: white !important;">
                            View Financial Reports
                        </MudButton>
                    </div>
                </div>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes = new();
    private List<CalendarItem> _events = new();
    private bool isLoading = false;

    // --- KPI Properties ---
    private decimal CashBalance;
    private decimal NetProfit;
    private decimal ArOutstanding;
    private decimal ApOutstanding;
    private decimal TotalAssets;
    private decimal TotalLiabilities;

    // --- Dynamic Styling Helpers ---
    private string NetProfitBorderColor =>
        NetProfit >= 0
            ? "var(--theme-primary)"
            : "var(--mud-palette-error)";

    private string NetProfitTextColor =>
        NetProfit >= 0
            ? "var(--mud-palette-success)"
            : "var(--mud-palette-error)";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var acctsTask = LedgerService.GetAccountsAsync();
            var billsTask = PayableService.GetBillsAsync();
            var invoicesTask = ReceivableService.GetInvoicesAsync();

            await Task.WhenAll(tbTask, acctsTask, billsTask, invoicesTask);

            trialBalance = tbTask.Result;
            var accountsList = acctsTask.Result;
            accountTypes = accountsList.ToDictionary(a => a.Code, a => a.Type);

            CalculateKPIs(trialBalance!.Accounts);

            _events.Clear();

            foreach (var bill in billsTask.Result.Where(b => b.Balance > 0))
            {
                _events.Add(new CalendarItem
                {
                    Start = bill.DueDate,
                    Text = $"PAY: {bill.VendorName} (₱{bill.Balance:N0})"
                });
            }

            foreach (var inv in invoicesTask.Result.Where(i => i.Balance > 0))
            {
                _events.Add(new CalendarItem
                {
                    Start = inv.DueDate,
                    Text = $"COLLECT: {inv.CustomerName} (₱{inv.Balance:N0})"
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateKPIs(List<AccountBalanceDTO> balances)
    {
        decimal GetBalance(AccountBalanceDTO a)
        {
            if (!accountTypes.ContainsKey(a.AccountCode)) return 0;
            var type = accountTypes[a.AccountCode];
            return (type == "Asset" || type == "Expense")
                ? a.Debit - a.Credit
                : a.Credit - a.Debit;
        }

        CashBalance = balances
            .Where(a => a.AccountCode == "1000" || a.AccountCode == "1010" || a.AccountCode == "1020")
            .Sum(a => a.Debit - a.Credit);

        var arAcct = balances.FirstOrDefault(a => a.AccountCode == "1100");
        ArOutstanding = arAcct != null ? arAcct.Debit - arAcct.Credit : 0;

        var apAcct = balances.FirstOrDefault(a => a.AccountCode == "2000");
        ApOutstanding = apAcct != null ? apAcct.Credit - apAcct.Debit : 0;

        TotalAssets = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Asset")
            .Sum(a => a.Debit - a.Credit);

        TotalLiabilities = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Liability")
            .Sum(a => a.Credit - a.Debit);

        var revenue = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Revenue")
            .Sum(a => a.Credit - a.Debit);

        var expense = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Expense")
            .Sum(a => a.Debit - a.Credit);

        NetProfit = revenue - expense;
    }
}