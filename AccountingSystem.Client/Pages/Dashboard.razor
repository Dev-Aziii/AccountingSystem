@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService
@inject WorldBankService WorldBankService
@inject FrankfurterService FrankfurterService

<PageTitle>Financial Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">

    <!-- COMPACT HEADER -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            @if (isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="28px" Class="mb-1" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="16px" />
            }
            else
            {
                <MudText Typo="Typo.h5">
                    Financial Dashboard
                </MudText>
                <MudText Typo="Typo.body2">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </MudText>
            }
        </div>
        @if (!isLoading)
        {
            <MudButton Variant="Variant.Filled" Class="refresh-btn" StartIcon="@Icons.Material.Outlined.Refresh"
                Size="Size.Medium" OnClick="LoadData">
                Refresh
            </MudButton>
        }
    </div>

    @if (isLoading)
    {        
        <!-- SKELETON FOR MAIN GRID -->
        <div class="dashboard-grid">
            <!-- Card A Skeleton - Financial Summary (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card" Elevation="0">
                    <div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-3" />
                    <div>
                        @for (int i = 0; i < 4; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card B Skeleton - Active Transactions (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card" Elevation="0">
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" Class="mb-3" />
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                </MudPaper>
            </div>

            <!-- Card C Skeleton - USD to PHP (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card forex-featured" Elevation="0">
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="12px" Class="mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="140px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="45px" Class="mb-2" />
                    }
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="10px" />
                </MudPaper>
            </div>

            <!-- Card D Skeleton - Philippines Economic Health (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-1" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="16px" Class="mb-2" />
                    }
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                </MudPaper>
            </div>

            <!-- Card E Skeleton - Inflation History (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div>
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                    }
                    <div>
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card F Skeleton - Account Ledger (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="220px" Height="20px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="36px" />
                    </div>
                    @for (int i = 0; i < 10; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="40px" Class="mb-2" />
                    }
                </MudPaper>
            </div>

            <!-- Calendar Skeleton (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" Height="20px" Class="mb-3" />
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="400px" />
                </MudPaper>
            </div>
        </div>
    }
    else
    {      

        <!-- MAIN CONTENT GRID -->
        <div class="dashboard-grid">

            <!-- CARD A: Financial Summary (span-6) -->
            <div class="span-6">
                <div class="featured-card">
                    <div>
                        <div>
                            <span>Financial
                                Summary</span>
                            <div>
                                Year-to-Date Overview</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Size="Size.Small" />
                    </div>

                    <!-- Revenue & Expenses Bars -->
                    <div>
                        <div>
                            <div>
                                <span>Revenue</span>
                                <span>₱@FormatCompact(TotalRevenue)</span>
                            </div>
                            <div>
                                <div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div>
                                <span>Expenses</span>
                                <span>₱@FormatCompact(TotalExpenses)</span>
                            </div>
                            <div>
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Profit Section -->
                    <div class="card-container">
                        <div>
                            <div>
                                <div class="kpi-label">
                                    Net Profit</div>
                                <div class="kpi-value">
                                    ₱@FormatCompact(NetProfit)</div>
                            </div>
                            <div>
                                <MudIcon
                                    Icon="@(NetProfit >= 0 ? Icons.Material.Outlined.TrendingUp : Icons.Material.Outlined.TrendingDown)"
                                    Size="Size.Large" />
                            </div>
                        </div>
                    </div>

                    <!-- Quick Stats Row -->
                    <div>
                        <div>
                            <div>₱@FormatCompact(CashBalance)
                            </div>
                            <div>Cash</div>
                        </div>
                        <div>
                            <div>₱@FormatCompact(TotalAssets)
                            </div>
                            <div>Assets</div>
                        </div>
                        <div>
                            <div>₱@FormatCompact(TotalLiabilities)
                            </div>
                            <div>Liabilities</div>
                        </div>
                        <div>
                            <div>
                                @ProfitMarginPercent.ToString("F1")%</div>
                            <div>Margin</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD B: Active Transactions (span-3) -->
            <div class="span-3">
                <div class="featured-card">
                    <div>
                        <span>Active
                            Transactions</span>
                        <MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" Size="Size.Small" />
                    </div>
                    <div class="featured-value-large">@ActiveTransactions</div>
                    <div>Pending payments & collections
                    </div>

                    <!-- Split Stats -->
                    <div>
                        <div>
                            <div>@BillsToPay</div>
                            <div>To Pay</div>
                        </div>
                        <div>
                            <div>@InvoicesToCollect</div>
                            <div>To Collect</div>
                        </div>
                    </div>

                    <!-- Receivable & Payable Amounts -->
                    <div>
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.RequestQuote" Size="Size.Small" />
                            <div>
                                <div>
                                    ₱@FormatCompact(ArOutstanding)</div>
                                <div>
                                    Receivable</div>
                            </div>
                        </div>
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.Payment" Size="Size.Small" />
                            <div>
                                <div>
                                    ₱@FormatCompact(ApOutstanding)</div>
                                <div>
                                    Payable</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD C: USD to PHP Exchange Rate (span-3) - INTERACTIVE COMPACT -->
            <div class="span-3">
                <div class="featured-card forex-featured">
                    <div>
                        <span>USD to PHP</span>
                        <MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" Size="Size.Small" />
                    </div>
                    <div>Live Currency Converter</div>

                    @if (usdToPhpRate > 0)
                    {
                        <!-- Exchange Rate Display -->
                        <div>
                            <div>
                                <div>$</div>
                                <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
                                <div>₱</div>
                            </div>
                            <div class="usd-php-pulse">@usdToPhpRate.ToString("F2")</div>
                            <div>PHP per 1 USD</div>
                        </div>

                        <!-- Compact Converter - Input and Result on Same Line -->
                        <div>
                            <!-- USD Input -->
                            <div>
                                <div>
                                    <div>$</div>
                                    <span>USD</span>
                                </div>
                                <MudNumericField @bind-Value="usdInputAmount" 
                                               Min="0" 
                                               Step="1M"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               HideSpinButtons="true" />
                            </div>

                            <!-- Arrow -->
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />

                            <!-- PHP Result -->
                            <div>
                                <div>
                                    <div>₱</div>
                                    <span>PHP</span>
                                </div>
                                <div>
                                    <div>@((usdInputAmount * usdToPhpRate).ToString("N2"))</div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Conversion Buttons -->
                        <div>
                            @foreach (var amount in new[] { 100, 500, 1000 })
                            {
                                <MudButton Variant="Variant.Outlined" 
                                         Size="Size.Small"
                                         OnClick="@(() => usdInputAmount = amount)">
                                    $@amount
                                </MudButton>
                            }
                        </div>

                        <!-- Last Updated Footer -->
                        <div>
                            <div>
                                <MudIcon Icon="@Icons.Material.Outlined.Update" Size="Size.Small" />
                                Live Rate • @DateTime.Now.ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                            <div>Loading forex data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD D: Philippines Economic Health (span-6) -->
            <div class="span-6">
                <div class="featured-card worldbank-featured">
                    <div>
                        <div>
                            <span>Philippines
                                Economic Health</span>
                            <div>
                                World Bank Inflation Data</div>
                        </div>
                        <MudChip T="string" Size="Size.Small">
                            Live Data
                        </MudChip>
                    </div>

                    @if (inflationData.Any())
                    {
                        <!-- Current Inflation KPI -->
                        <div>
                            <div class="inflation-kpi-value">@CurrentInflationValue.ToString("F1")%</div>
                            <div class="inflation-kpi-label">Current Inflation (@inflationData.First().Date)</div>
                        </div>

                        <!-- Line Chart -->
                        <MudChart ChartType="ChartType.Line" 
                                  ChartSeries="@inflationChartSeries" 
                                  XAxisLabels="@inflationYears"
                                  Width="100%" 
                                  Height="200px"
                                  ChartOptions="@inflationChartOptions">
                        </MudChart>

                        <!-- Legend at bottom -->
                        <div>
                            <div>
                                <div>
                                    <div>
                                    </div>
                                    <span>Current Rate
                                        (@inflationData.First().Date)</span>
                                    <span>@(inflationData.First().Value?.ToString("F2")
                                                                        ?? "N/A")%</span>
                                </div>
                                @if (inflationData.Count >= 2)
                                {
                                    var yoyChange = (inflationData[0].Value ?? 0) - (inflationData[1].Value ?? 0);
                                    <div>
                                        <div>
                                        </div>
                                        <span>YoY Change</span>
                                        <span>@(yoyChange
                                                                            >= 0 ? "+" : "")@yoyChange.ToString("F2")%</span>
                                    </div>
                                }
                                @{
                                    var avg3yr = inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value) ?? 0;
                                }
                                <div>
                                    <div></div>
                                    <span>3-Year Average</span>
                                    <span>@avg3yr.ToString("F2")%</span>
                                </div>
                            </div>
                            <div>
                                <span>Status:
                                    @GetInflationStatus(inflationData.First().Value)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                            <div>Loading inflation data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD E: World Bank Inflation History (span-6) -->
            <div class="span-6">
                <div class="featured-card worldbank-featured">
                    <div>
                        <div>
                            <span>Inflation
                                History</span>
                            <div>
                                Philippines Historical Data</div>
                        </div>
                        <MudChip T="string" Size="Size.Small">
                            World Bank
                        </MudChip>
                    </div>

                    @if (inflationData.Any())
                    {
                        <!-- Inflation Data Table -->
                        <div>
                            @foreach (var data in inflationData.Take(8))
                            {
                                var prevVal = GetPreviousInflationValue(data.Date);
                                var isUp = prevVal.HasValue && data.Value > prevVal;
                                var changeAmount = prevVal.HasValue ? data.Value - prevVal : null;
                                <div>
                                    <div>
                                        <span>@data.Date</span>
                                        @if (prevVal.HasValue)
                                        {
                                            <MudIcon
                                                Icon="@(isUp ? Icons.Material.Outlined.ArrowUpward : Icons.Material.Outlined.ArrowDownward)"
                                                Size="Size.Small" />
                                        }
                                    </div>
                                    <div>
                                        @if (changeAmount.HasValue)
                                        {
                                            <span>@(changeAmount
                                                                                >= 0 ? "+" : "")@changeAmount.Value.ToString("F2")%</span>
                                        }
                                        <span>@(data.Value?.ToString("F2")
                                                                            ?? "N/A")%</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Summary Footer -->
                        <div>
                            <div>
                                <div>
                                    3-Year Avg</div>
                                <div>
                                    @(inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
                            </div>
                            <div>
                                <div>
                                    5-Year Avg</div>
                                <div>
                                    @(inflationData.Take(5).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
                            </div>
                            
                        </div>
                    }
                    else
                    {
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                            <div>Loading inflation data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD F: Account Ledger Snapshot (span-12)
            <div class="span-12">
                <div class="featured-card">
                    <div>
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.ListAlt" Size="Size.Medium" />
                            <span>Account Ledger Snapshot</span>
                        </div>
                        <MudButton Variant="Variant.Filled" Href="reports/financials"
                            StartIcon="@Icons.Material.Outlined.Assessment" Size="Size.Small">
                            View Financial Reports
                        </MudButton>
                    </div>

                    <MudTable Items="@(trialBalance?.Accounts.Take(10))" Dense="true" Hover="true" Elevation="0">

                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Account Name</MudTh>
                            <MudTh align="Align.Right">Debit (₱)</MudTh>
                            <MudTh align="Align.Right">Credit (₱)</MudTh>
                            <MudTh align="Align.Right">Balance (₱)</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small">
                                    @context.AccountCode
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">
                                    @context.AccountName
                                </MudText>
                            </MudTd>
                            <MudTd align="Align.Right">
                                <MudText>
                                    @(context.Debit > 0 ? context.Debit.ToString("N0") : "-")
                                </MudText>
                            </MudTd>
                            <MudTd align="Align.Right">
                                <MudText>
                                    @(context.Credit > 0 ? context.Credit.ToString("N0") : "-")
                                </MudText>
                            </MudTd>
                            <MudTd align="Align.Right">
                                <MudText>
                                    @((context.Debit - context.Credit).ToString("N0"))
                                </MudText>
                            </MudTd>
                        </RowTemplate>

                    </MudTable>
                </div>
            </div>
             -->

            <!-- CALENDAR SECTION (span-12)
            <div class="span-12">
                <div class="featured-card">
                    <div>
                        <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Medium" />
                        <span>Payment & Collection Schedule</span>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.Circle" Size="Size.Small" />
                            <span>Invoices Due</span>
                        </div>
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.Circle" Size="Size.Small" />
                            <span>Bills Due</span>
                        </div>
                    </div>

                    <MudCalendar Items="_events" MonthCellMinHeight="80" Elevation="0" Outlined="false" />
                </div>
            </div>
             -->
            
        </div>
    }

</MudContainer>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes = new();
    private List<CalendarItem> _events = new();
    private bool isLoading = false;
    private List<WorldBankDataPoint> inflationData = new();
    private decimal usdToPhpRate = 0;
    private decimal usdInputAmount = 100; // Default conversion amount

    // Chart data for MudBlazor
    private List<ChartSeries> inflationChartSeries = new();
    private string[] inflationYears = Array.Empty<string>();
    private ChartOptions inflationChartOptions = new();

    // --- KPI Properties ---
    private decimal CashBalance;
    private decimal NetProfit;
    private decimal ArOutstanding;
    private decimal ApOutstanding;
    private decimal TotalAssets;
    private decimal TotalLiabilities;
    private decimal TotalRevenue;
    private decimal TotalExpenses;

    // --- Calculated Properties ---
    private int ActiveTransactions => BillsToPay + InvoicesToCollect;
    private int BillsToPay;
    private int InvoicesToCollect;
    private int ActiveAccounts => trialBalance?.Accounts.Count ?? 0;
    private decimal CurrentInflationValue => inflationData.FirstOrDefault()?.Value ?? 0;
    private decimal ProfitMarginPercent => TotalRevenue > 0 ? (NetProfit / TotalRevenue * 100) : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var acctsTask = LedgerService.GetAccountsAsync();
            var billsTask = PayableService.GetBillsAsync();
            var invoicesTask = ReceivableService.GetInvoicesAsync();
            var worldBankTask = WorldBankService.GetInflationDataAsync();
            var forexTask = FrankfurterService.GetUsdToPhpRateAsync();

            await Task.WhenAll(tbTask, acctsTask, billsTask, invoicesTask, worldBankTask, forexTask);

            trialBalance = tbTask.Result;
            var accountsList = acctsTask.Result;

            accountTypes = accountsList?.ToDictionary(a => a.Code, a => a.Type) ?? new Dictionary<string, string>();
            inflationData = worldBankTask.Result.Where(x => x.Value.HasValue).OrderByDescending(x => x.Date).ToList();
            usdToPhpRate = forexTask.Result;

            // Prepare chart data
            PrepareInflationChartData();

            var bills = (billsTask.Result ?? new List<BillDTO>()).Where(b => b.Balance > 0).ToList();
            var invoices = (invoicesTask.Result ?? new List<InvoiceDTO>()).Where(i => i.Balance > 0).ToList();

            BillsToPay = bills.Count;
            InvoicesToCollect = invoices.Count;

            if (trialBalance != null)
            {
                CalculateKPIs(trialBalance.Accounts);
            }

            _events.Clear();

            foreach (var bill in bills)
            {
                _events.Add(new CalendarItem
                    {
                        Start = bill.DueDate,
                        Text = $"PAY: {bill.VendorName} (₱{bill.Balance:N0})"
                    });
            }

            foreach (var inv in invoices)
            {
                _events.Add(new CalendarItem
                    {
                        Start = inv.DueDate,
                        Text = $"COLLECT: {inv.CustomerName} (₱{inv.Balance:N0})"
                    });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrepareInflationChartData()
    {
        if (!inflationData.Any()) return;

        var chartData = inflationData.Take(10).Reverse().ToList();
        inflationYears = chartData.Select(d => d.Date ?? "").ToArray();

        inflationChartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = "Inflation Rate (%)",
                Data = chartData.Select(d => (double)(d.Value ?? 0)).ToArray()
            }
        };

        inflationChartOptions = new ChartOptions
        {
            YAxisTicks = 1,
            MaxNumYAxisTicks = 10,
            YAxisLines = true,
            XAxisLines = false,
            LineStrokeWidth = 3,
            ChartPalette = new[] { "#9C27B0", "#673AB7" },
            InterpolationOption = InterpolationOption.Straight
        };
    }

    private void CalculateKPIs(List<AccountBalanceDTO> balances)
    {
        CashBalance = balances
            .Where(a => a.AccountCode == "1000" || a.AccountCode == "1010" || a.AccountCode == "1020")
            .Sum(a => a.Debit - a.Credit);

        var arAcct = balances.FirstOrDefault(a => a.AccountCode == "1100");
        ArOutstanding = arAcct != null ? arAcct.Debit - arAcct.Credit : 0;

        var apAcct = balances.FirstOrDefault(a => a.AccountCode == "2000");
        ApOutstanding = apAcct != null ? apAcct.Credit - apAcct.Debit : 0;

        TotalAssets = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Asset")
            .Sum(a => a.Debit - a.Credit);

        TotalLiabilities = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Liability")
            .Sum(a => a.Credit - a.Debit);

        TotalRevenue = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Revenue")
            .Sum(a => a.Credit - a.Debit);

        TotalExpenses = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Expense")
            .Sum(a => a.Debit - a.Credit);

        NetProfit = TotalRevenue - TotalExpenses;
    }

    private string FormatCompact(decimal value)
    {
        var absValue = Math.Abs(value);
        var sign = value < 0 ? "-" : "";

        if (absValue >= 1000000000)
            return $"{sign}{(absValue / 1000000000):F1}B";
        if (absValue >= 1000000)
            return $"{sign}{(absValue / 1000000):F1}M";
        if (absValue >= 1000)
            return $"{sign}{(absValue / 1000):F1}K";
        return $"{sign}{absValue:N0}";
    }

    private string GetInflationStatus(decimal? value)
    {
        if (!value.HasValue) return "No Data";
        if (value < 2) return "Low";
        if (value <= 4) return "Moderate";
        return "High";
    }

    private decimal? GetPreviousInflationValue(string? currentYear)
    {
        if (string.IsNullOrEmpty(currentYear) || !int.TryParse(currentYear, out int year)) return null;
        var previousYear = (year - 1).ToString();
        var previousData = inflationData.FirstOrDefault(x => x.Date == previousYear);
        return previousData?.Value;
    }

    private string GetInflationBorderColor(decimal? value)
    {
        if (!value.HasValue) return "#607D8B";
        if (value < 2) return "#4CAF50";
        if (value <= 4) return "#FFC107";
        return "#F44336";
    }

    private string GetInflationStatusBg(decimal? value)
    {
        if (!value.HasValue) return "rgba(96, 125, 139, 0.1)";
        if (value < 2) return "rgba(76, 175, 80, 0.1)";
        if (value <= 4) return "rgba(255, 193, 7, 0.1)";
        return "rgba(244, 67, 54, 0.1)";
    }

