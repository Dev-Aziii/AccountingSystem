@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService
@inject WorldBankService WorldBankService
@inject FrankfurterService FrankfurterService

<PageTitle>Financial Dashboard</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">

    <!-- COMPACT HEADER -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            @if (isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="28px" Class="mb-1" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="16px" />
            }
            else
            {
                <MudText Typo="Typo.h5" Style="font-weight: 800; color: rgb(22, 84, 127);">
                    Financial Dashboard
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgb(56, 146, 147);">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </MudText>
            }
        </div>
        @if (!isLoading)
        {
            <MudButton Variant="Variant.Filled" Class="refresh-btn" StartIcon="@Icons.Material.Filled.Refresh"
                Size="Size.Medium" OnClick="LoadData">
                Refresh
            </MudButton>
        }
    </div>

    @if (isLoading)
    {        
        <!-- SKELETON FOR MAIN GRID -->
        <div class="dashboard-grid">
            <!-- Card A Skeleton - Financial Summary (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card" Elevation="0">
                    <div class="ux-002">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <div class="ux-003">
                        <div class="ux-004">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                        <div class="ux-004">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="12px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12px" />
                        </div>
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-3" />
                    <div class="ux-005">
                        @for (int i = 0; i < 4; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card B Skeleton - Active Transactions (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card" Elevation="0">
                    <div class="ux-006">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" Class="mb-3" />
                    <div class="ux-007">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                    <div class="ux-008">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="60px" />
                    </div>
                </MudPaper>
            </div>

            <!-- Card C Skeleton - USD to PHP (span-3) -->
            <div class="span-3">
                <MudPaper Class="featured-card forex-featured" Elevation="0">
                    <div class="ux-006">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="14px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="12px" Class="mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="140px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="45px" Class="mb-2" />
                    }
                    <MudSkeleton Class="ux-009" SkeletonType="SkeletonType.Text" Width="150px" Height="10px" />
                </MudPaper>
            </div>

            <!-- Card D Skeleton - Philippines Economic Health (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div class="ux-002">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    <div class="ux-010">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="48px" Class="mb-1 ux-011" />
                        <MudSkeleton Class="ux-011" SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" Class="mb-3" />
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="16px" Class="mb-2" />
                    }
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                </MudPaper>
            </div>

            <!-- Card E Skeleton - Inflation History (span-6) -->
            <div class="span-6">
                <MudPaper Class="featured-card worldbank-featured" Elevation="0">
                    <div class="ux-002">
                        <div>
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-1" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="12px" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                    </div>
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                    }
                    <div class="ux-012">
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                        }
                    </div>
                </MudPaper>
            </div>

            <!-- Card F Skeleton - Account Ledger (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <div class="ux-002">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="220px" Height="20px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="36px" />
                    </div>
                    @for (int i = 0; i < 10; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="40px" Class="mb-2" />
                    }
                </MudPaper>
            </div>

            <!-- Calendar Skeleton (span-12) -->
            <div class="span-12">
                <MudPaper Class="featured-card" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" Height="20px" Class="mb-3" />
                    <div class="ux-007">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="32px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="400px" />
                </MudPaper>
            </div>
        </div>
    }
    else
    {      

        <!-- MAIN CONTENT GRID -->
        <div class="dashboard-grid">

            <!-- CARD A: Financial Summary (span-6) -->
            <div class="span-6">
                <div class="featured-card">
                    <div
 class="ux-013"                       >
                        <div>
                            <span
 class="ux-014"                               >Financial
                                Summary</span>
                            <div
 class="ux-015"                               >
                                Year-to-Date Overview</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small"
                            Style="color: rgb(56, 146, 147);" />
                    </div>

                    <!-- Revenue & Expenses Bars -->
                    <div class="ux-003">
                        <div class="ux-004">
                            <div class="ux-016">
                                <span class="ux-017">Revenue</span>
                                <span
 class="ux-018"                                   >₱@FormatCompact(TotalRevenue)</span>
                            </div>
                            <div class="ux-019">
                                <div
                                    class="dashboard-progress-fill dashboard-progress-fill-revenue"
                                    @attributes="GetRevenueWidthStyle()">
                                </div>
                            </div>
                        </div>
                        <div class="ux-004">
                            <div class="ux-016">
                                <span class="ux-017">Expenses</span>
                                <span
 class="ux-020"                                   >₱@FormatCompact(TotalExpenses)</span>
                            </div>
                            <div class="ux-019">
                                <div
                                    class="dashboard-progress-fill dashboard-progress-fill-expense"
                                    @attributes="GetExpenseWidthStyle()">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Profit Section -->
                    <div
                        class="dashboard-net-profit @GetNetProfitPanelClass()">
                        <div class="ux-021">
                            <div>
                                <div
                                    class="dashboard-net-profit-label @GetNetProfitTextClass()">
                                    Net Profit</div>
                                <div
                                    class="dashboard-net-profit-value @GetNetProfitTextClass()">
                                    ₱@FormatCompact(NetProfit)</div>
                            </div>
                            <div
                                class="dashboard-net-profit-icon @GetNetProfitIconClass()">
                                <MudIcon
                                    Icon="@(NetProfit >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                                    Size="Size.Large" Style="color: white;" />
                            </div>
                        </div>
                    </div>

                    <!-- Quick Stats Row -->
                    <div class="ux-005">
                        <div
 class="ux-022"                           >
                            <div class="ux-023">₱@FormatCompact(CashBalance)
                            </div>
                            <div class="ux-024">Cash</div>
                        </div>
                        <div
 class="ux-025"                           >
                            <div class="ux-026">₱@FormatCompact(TotalAssets)
                            </div>
                            <div class="ux-024">Assets</div>
                        </div>
                        <div
 class="ux-027"                           >
                            <div class="ux-028">₱@FormatCompact(TotalLiabilities)
                            </div>
                            <div class="ux-024">Liabilities</div>
                        </div>
                        <div
 class="ux-029"                           >
                            <div class="ux-030">
                                @ProfitMarginPercent.ToString("F1")%</div>
                            <div class="ux-024">Margin</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD B: Active Transactions (span-3) -->
            <div class="span-3">
                <div class="featured-card">
                    <div
 class="ux-031"                       >
                        <span
 class="ux-014"                           >Active
                            Transactions</span>
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small"
                            Style="color: rgb(56, 146, 147);" />
                    </div>
                    <div class="featured-value-large">@ActiveTransactions</div>
                    <div class="ux-032">Pending payments & collections
                    </div>

                    <!-- Split Stats -->
                    <div class="ux-033">
                        <div
 class="ux-034"                           >
                            <div class="ux-035">@BillsToPay</div>
                            <div class="ux-036">To Pay</div>
                        </div>
                        <div
 class="ux-037"                           >
                            <div class="ux-038">@InvoicesToCollect</div>
                            <div class="ux-039">To Collect</div>
                        </div>
                    </div>

                    <!-- Receivable & Payable Amounts -->
                    <div
 class="ux-040"                       >
                        <div
 class="ux-041"                           >
                            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Small" Style="color: #FF9800;" />
                            <div>
                                <div class="ux-042">
                                    ₱@FormatCompact(ArOutstanding)</div>
                                <div class="ux-043">
                                    Receivable</div>
                            </div>
                        </div>
                        <div
 class="ux-044"                           >
                            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" Style="color: #FF5722;" />
                            <div>
                                <div class="ux-045">
                                    ₱@FormatCompact(ApOutstanding)</div>
                                <div class="ux-046">
                                    Payable</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD C: USD to PHP Exchange Rate (span-3) - INTERACTIVE COMPACT -->
            <div class="span-3">
                <div class="featured-card forex-featured">
                    <div class="ux-031">
                        <span class="ux-047">USD to PHP</span>
                        <MudIcon Icon="@Icons.Material.Filled.CurrencyExchange" Size="Size.Small" Style="color: rgb(33, 150, 243);" />
                    </div>
                    <div class="ux-048">Live Currency Converter</div>

                    @if (usdToPhpRate > 0)
                    {
                        <!-- Exchange Rate Display -->
                        <div class="ux-049">
                            <div class="ux-050">
                                <div class="ux-051">$</div>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: #2196F3;" />
                                <div class="ux-052">₱</div>
                            </div>
                            <div class="usd-php-pulse ux-053">@usdToPhpRate.ToString("F2")</div>
                            <div class="ux-054">PHP per 1 USD</div>
                        </div>

                        <!-- Compact Converter - Input and Result on Same Line -->
                        <div class="ux-055">
                            <!-- USD Input -->
                            <div class="ux-004">
                                <div class="ux-056">
                                    <div class="ux-057">$</div>
                                    <span class="ux-058">USD</span>
                                </div>
                                <MudNumericField @bind-Value="usdInputAmount" 
                                               Min="0" 
                                               Step="1M"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               HideSpinButtons="true"
                                               Style="background: white;" />
                            </div>

                            <!-- Arrow -->
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="color: #2196F3; margin-top: 1.25rem;" Size="Size.Small" />

                            <!-- PHP Result -->
                            <div class="ux-004">
                                <div class="ux-056">
                                    <div class="ux-059">₱</div>
                                    <span class="ux-058">PHP</span>
                                </div>
                                <div class="ux-060">
                                    <div class="ux-061">@((usdInputAmount * usdToPhpRate).ToString("N2"))</div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Conversion Buttons -->
                        <div class="ux-062">
                            @foreach (var amount in new[] { 100, 500, 1000 })
                            {
                                <MudButton Variant="Variant.Outlined" 
                                         Size="Size.Small"
                                         OnClick="@(() => usdInputAmount = amount)"
                                         Style="border-color: rgba(33, 150, 243, 0.3); color: #1976D2; font-weight: 600; font-size: 0.7rem;">
                                    $@amount
                                </MudButton>
                            }
                        </div>

                        <!-- Last Updated Footer -->
                        <div class="ux-063">
                            <div class="ux-064">
                                <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" Style="color: #6b7280; font-size: 0.9rem;" />
                                Live Rate • @DateTime.Now.ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ux-065">
                            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
                            <div class="ux-066">Loading forex data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD D: Philippines Economic Health (span-6) -->
            <div class="span-6">
                <div class="featured-card worldbank-featured">
                    <div
 class="ux-013"                       >
                        <div>
                            <span
 class="ux-067"                               >Philippines
                                Economic Health</span>
                            <div
 class="ux-068"                               >
                                World Bank Inflation Data</div>
                        </div>
                        <MudChip T="string" Size="Size.Small"
                            Style="background: rgba(156, 39, 176, 0.1); color: #9C27B0; font-weight: 600;">
                            Live Data
                        </MudChip>
                    </div>

                    @if (inflationData.Any())
                    {
                        <!-- Current Inflation KPI -->
                        <div class="ux-010">
                            <div class="inflation-kpi-value">@CurrentInflationValue.ToString("F1")%</div>
                            <div class="inflation-kpi-label">Current Inflation (@inflationData.First().Date)</div>
                        </div>

                        <!-- Line Chart -->
                        <MudChart ChartType="ChartType.Line" 
                                  ChartSeries="@inflationChartSeries" 
                                  XAxisLabels="@inflationYears"
                                  Width="100%" 
                                  Height="200px"
                                  ChartOptions="@inflationChartOptions">
                        </MudChart>

                        <!-- Legend at bottom -->
                        <div class="ux-069">
                            <div class="ux-070">
                                <div class="ux-071">
                                    <div
 class="ux-072"                                       >
                                    </div>
                                    <span class="ux-073">Current Rate
                                        (@inflationData.First().Date)</span>
                                    <span
 class="ux-074"                                       >@(inflationData.First().Value?.ToString("F2")
                                                                        ?? "N/A")%</span>
                                </div>
                                @if (inflationData.Count >= 2)
                                {
                                    var yoyChange = (inflationData[0].Value ?? 0) - (inflationData[1].Value ?? 0);
                                    <div class="ux-071">
                                        <div
                                            class="dashboard-yoy-indicator @(yoyChange >= 0 ? "dashboard-yoy-up" : "dashboard-yoy-down")">
                                        </div>
                                        <span class="ux-073">YoY Change</span>
                                        <span
                                            class="dashboard-yoy-value @(yoyChange >= 0 ? "dashboard-yoy-up" : "dashboard-yoy-down")">@(yoyChange
                                                                            >= 0 ? "+" : "")@yoyChange.ToString("F2")%</span>
                                    </div>
                                }
                                @{
                                    var avg3yr = inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value) ?? 0;
                                }
                                <div class="ux-075">
                                    <div class="ux-076"></div>
                                    <span class="ux-073">3-Year Average</span>
                                    <span
 class="ux-077"                                       >@avg3yr.ToString("F2")%</span>
                                </div>
                            </div>
                            <div
 class="ux-078"                               >
                                <span class="ux-079">Status:
                                    @GetInflationStatus(inflationData.First().Value)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ux-080">
                            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
                            <div class="ux-066">Loading inflation data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD E: World Bank Inflation History (span-6) -->
            <div class="span-6">
                <div class="featured-card worldbank-featured">
                    <div
 class="ux-013"                       >
                        <div>
                            <span
 class="ux-067"                               >Inflation
                                History</span>
                            <div
 class="ux-068"                               >
                                Philippines Historical Data</div>
                        </div>
                        <MudChip T="string" Size="Size.Small"
                            Style="background: rgba(156, 39, 176, 0.1); color: #9C27B0; font-weight: 600;">
                            World Bank
                        </MudChip>
                    </div>

                    @if (inflationData.Any())
                    {
                        <!-- Inflation Data Table -->
                        <div class="ux-081">
                            @foreach (var data in inflationData.Take(8))
                            {
                                var prevVal = GetPreviousInflationValue(data.Date);
                                var isUp = prevVal.HasValue && data.Value > prevVal;
                                var changeAmount = prevVal.HasValue ? data.Value - prevVal : null;
                                <div
                                    class="dashboard-inflation-row @GetInflationBorderClass(data.Value)">
                                    <div class="ux-082">
                                        <span
 class="ux-083"                                           >@data.Date</span>
                                        @if (prevVal.HasValue)
                                        {
                                            <MudIcon
                                                Icon="@(isUp ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                                Size="Size.Small" Style="@($"color: {(isUp ? "#F44336" : "#4CAF50")};")" />
                                        }
                                    </div>
                                    <div class="ux-084">
                                        @if (changeAmount.HasValue)
                                        {
                                            <span
                                                class="dashboard-inflation-change @(isUp ? "dashboard-yoy-up" : "dashboard-yoy-down")">@(changeAmount
                                                                                >= 0 ? "+" : "")@changeAmount.Value.ToString("F2")%</span>
                                        }
                                        <span
 class="ux-085"                                           >@(data.Value?.ToString("F2")
                                                                            ?? "N/A")%</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Summary Footer -->
                        <div
 class="ux-086"                           >
                            <div
 class="ux-087"                               >
                                <div
 class="ux-088"                                   >
                                    3-Year Avg</div>
                                <div class="ux-089">
                                    @(inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
                            </div>
                            <div
 class="ux-087"                               >
                                <div
 class="ux-088"                                   >
                                    5-Year Avg</div>
                                <div class="ux-089">
                                    @(inflationData.Take(5).Where(x => x.Value.HasValue).Average(x => x.Value)?.ToString("F2")
                                                                ?? "N/A")%</div>
                            </div>
                            
                        </div>
                    }
                    else
                    {
                        <div class="ux-065">
                            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
                            <div class="ux-090">Loading inflation data...</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CARD F: Account Ledger Snapshot (span-12)
            <div class="span-12">
                <div class="featured-card">
                    <div class="ux-002">
                        <div class="ux-075">
                            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Medium" Style="color: rgb(22, 84, 127);" />
                            <span class="ux-091">Account Ledger Snapshot</span>
                        </div>
                        <MudButton Variant="Variant.Filled" Href="reports/financials"
                            StartIcon="@Icons.Material.Filled.Assessment" Size="Size.Small"
                            Style="background: linear-gradient(135deg, rgb(22, 84, 127) 0%, rgb(56, 146, 147) 100%); color: white;">
                            View Financial Reports
                        </MudButton>
                    </div>

                    <MudTable Items="@(trialBalance?.Accounts.Take(10))" Dense="true" Hover="true" Elevation="0"
                        Style="border-radius: 12px; overflow: hidden; border: 1px solid rgba(22, 84, 127, 0.1);">

                        <HeaderContent>
                            <MudTh Style="font-size: 0.85rem; width: 100px; background: rgba(22, 84, 127, 0.05);">Code</MudTh>
                            <MudTh Style="font-size: 0.85rem; background: rgba(22, 84, 127, 0.05);">Account Name</MudTh>
                            <MudTh align="Align.Right" Style="font-size: 0.85rem; width: 140px; background: rgba(22, 84, 127, 0.05);">Debit (₱)</MudTh>
