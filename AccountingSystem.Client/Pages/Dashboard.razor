@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService
@inject WorldBankService WorldBankService
@inject FrankfurterService FrankfurterService

<PageTitle>Financial Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="dash-page">

    @if (isLoading)
    {
        <!-- SKELETON -->
        <div class="dash-header-row">
            <div>
                <MudSkeleton Width="200px" Height="22px" Class="mb-1" />
                <MudSkeleton Width="140px" Height="14px" />
            </div>
            <MudSkeleton Width="90px" Height="34px" />
        </div>

        <div class="skel-kpi-grid">
            @for (int i = 0; i < 6; i++)
            {
                <div class="skel-card">
                    <MudSkeleton Width="70px" Height="12px" Class="mb-2" />
                    <MudSkeleton Width="110px" Height="28px" Class="mb-2" />
                    <MudSkeleton Width="100%" Height="40px" />
                </div>
            }
        </div>

        <MudSkeleton Width="180px" Height="12px" Class="mb-3" />
        <div class="skel-two-col">
            <div class="skel-card">
                <MudSkeleton Width="160px" Height="16px" Class="mb-4" />
                @for (int i = 0; i < 3; i++)
                {
                    <MudSkeleton Width="100%" Height="38px" Class="mb-3" />
                }
            </div>
            <div class="skel-card">
                <MudSkeleton Width="140px" Height="16px" Class="mb-4" />
                <MudSkeleton Width="100%" Height="160px" />
            </div>
        </div>

        <MudSkeleton Width="130px" Height="12px" Class="mb-3" />
        <div class="skel-two-col">
            <div class="skel-card">
                <MudSkeleton Width="180px" Height="16px" Class="mb-2" />
                <MudSkeleton Width="80px" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="180px" />
            </div>
            <div class="skel-card">
                <MudSkeleton Width="200px" Height="16px" Class="mb-3" />
                @for (int i = 0; i < 4; i++)
                {
                    <MudSkeleton Width="100%" Height="44px" Class="mb-2" />
                }
            </div>
        </div>
    }
    else
    {
        <!-- ── HEADER ── -->
        <div class="dash-header-row">
            <div>
                <div class="dash-title">Financial Dashboard</div>
                <div class="dash-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</div>
            </div>
            <MudButton Variant="Variant.Filled"
                       Class="refresh-btn"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Size="Size.Medium"
                       OnClick="LoadData">
                Refresh
            </MudButton>
        </div>

        <!-- ════════════════════════════════════════
             SECTION 1 — KEY PERFORMANCE INDICATORS
             ════════════════════════════════════════ -->
        <div class="dash-section-label first">Key Performance Indicators</div>

        <div class="kpi-sc-grid">

            <!-- Revenue -->
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Revenue</span>
                    <span class="kpi-sc-badge badge-up">▲ YTD</span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(TotalRevenue)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_rev" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#4CAF50" stop-opacity="0.18"/>
                                <stop offset="100%" stop-color="#4CAF50" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,34 14,28 28,22 42,17 57,11 71,7 100,4 100,40 0,40" fill="url(#gr_rev)"/>
                        <polyline points="0,34 14,28 28,22 42,17 57,11 71,7 100,4"
                                  fill="none" stroke="#4CAF50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Year-to-date</div>
            </div>

            <!-- Expenses -->
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Expenses</span>
                    <span class="kpi-sc-badge badge-down">▼ YTD</span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(TotalExpenses)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_exp" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#F44336" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#F44336" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,10 14,14 28,12 42,18 57,15 71,22 100,20 100,40 0,40" fill="url(#gr_exp)"/>
                        <polyline points="0,10 14,14 28,12 42,18 57,15 71,22 100,20"
                                  fill="none" stroke="#F44336" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Year-to-date</div>
            </div>

            <!-- Net Profit -->
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Net Profit</span>
                    <span class="kpi-sc-badge @(NetProfit >= 0 ? "badge-up" : "badge-down")">
                        @(NetProfit >= 0 ? "▲" : "▼") @ProfitMarginPercent.ToString("F1")%
                    </span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(NetProfit)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_np" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#2196F3" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#2196F3" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,30 14,26 28,30 42,22 57,16 71,10 100,6 100,40 0,40" fill="url(#gr_np)"/>
                        <polyline points="0,30 14,26 28,30 42,22 57,16 71,10 100,6"
                                  fill="none" stroke="#2196F3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Margin @ProfitMarginPercent.ToString("F1")%</div>
            </div>

            <!-- Cash Flow
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Cash Balance</span>
                    <span class="kpi-sc-badge badge-neutral">Cash</span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(CashBalance)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_cf" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#009688" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#009688" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,22 14,18 28,24 42,18 57,20 71,14 100,16 100,40 0,40" fill="url(#gr_cf)"/>
                        <polyline points="0,22 14,18 28,24 42,18 57,20 71,14 100,16"
                                  fill="none" stroke="#009688" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Current balance</div>
            </div>
             -->

            <!-- Assets -->
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Assets</span>
                    <span class="kpi-sc-badge badge-up">▲ Total</span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(TotalAssets)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_ast" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="rgb(22,84,127)" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="rgb(22,84,127)" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,28 14,24 28,20 42,16 57,13 71,9 100,6 100,40 0,40" fill="url(#gr_ast)"/>
                        <polyline points="0,28 14,24 28,20 42,16 57,13 71,9 100,6"
                                  fill="none" stroke="rgb(22,84,127)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Total assets</div>
            </div>

            <!-- Liabilities -->
            <div class="kpi-sc-card">
                <div class="kpi-sc-top">
                    <span class="kpi-sc-label">Liabilities</span>
                    <span class="kpi-sc-badge badge-down">▼ Monitor</span>
                </div>
                <div class="kpi-sc-value"><span class="peso-sign">₱</span>@FormatCompact(TotalLiabilities)</div>
                <div class="kpi-sc-sparkline">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="gr_lib" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#FF9800" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#FF9800" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,18 14,20 28,15 42,22 57,18 71,20 100,18 100,40 0,40" fill="url(#gr_lib)"/>
                        <polyline points="0,18 14,20 28,15 42,22 57,18 71,20 100,18"
                                  fill="none" stroke="#FF9800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="kpi-sc-footer">Total liabilities</div>
            </div>

        </div><!-- /kpi-sc-grid -->

        <!-- ════════════════════════════════════════
             SECTION 2 — FINANCIAL OVERVIEW
             ════════════════════════════════════════ -->
        <div class="dash-section-label">Financial Overview</div>

        <div class="fin-ov-grid">

            <!-- YTD Performance -->
            <div class="fin-card">
                <div class="fin-card-title">Year-to-Date Performance</div>

                @{
                    var totalFlow     = TotalRevenue + TotalExpenses;
                    var revPct        = totalFlow > 0 ? (double)TotalRevenue / (double)totalFlow * 100 : 0;
                    var expRatio      = TotalRevenue > 0 ? Math.Min((double)TotalExpenses / (double)TotalRevenue * 100, 100) : 0;
                    var marginPct     = Math.Abs((double)ProfitMarginPercent);
                    var marginIsNeg   = ProfitMarginPercent < 0;
                }

                <!-- Revenue bar -->
                <div class="ytd-row">
                    <div class="ytd-row-header">
                        <span class="ytd-row-name">Revenue</span>
                        <span class="ytd-row-meta">₱@FormatCompact(TotalRevenue)</span>
                    </div>
                    <div class="ytd-bar-track">
                        <div class="@($"ytd-bar-fill ytd-fill-revenue {GetPercentWidthClass(revPct)}")">
                            <span class="ytd-bar-pct">@revPct.ToString("F0")%</span>
                        </div>
                    </div>
                </div>

                <!-- Expenses bar -->
                <div class="ytd-row">
                    <div class="ytd-row-header">
                        <span class="ytd-row-name">Expenses</span>
                        <span class="ytd-row-meta">₱@FormatCompact(TotalExpenses) / Revenue</span>
                    </div>
                    <div class="ytd-bar-track">
                        <div class="@($"ytd-bar-fill ytd-fill-expenses {GetPercentWidthClass(expRatio)}")">
                            <span class="ytd-bar-pct">@expRatio.ToString("F0")%</span>
                        </div>
                    </div>
                </div>

                <!-- Profit Margin bar -->
                <div class="ytd-row">
                    <div class="ytd-row-header">
                        <span class="ytd-row-name">Profit Margin</span>
                        <span class="ytd-row-meta">@(marginIsNeg ? "(" : "")@ProfitMarginPercent.ToString("F1")%@(marginIsNeg ? ")" : "")</span>
                    </div>
                    <div class="ytd-bar-track">
                        <div class="@($"ytd-bar-fill {(marginIsNeg ? "ytd-fill-negative" : "ytd-fill-margin")} {GetPercentWidthClass(Math.Min(marginPct,100))}")">
                            <span class="ytd-bar-pct">@Math.Min(marginPct, 100).ToString("F0")%</span>
                        </div>
                    </div>
                </div>

            </div><!-- /YTD card -->

            <!-- Accounts Summary -->
            <div class="fin-card">
                <div class="fin-card-title">Accounts Summary</div>

                <div class="acct-grid">
                    <!-- Accounts Payable -->
                    <div>
                        <div class="acct-col-header">
                            <span class="acct-col-dot u-e6a247e7"></span>
                            Accounts Payable
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Total Outstanding</span>
                            <span class="acct-row-val red">₱@FormatCompact(ApOutstanding)</span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Bills Pending</span>
                            <span class="acct-row-val">@BillsToPay</span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Avg per Bill</span>
                            <span class="acct-row-val">
                                ₱@(BillsToPay > 0 ? FormatCompact(ApOutstanding / BillsToPay) : "—")
                            </span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Status</span>
                            <span class="acct-row-val @(BillsToPay > 0 ? "red" : "green")">
                                @(BillsToPay > 0 ? "Action needed" : "All clear")
                            </span>
                        </div>
                    </div>

                    <!-- Accounts Receivable -->
                    <div>
                        <div class="acct-col-header">
                            <span class="acct-col-dot u-260344fe"></span>
                            Accounts Receivable
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Total Outstanding</span>
                            <span class="acct-row-val blue">₱@FormatCompact(ArOutstanding)</span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Invoices Pending</span>
                            <span class="acct-row-val">@InvoicesToCollect</span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Avg per Invoice</span>
                            <span class="acct-row-val">
                                ₱@(InvoicesToCollect > 0 ? FormatCompact(ArOutstanding / InvoicesToCollect) : "—")
                            </span>
                        </div>
                        <div class="acct-row">
                            <span class="acct-row-label">Collection Rate</span>
                            <span class="acct-row-val @(ArOutstanding > 0 ? "blue" : "green")">
                                @(ArOutstanding > 0 ? "In progress" : "All collected")
                            </span>
                        </div>
                    </div>

                </div><!-- /acct-grid -->
            </div><!-- /Accounts Summary card -->

        </div><!-- /fin-ov-grid -->

        <!-- ════════════════════════════════════════
             SECTION 3 — MARKET INSIGHTS
             ════════════════════════════════════════ -->
        <div class="dash-section-label">Market Insights</div>

        <div class="market-grid u-7f6a9fd6">

            <!-- Inflation History -->
            <div class="market-card">
                <div class="market-header-row">
                    <div>
                        <div class="market-card-title">Inflation History (World Bank)</div>
                        <div class="market-card-sub">Inflation rates, for past @inflationData.Count years.</div>
                    </div>
                    @if (inflationData.Any())
                    {
                        <div class="market-big-kpi">@CurrentInflationValue.ToString("F1")%</div>
                    }
                </div>

                @if (inflationData.Any())
                {
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@inflationChartSeries"
                              XAxisLabels="@inflationYears"
                              Width="100%"
                              Height="190px"
                              ChartOptions="@inflationChartOptions" />

                    <div  class="u-f026b6f5">
                        @{
                            var yoyChange = inflationData.Count >= 2
                                ? (inflationData[0].Value ?? 0) - (inflationData[1].Value ?? 0)
                                : (decimal?)null;
                            var avg3 = inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value) ?? 0;
                        }
                        <div class="d-flex justify-space-between u-88c4b330">
                            <span>Current (@inflationData.First().Date)</span>
                            <strong  class="u-5f51284e">@(inflationData.First().Value?.ToString("F2") ?? "N/A")%</strong>
                        </div>
                        @if (yoyChange.HasValue)
                        {
                            <div class="d-flex justify-space-between u-88c4b330">
                                <span>YoY Change</span>
                                <strong class="@(yoyChange >= 0 ? "text-error" : "text-success")">
                                    @(yoyChange >= 0 ? "+" : "")@yoyChange.Value.ToString("F2")%
                                </strong>
                            </div>
                        }
                        <div class="d-flex justify-space-between u-d508a3ea">
                            <span>3-Year Average</span>
                            <strong  class="u-8302605d">@avg3.ToString("F2")%</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div  class="u-60052751">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
                        <div  class="u-de7e0ee6">Loading inflation data…</div>
                    </div>
                }
            </div><!-- /Inflation card -->

            <!-- Currency Converter -->
            <div class="market-card">
                <div class="market-card-title">Live Currency Converter &amp; Trends</div>
                <div class="market-card-sub">Interactive exchange rate · USD to PHP</div>

                @if (usdToPhpRate > 0)
                {
                    <!-- Rate pill -->
                    <div class="fx-rate-pill">
                        <div class="fx-flag u-7542e41d">$</div>
                        <div>
                            <div class="fx-ccy-label">USD</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="u-d6d35f30" />
                        <div class="fx-flag u-98a3a983">₱</div>
                        <div>
                            <div class="fx-ccy-label">PHP</div>
                        </div>
                        <div>
                            <div class="fx-rate-value">@usdToPhpRate.ToString("F2")</div>
                            <div class="fx-rate-sub">per 1 USD</div>
                        </div>
                    </div>

                    <!-- Converter row -->
                    <div class="fx-conv-row">
                        <div class="fx-conv-col">
                            <div class="fx-conv-lbl">
                                <span class="fx-flag-sm u-7542e41d">$</span>
                                USD Amount
                            </div>
                            <MudNumericField @bind-Value="usdInputAmount"
                                             Min="0"
                                             Step="1M"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true" />
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" Class="u-45dbb42c" />
                        <div class="fx-conv-col">
                            <div class="fx-conv-lbl">
                                <span class="fx-flag-sm u-98a3a983">₱</span>
                                PHP Result
                            </div>
                            <div class="fx-result">@((usdInputAmount * usdToPhpRate).ToString("N2"))</div>
                        </div>
                    </div>

                    <!-- Quick amounts -->
                    <div class="fx-quick-grid">
                        @foreach (var amt in new[] { 100, 500, 1000 })
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       OnClick="@(() => usdInputAmount = amt)"
                                       Class="chip-neutral">
                                $@amt
                            </MudButton>
                        }
                    </div>

                    <!-- Inflation context -->
                    @if (inflationData.Any())
                    {
                        <div  class="u-ebade839">
                            <div  class="u-c3803726">
                                Major Indicators
                            </div>
                            <div class="acct-row">
                                <span class="acct-row-label">USD/PHP Rate</span>
                                <span class="acct-row-val blue">@usdToPhpRate.ToString("F2")</span>
                            </div>
                            <div class="acct-row">
                                <span class="acct-row-label">Inflation (@inflationData.First().Date)</span>
                                <span class="acct-row-val">@CurrentInflationValue.ToString("F2")%</span>
                            </div>
                            <div class="acct-row">
                                <span class="acct-row-label">Inflation Status</span>
                                <span class="acct-row-val @GetInflationStatusClass(inflationData.First().Value)">
                                    @GetInflationStatus(inflationData.First().Value)
                                </span>
                            </div>
                        </div>
                    }

                    <div class="fx-footer-note">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
                        Live Rate · @DateTime.Now.ToString("MMM dd, HH:mm")
                    </div>
                }
                else
                {
                    <div  class="u-60052751">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
                        <div  class="u-de7e0ee6">Loading forex data…</div>
                    </div>
                }
            </div><!-- /Forex card -->

        </div><!-- /market-grid -->

    }<!-- /else -->

</MudContainer>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes = new();
    private List<CalendarItem> _events = new();
    private bool isLoading = false;
    private List<WorldBankDataPoint> inflationData = new();
    private decimal usdToPhpRate = 0;
    private decimal usdInputAmount = 100;

    private List<ChartSeries> inflationChartSeries = new();
    private string[] inflationYears = Array.Empty<string>();
    private ChartOptions inflationChartOptions = new();

    private decimal CashBalance;
    private decimal NetProfit;
    private decimal ArOutstanding;
    private decimal ApOutstanding;
    private decimal TotalAssets;
    private decimal TotalLiabilities;
    private decimal TotalRevenue;
    private decimal TotalExpenses;

    private int ActiveTransactions => BillsToPay + InvoicesToCollect;
    private int BillsToPay;
    private int InvoicesToCollect;
    private int ActiveAccounts => trialBalance?.Accounts.Count ?? 0;
    private decimal CurrentInflationValue => inflationData.FirstOrDefault()?.Value ?? 0;
    private decimal ProfitMarginPercent => TotalRevenue > 0 ? (NetProfit / TotalRevenue * 100) : 0;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask       = ReportService.GetTrialBalance();
            var acctsTask    = LedgerService.GetAccountsAsync();
            var billsTask    = PayableService.GetBillsAsync();
            var invoicesTask = ReceivableService.GetInvoicesAsync();
            var wbTask       = WorldBankService.GetInflationDataAsync();
            var fxTask       = FrankfurterService.GetUsdToPhpRateAsync();

            await Task.WhenAll(tbTask, acctsTask, billsTask, invoicesTask, wbTask, fxTask);

            trialBalance  = tbTask.Result;
            var accts     = acctsTask.Result;
            accountTypes  = accts?.ToDictionary(a => a.Code, a => a.Type) ?? new();
            inflationData = wbTask.Result.Where(x => x.Value.HasValue).OrderByDescending(x => x.Date).ToList();
            usdToPhpRate  = fxTask.Result;

            PrepareInflationChartData();

            var bills    = (billsTask.Result    ?? new List<BillDTO>()).Where(b => b.Balance > 0).ToList();
            var invoices = (invoicesTask.Result ?? new List<InvoiceDTO>()).Where(i => i.Balance > 0).ToList();

            BillsToPay       = bills.Count;
            InvoicesToCollect = invoices.Count;

            if (trialBalance != null) CalculateKPIs(trialBalance.Accounts);

            _events.Clear();
            foreach (var b in bills)
                _events.Add(new CalendarItem { Start = b.DueDate, Text = $"PAY: {b.VendorName} (₱{b.Balance:N0})" });
            foreach (var inv in invoices)
                _events.Add(new CalendarItem { Start = inv.DueDate, Text = $"COLLECT: {inv.CustomerName} (₱{inv.Balance:N0})" });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrepareInflationChartData()
    {
        if (!inflationData.Any()) return;
        var chartData = inflationData.Take(10).Reverse().ToList();
        inflationYears = chartData.Select(d => d.Date ?? "").ToArray();
        inflationChartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = "Inflation Rate (%)",
                Data = chartData.Select(d => (double)(d.Value ?? 0)).ToArray()
            }
        };
        inflationChartOptions = new ChartOptions
        {
            YAxisTicks          = 1,
            MaxNumYAxisTicks    = 8,
            YAxisLines          = true,
            XAxisLines          = false,
            LineStrokeWidth     = 2.5f,
            ChartPalette        = new[] { "rgb(22,84,127)" },
            InterpolationOption = InterpolationOption.Straight
        };
    }

    private void CalculateKPIs(List<AccountBalanceDTO> balances)
    {
        CashBalance = balances
            .Where(a => a.AccountCode == "1000" || a.AccountCode == "1010" || a.AccountCode == "1020")
            .Sum(a => a.Debit - a.Credit);

        var arAcct   = balances.FirstOrDefault(a => a.AccountCode == "1100");
        ArOutstanding = arAcct != null ? arAcct.Debit - arAcct.Credit : 0;

        var apAcct   = balances.FirstOrDefault(a => a.AccountCode == "2000");
        ApOutstanding = apAcct != null ? apAcct.Credit - apAcct.Debit : 0;

        TotalAssets = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Asset")
            .Sum(a => a.Debit - a.Credit);

        TotalLiabilities = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Liability")
            .Sum(a => a.Credit - a.Debit);

        TotalRevenue = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Revenue")
            .Sum(a => a.Credit - a.Debit);

        TotalExpenses = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Expense")
            .Sum(a => a.Debit - a.Credit);

        NetProfit = TotalRevenue - TotalExpenses;
    }


    private static string GetPercentWidthClass(double value)
    {
        var pct = (int)Math.Round(Math.Clamp(value, 0d, 100d));
        return $"w-pct-{pct}";
    }

    private static string GetPercentWidthClass(decimal value)
    {
        var pct = (int)Math.Round(Math.Clamp(value, 0m, 100m));
        return $"w-pct-{pct}";
    }

    private string FormatCompact(decimal value)
    {
        var abs  = Math.Abs(value);
        var sign = value < 0 ? "-" : "";
        if (abs >= 1_000_000_000) return $"{sign}{abs / 1_000_000_000:F1}B";
        if (abs >= 1_000_000)     return $"{sign}{abs / 1_000_000:F1}M";
        if (abs >= 1_000)         return $"{sign}{abs / 1_000:F1}K";
        return $"{sign}{abs:N0}";
    }

    private string GetInflationStatus(decimal? value)
    {
        if (!value.HasValue) return "No Data";
        if (value < 2)  return "Low";
        if (value <= 4) return "Moderate";
        return "High";
    }

    private string GetInflationStatusClass(decimal? value)
    {
        if (!value.HasValue) return "";
        if (value < 2)  return "green";
        if (value <= 4) return "acct-row-val";
        return "red";
    }

    private decimal? GetPreviousInflationValue(string? currentYear)
    {
        if (string.IsNullOrEmpty(currentYear) || !int.TryParse(currentYear, out int year)) return null;
        return inflationData.FirstOrDefault(x => x.Date == (year - 1).ToString())?.Value;
    }
