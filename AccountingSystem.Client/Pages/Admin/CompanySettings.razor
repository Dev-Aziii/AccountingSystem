@page "/admin/company-settings"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin")]
@inject CompanyService CompanyService
@inject ISnackbar Snackbar

<PageTitle>Company Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="400px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Company Profile
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Manage your organization's details used in financial reports and invoices.
                    </MudText>
                }
            </div>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <!-- SKELETON FOR FORM -->
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" Height="24px" />
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="86px" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="110px" Height="16px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-end pa-4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="150px" Height="42px" />
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">General Information</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField Label="Company Name"
                                          @bind-Value="model.Name"
                                          For="@(() => model.Name)"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Business Address"
                                          @bind-Value="model.Address"
                                          For="@(() => model.Address)"
                                          Variant="Variant.Outlined"
                                          Lines="3" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Tax ID / TIN"
                                          @bind-Value="model.TaxId"
                                          For="@(() => model.TaxId)"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Currency Code"
                                          @bind-Value="model.Currency"
                                          For="@(() => model.Currency)"
                                          Variant="Variant.Outlined"
                                          HelperText="e.g. PHP, USD" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end pa-4">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="save-btn"
                               Disabled="@isSubmitting"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(isSubmitting ? "Saving..." : "Save Changes")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    }
</MudContainer>

@code {
    private UpdateCompanyDTO model = new UpdateCompanyDTO();
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await CompanyService.GetCurrentCompanyAsync();
            if (current != null)
            {
                // Map CompanyDTO to UpdateCompanyDTO
                model.Name = current.Name;
                model.Address = current.Address;
                model.TaxId = current.TaxId;
                model.Currency = current.Currency;
            }
            else
            {
                Snackbar.Add("No company profile found.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await CompanyService.UpdateCompanyAsync(model);
            Snackbar.Add("Company profile updated successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Update failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
