@page "/admin/users"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin")]
@inject UserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>User Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">User Management</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage system access and roles</MudText>
    </div>

    <MudGrid>
        <!-- LEFT: User List -->
        <MudItem xs="12" md="8">
            <MudTable Items="@users" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@(users == null)" LoadingProgressColor="Color.Info" Elevation="3">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Color="Color.Primary">Current Users</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Email</MudTh>
                    <MudTh>Full Name</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <!-- FIX: Bind to Email instead of Username -->
                    <MudTd DataLabel="Email"><b>@context.Email</b></MudTd>
                    <MudTd DataLabel="Full Name">@context.FullName</MudTd>
                    <MudTd DataLabel="Role">
                        @if (context.RoleName == "Admin")
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">Admin</MudChip>
                        }
                        else if (context.RoleName == "Accounting")
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">Accounting</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Management</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        @if (!context.Email.StartsWith("admin"))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Id)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>

        <!-- RIGHT: Create User Form -->
        <MudItem xs="12" md="4">
            <EditForm Model="@newUser" OnValidSubmit="HandleCreateUser">
                <DataAnnotationsValidator />
                <MudCard Elevation="3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Create New User</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <!-- FIX: Bind to Email -->
                        <MudTextField Label="Email" @bind-Value="newUser.Email" For="@(() => newUser.Email)" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField Label="Full Name" @bind-Value="newUser.FullName" For="@(() => newUser.FullName)" Variant="Variant.Outlined" Class="mb-3" />

                        <MudSelect Label="Role" @bind-Value="newUser.RoleName" For="@(() => newUser.RoleName)" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-3">
                            <MudSelectItem Value="@("Admin")" />
                            <MudSelectItem Value="@("Accounting")" />
                            <MudSelectItem Value="@("Management")" />
                        </MudSelect>

                        <MudTextField Label="Password" @bind-Value="newUser.Password" For="@(() => newUser.Password)" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@isSubmitting">
                            @(isSubmitting ? "Creating..." : "Create Account")
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </EditForm>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<UserDTO> users;
    private RegisterDTO newUser = new RegisterDTO();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task HandleCreateUser()
    {
        isSubmitting = true;
        try
        {
            await UserService.CreateUserAsync(newUser);
            Snackbar.Add("User created successfully.", Severity.Success);
            newUser = new RegisterDTO(); // Reset form
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ConfirmDelete(int id)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Delete Confirmation",
            "Are you sure you want to delete this user?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await UserService.DeleteUserAsync(id);
                Snackbar.Add("User deleted successfully.", Severity.Success);
                await LoadUsers();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}