@page "/admin/audit-logs"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Admin")]
@inject AuditLogService AuditService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>System Audit Logs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <!-- HEADER -->
    <MudPaper Class="page-header mb-6" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (_initialLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="350px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 page-header-title">
                        Audit Logs
                    </MudText>
                    <MudText Typo="Typo.body1" Class="page-header-subtitle">
                        Track all system modifications and security events
                    </MudText>
                }
            </div>
            @if (_initialLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="150px" Height="42px" />
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Class="refresh-btn"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Size="Size.Large"
                           OnClick="LoadLogs">
                    Refresh Logs
                </MudButton>
            }
        </div>
    </MudPaper>

    @if (_initialLoading)
    {
        <!-- SKELETON FOR TABLE -->
        <MudCard Elevation="3">
            <!-- Toolbar Skeleton -->
            <MudCardContent Class="pa-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="40px" />
                </div>

                <!-- Table Header Skeleton -->
                <div class="d-flex justify-space-between mb-3">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="20px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="60px" Height="20px" />
                </div>

                <!-- Table Rows Skeleton -->
                @for (int i = 0; i < 10; i++)
                {
                    <div class="d-flex justify-space-between align-center mb-3 pa-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" />
                        </div>
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="16px" />
                        </div>
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80px" Height="24px" />
                        </div>
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" />
                        </div>
                        <div style="flex: 1; text-align: center;">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        </div>
                    </div>
                }

                <!-- Pagination Skeleton -->
                <div class="d-flex justify-center mt-4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="32px" />
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <!-- FILTERS PANEL -->
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
                <MudText Typo="Typo.h6">Filters</MudText>
                <MudSpacer />
                @if (HasActiveFilters())
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mr-2">
                        @GetActiveFilterCount() active filter(s)
                    </MudChip>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Secondary" 
                               Size="Size.Small" 
                               OnClick="ClearAllFilters"
                               StartIcon="@Icons.Material.Filled.Clear">
                        Clear All
                    </MudButton>
                }
            </div>
            
            <MudGrid>
                <!-- Date Range Filter -->
                <MudItem xs="12" md="3">
                    <MudDateRangePicker Label="Date Range" 
                                        @bind-DateRange="dateRange"
                                        Clearable="true"
                                        AutoClose="true"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense" />
                </MudItem>

                <!-- Action Type Filter -->
                <MudItem xs="12" md="3">
                    <MudSelect T="string" 
                               Label="Action Type" 
                               @bind-Value="selectedActionType"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("LOGIN")">Login</MudSelectItem>
                        <MudSelectItem T="string" Value="@("USER")">User Management</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CUSTOMER")">Customer (AR)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("VENDOR")">Vendor (AP)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ACCOUNT")">Accounts (GL)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("BILL")">Bills/Expenses</MudSelectItem>
                        <MudSelectItem T="string" Value="@("INVOICE")">Invoices</MudSelectItem>
                        <MudSelectItem T="string" Value="@("JOURNAL")">Journal Entries</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- User Filter -->
                <MudItem xs="12" md="3">
                    <MudAutocomplete T="string" 
                                     Label="User" 
                                     @bind-Value="selectedUser"
                                     SearchFunc="SearchUsers"
                                     Clearable="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     DebounceInterval="300" />
                </MudItem>

                <!-- Search Box -->
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="searchString" 
                                  Label="Search" 
                                  Placeholder="Search by keyword..."
                                  Adornment="Adornment.Start" 
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- RESULTS SUMMARY -->
        @if (FilteredLogs.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Elevation="0">
                Showing <strong>@FilteredLogs.Count()</strong> of <strong>@auditLogs.Count</strong> total logs
            </MudAlert>
        }

        <!-- TABLE -->
        <MudTable Items="@FilteredLogs" Dense="true" Hover="true" Bordered="false" Striped="true"
                  Loading="@_loading" LoadingProgressColor="Color.Info" Elevation="3">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Activity History</MudText>
                <MudSpacer />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AuditLogDTO, object>(x => x.Timestamp)">Date & Time</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AuditLogDTO, object>(x => x.UserEmail)">User</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AuditLogDTO, object>(x => x.Action)">Action</MudTableSortLabel></MudTh>
                <MudTh>Target Endpoint</MudTh>
                <MudTh Style="text-align:center">Details</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.Timestamp.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="User">
                    <MudText Typo="Typo.body2" Color="@(context.UserEmail.Contains("System") ? Color.Secondary : Color.Default)">
                        @context.UserEmail
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudChip T="string" Color="@GetActionColor(context.Action)" Size="Size.Small">@context.Action</MudChip>
                </MudTd>
                <MudTd DataLabel="Target">
                    <code style="font-size: 0.8em">@context.EntityName</code>
                </MudTd>
                <MudTd DataLabel="Details" Style="text-align:center">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Medium" Color="Color.Default" OnClick="@(async () => await ViewDetails(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
            <NoRecordsContent>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="py-8">
                    No audit logs found matching your filters.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<AuditLogDTO> auditLogs = new List<AuditLogDTO>();
    private string searchString = "";
    private bool _loading = true;
    private bool _initialLoading = true;

    // Filter properties
    private DateRange? dateRange = null;
    private string? selectedActionType = null;
    private string? selectedUser = null;

    // Computed property for filtered logs
    private IEnumerable<AuditLogDTO> FilteredLogs => ApplyFilters();

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
        _initialLoading = false;
        StateHasChanged();
    }

    private async Task LoadLogs()
    {
        _loading = true;
        try
        {
            auditLogs = await AuditService.GetAuditLogsAsync() ?? new List<AuditLogDTO>();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load logs: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Apply all filters
    private IEnumerable<AuditLogDTO> ApplyFilters()
    {
        var filtered = auditLogs.AsEnumerable();

        // Date range filter
        if (dateRange?.Start != null && dateRange?.End != null)
        {
            filtered = filtered.Where(log => 
                log.Timestamp.Date >= dateRange.Start.Value.Date && 
                log.Timestamp.Date <= dateRange.End.Value.Date);
        }

        // Action type filter
        if (!string.IsNullOrWhiteSpace(selectedActionType))
        {
            if (selectedActionType == "USER")
                filtered = filtered.Where(log => log.Action.StartsWith("USER-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "CUSTOMER")
                filtered = filtered.Where(log => log.Action.StartsWith("CUSTOMER-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "VENDOR")
                filtered = filtered.Where(log => log.Action.StartsWith("VENDOR-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "ACCOUNT")
                filtered = filtered.Where(log => log.Action.StartsWith("ACCOUNT-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "BILL")
                filtered = filtered.Where(log => log.Action.StartsWith("BILL-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "INVOICE")
                filtered = filtered.Where(log => log.Action.StartsWith("INVOICE-", StringComparison.OrdinalIgnoreCase));
            else if (selectedActionType == "JOURNAL")
                filtered = filtered.Where(log => log.Action.Contains("JOURNAL", StringComparison.OrdinalIgnoreCase));
            else
                filtered = filtered.Where(log => log.Action.Equals(selectedActionType, StringComparison.OrdinalIgnoreCase));
        }

        // User filter
        if (!string.IsNullOrWhiteSpace(selectedUser))
        {
            filtered = filtered.Where(log => log.UserEmail.Equals(selectedUser, StringComparison.OrdinalIgnoreCase));
        }

        // Text search filter
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            filtered = filtered.Where(log => 
                log.UserEmail.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                log.Action.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                log.EntityName.Contains(searchString, StringComparison.OrdinalIgnoreCase));
        }

        return filtered;
    }

    // User autocomplete search
    private async Task<IEnumerable<string>> SearchUsers(string value, CancellationToken cancellationToken)
    {
        await Task.Delay(5, cancellationToken); // Small delay to simulate async
        
        var uniqueUsers = auditLogs.Select(log => log.UserEmail).Distinct().OrderBy(u => u);
        
        if (string.IsNullOrWhiteSpace(value))
            return uniqueUsers;
        
        return uniqueUsers.Where(u => u.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    // Check if any filters are active
    private bool HasActiveFilters()
    {
        return dateRange != null || 
               !string.IsNullOrWhiteSpace(selectedActionType) || 
               !string.IsNullOrWhiteSpace(selectedUser) ||
               !string.IsNullOrWhiteSpace(searchString);
    }

    // Get count of active filters
    private int GetActiveFilterCount()
    {
        int count = 0;
        if (dateRange != null) count++;
        if (!string.IsNullOrWhiteSpace(selectedActionType)) count++;
        if (!string.IsNullOrWhiteSpace(selectedUser)) count++;
        if (!string.IsNullOrWhiteSpace(searchString)) count++;
        return count;
    }

    // Clear all filters
    private void ClearAllFilters()
    {
        dateRange = null;
        selectedActionType = null;
        selectedUser = null;
        searchString = "";
        StateHasChanged();
    }

    private async Task ViewDetails(AuditLogDTO log)
    {
        var parameters = new DialogParameters { ["Log"] = log };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<AuditDetailsDialog>("Audit Log Details", parameters, options);
    }

    private Color GetActionColor(string action)
    {
        if (action == "LOGIN") return Color.Dark;

        if (action.StartsWith("USER-")) return Color.Tertiary;       // Purple for User Mgmt
        if (action.StartsWith("CUSTOMER-")) return Color.Info;       // Blue for AR
        if (action.StartsWith("VENDOR-")) return Color.Warning;      // Orange for AP
        if (action.StartsWith("ACCOUNT-")) return Color.Success;     // Green for GL
        if (action.StartsWith("BILL-")) return Color.Error;          // Red/Pink for Expenses
        if (action.StartsWith("INVOICE-")) return Color.Primary;     // Primary for Revenue
        if (action == "JOURNAL-ENTRY") return Color.Surface;         // Neutral for Journals

        // Fallbacks for raw HTTP methods
        return action switch
        {
            "POST" => Color.Success,
            "PUT" => Color.Warning,
            "DELETE" => Color.Error,
            _ => Color.Default
        };
    }
}
