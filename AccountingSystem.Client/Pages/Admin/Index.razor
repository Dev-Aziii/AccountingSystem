@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administration</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-1">Administration</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--text-muted);">Manage users, audit history, and company settings.</MudText>

    <MudBreadcrumbs Items="@_adminLinks" Class="mb-6" />

    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var link in _adminLinks)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@link.Href">@link.Text</MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _adminLinks = new()
    {
        new("User Management", href: "admin/users"),
        new("Audit Logs", href: "admin/audit-logs"),
        new("Company Settings", href: "admin/company-settings")
    };
}
