@page "/payment-callback"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Shared.Enums
@using MudBlazor
@using Blazored.LocalStorage
@inject ReceivableService ReceivableService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
    @if (isVerifying)
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
        <MudText Typo="Typo.h5">Verifying Payment...</MudText>
        <MudText>Please wait while we confirm with PayMongo.</MudText>
    }
    else if (isSuccess)
    {
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"  Class="mb-4 u-64421442" />
        <MudText Typo="Typo.h4" Color="Color.Success">Payment Successful!</MudText>
        <MudText Class="mb-4">Your payment has been recorded.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/ar/invoices/list">Return to Invoices</MudButton>
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error"  Class="mb-4 u-64421442" />
        <MudText Typo="Typo.h4" Color="Color.Error">Payment Failed</MudText>
        <MudText Class="mb-4">@errorMessage</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/ar/invoices/list">Back to List</MudButton>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery] public int InvoiceId { get; set; }
    [SupplyParameterFromQuery] public int AccountId { get; set; }
    [SupplyParameterFromQuery] public decimal Amount { get; set; }
    [SupplyParameterFromQuery(Name = "source_id")] public string? UrlSourceId { get; set; }

    private bool isVerifying = true;
    private bool isSuccess = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        string? sourceId = UrlSourceId;

        if (string.IsNullOrEmpty(sourceId))
        {
            sourceId = await LocalStorage.GetItemAsync<string>("pending_payment_source_id");
        }

        if (string.IsNullOrEmpty(sourceId))
        {
            isVerifying = false;
            errorMessage = "Lost payment reference. Please contact support.";
            return;
        }

        try
        {
            var paymentDto = new RecordPaymentDTO
            {
                ReferenceId = InvoiceId,
                AssetAccountId = AccountId,
                Amount = Amount,
                // FIX: Use Enum instead of string
                PaymentMethod = PaymentMethod.Online,
                ReferenceNumber = sourceId,
                PaymentDate = DateTime.Now,
                SourceId = sourceId,
                Remarks = "Online Payment verified via Callback"
            };

            await ReceivableService.ReceivePaymentAsync(paymentDto);
            await LocalStorage.RemoveItemAsync("pending_payment_source_id");
            isSuccess = true;
            Snackbar.Add("Payment Verified & Recorded!", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = "Verification Failed: " + ex.Message;
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isVerifying = false;
        }
    }
}