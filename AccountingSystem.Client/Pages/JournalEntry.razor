@* @page "/journal/new" *@
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ILedgerService LedgerService
@inject NavigationManager NavManager

<PageTitle>New Journal Entry</PageTitle>

<div class="container mt-4">
    <h2>Record Journal Entry</h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="@entry" OnValidSubmit="HandleSubmit">
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <InputDate @bind-Value="entry.Date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reference</label>
                <InputText @bind-Value="entry.Reference" class="form-control" placeholder="e.g. JE-001" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Description</label>
                <InputText @bind-Value="entry.Description" class="form-control" placeholder="Transaction description" />
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Lines</span>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="AddLine">+ Add Line</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%">Account</th>
                            <th style="width: 25%">Debit</th>
                            <th style="width: 25%">Credit</th>
                            <th style="width: 10%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in entry.Lines)
                        {
                            <tr>
                                <td>
                                    <InputSelect @bind-Value="line.AccountId" class="form-select">
                                        <option value="0">-- Select Account --</option>
                                        @if (accounts != null)
                                        {
                                            foreach (var acct in accounts)
                                            {
                                                <option value="@acct.Id">@acct.Code - @acct.Name</option>
                                            }
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputNumber @bind-Value="line.Debit" class="form-control text-end" @oninput="StateHasChanged" />
                                </td>
                                <td>
                                    <InputNumber @bind-Value="line.Credit" class="form-control text-end" @oninput="StateHasChanged" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveLine(line)">
                                        <i class="bi bi-trash"></i> X
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="@(IsBalanced ? "table-success" : "table-danger")">
                            <td class="text-end fw-bold">TOTALS:</td>
                            <td class="text-end fw-bold">@TotalDebit.ToString("N2")</td>
                            <td class="text-end fw-bold">@TotalCredit.ToString("N2")</td>
                            <td>
                                @if (!IsBalanced)
                                {
                                    <span class="badge bg-danger">Imbalanced</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Balanced</span>
                                }
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-lg" disabled="@(!IsBalanced)">Post Entry</button>
        </div>
    </EditForm>
</div>

@code {
    private JournalEntryDTO entry = new JournalEntryDTO
    {
        Date = DateTime.Today,
        Lines = new List<JournalEntryLineDTO>
        {
            new JournalEntryLineDTO(),
            new JournalEntryLineDTO()
        }
    };

    private List<AccountDTO> accounts;
    private string errorMessage;

    private decimal TotalDebit => entry.Lines.Sum(l => l.Debit);
    private decimal TotalCredit => entry.Lines.Sum(l => l.Credit);
    private bool IsBalanced => TotalDebit == TotalCredit && TotalDebit > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await LedgerService.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load accounts: " + ex.Message;
        }
    }

    private void AddLine()
    {
        entry.Lines.Add(new JournalEntryLineDTO());
    }

    private void RemoveLine(JournalEntryLineDTO line)
    {
        if (entry.Lines.Count > 2)
        {
            entry.Lines.Remove(line);
        }
    }

    private async Task HandleSubmit()
    {
        if (!IsBalanced)
        {
            errorMessage = "Transaction must be balanced.";
            return;
        }

        try
        {
            await LedgerService.PostJournalEntryAsync(entry);
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}