@* @page "/payments/new" *@
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IPaymentClientService PaymentService
@inject NavigationManager NavManager

<PageTitle>Process Payment</PageTitle>

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-credit-card"></i> Process Payment</h4>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="@paymentRequest" OnValidSubmit="HandlePayment">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Description / Invoice #</label>
                    <InputText @bind-Value="paymentRequest.Description" class="form-control" placeholder="e.g. Inv-1001" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Amount (PHP)</label>
                    <InputNumber @bind-Value="paymentRequest.Amount" class="form-control" step="0.01" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Remarks (Optional)</label>
                    <InputTextArea @bind-Value="paymentRequest.Remarks" class="form-control" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Redirecting...</span>
                        }
                        else
                        {
                            <span>Pay via GCash / GrabPay</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CreateSourceDTO paymentRequest = new CreateSourceDTO { Amount = 100.00M };
    private string errorMessage;
    private bool isProcessing = false;

    private async Task HandlePayment()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            var checkoutUrl = await PaymentService.CreatePaymentLinkAsync(paymentRequest);
            // Redirect user to PayMongo hosted checkout
            NavManager.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            isProcessing = false;
        }
    }
}