@page "/dashboard"
@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using Heron.MudCalendar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ReportService ReportService
@inject LedgerService LedgerService
@inject PayableService PayableService
@inject ReceivableService ReceivableService
@inject WorldBankService WorldBankService

<PageTitle>Financial Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-10">

    <!-- HEADER -->
    <MudPaper Class="dashboard-header pa-6 mb-8" Elevation="0">
        <div class="d-flex justify-space-between align-center">
            <div>
                @if (isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="350px" Height="32px" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="450px" Height="20px" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-2 header-title">
                        Executive Financial Dashboard
                    </MudText>
                    <MudText Typo="Typo.body1" Class="header-subtitle">
                        Real-time insights into liquidity, profitability, and financial obligations
                    </MudText>
                }
            </div>
            @if (isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="150px" Height="42px" />
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Class="refresh-btn"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Size="Size.Large"
                           OnClick="LoadData">
                    Refresh Data
                </MudButton>
            }
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <!-- SKELETON FOR KPI SECTION -->
        <div class="section-title mb-4">
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="me-2" Style="display: inline-block;" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="250px" Height="24px" Style="display: inline-block;" />
        </div>

        <MudGrid Spacing="3" Class="mb-10">
            <!-- KPI CARD SKELETONS -->
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="0" Class="kpi-card pa-6">
                        <div class="d-flex justify-space-between align-center">
                            <div class="flex-grow-1">
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="16px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="14px" Class="mb-3" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100px" Height="24px" />
                            </div>
                            <div class="kpi-icon">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <!-- SKELETON FOR WORLD BANK SECTION -->
        <MudDivider Class="my-8" Style="border-color: rgba(22, 84, 127, 0.2);" />
        
        <div class="section-title mb-4">
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="me-2" Style="display: inline-block;" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="24px" Style="display: inline-block;" />
        </div>

        <MudGrid Spacing="3" Class="mb-10">
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="worldbank-card pa-6">
                        <div class="d-flex justify-space-between align-center">
                            <div class="flex-grow-1">
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="16px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="14px" Class="mb-3" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="24px" />
                            </div>
                            <div class="worldbank-icon">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <!-- SKELETON FOR LOWER SECTION -->
        <MudGrid Spacing="6">
            <!-- CALENDAR SKELETON -->
            <MudItem xs="12" lg="8">
                <div class="calendar-section pa-6">
                    <div class="section-title mb-4">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="me-2" Style="display: inline-block;" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="280px" Height="24px" Style="display: inline-block;" />
                    </div>

                    <div class="d-flex gap-4 mb-6">
                        @for (int i = 0; i < 2; i++)
                        {
                            <div class="legend-item d-flex align-center">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="16px" Height="16px" Class="me-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="14px" />
                            </div>
                        }
                    </div>

                    <!-- Calendar Grid Skeleton -->
                    <MudCard Elevation="0" Style="border-radius: 16px; overflow: hidden;">
                        <MudCardContent>
                            <div class="d-flex justify-space-between mb-4">
                                @for (int i = 0; i < 7; i++)
                                {
                                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="60px" Height="16px" />
                                }
                            </div>
                            @for (int week = 0; week < 5; week++)
                            {
                                <div class="d-flex justify-space-between mb-3" style="height: 80px;">
                                    @for (int day = 0; day < 7; day++)
                                    {
                                        <div style="width: 13%; padding: 8px;">
                                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="20px" Height="16px" Class="mb-2" />
                                            @if ((week + day) % 3 == 0)
                                            {
                                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="20px" />
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>

            <!-- LEDGER SKELETON -->
            <MudItem xs="12" lg="4">
                <div class="ledger-section pa-6">
                    <div class="section-title mb-4">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="me-2" Style="display: inline-block;" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Height="24px" Style="display: inline-block;" />
                    </div>

                    <!-- Table Header Skeleton -->
                    <div class="d-flex justify-space-between mb-3 pa-3">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" />
                    </div>

                    <!-- Table Rows Skeleton -->
                    @for (int i = 0; i < 8; i++)
                    {
                        <div class="d-flex justify-space-between align-center pa-3 mb-2">
                            <div class="flex-grow-1">
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="140px" Height="16px" Class="mb-1" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="60px" Height="12px" />
                            </div>
                            <div>
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="16px" />
                            </div>
                        </div>
                    }

                    <div class="text-center mt-6">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="200px" Height="42px" />
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- COMPANY KPI SECTION -->
        <div class="section-title">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" />
            Company Key Performance Indicators
        </div>

        <MudGrid Spacing="3" Class="mb-10">

            <!-- ROW 1 -->
            <!-- CASH -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Cash & Bank Balance</MudText>
                            <MudText Class="kpi-value peso">@CashBalance.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Immediately available funds</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(76, 175, 80, 0.1); color: #4CAF50; font-weight: 600;">
                                Liquid Assets
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- NET PROFIT -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Net Profit (YTD)</MudText>
                            <MudText Class="kpi-value peso">@NetProfit.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Revenue minus expenses</MudText>
                            <MudChip T="string" Class="mt-3" 
                                     Style="@($"background: {(NetProfit >= 0 ? "rgba(76, 175, 80, 0.1)" : "rgba(244, 67, 54, 0.1)")}; color: {(NetProfit >= 0 ? "#4CAF50" : "#F44336")}; font-weight: 600;")">
                                @(NetProfit >= 0 ? "Profitable" : "Loss")
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- TOTAL ASSETS -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Total Assets</MudText>
                            <MudText Class="kpi-value peso">@TotalAssets.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Company resources</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(33, 150, 243, 0.1); color: #2196F3; font-weight: 600;">
                                Total Value
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- ROW 2 -->
            <!-- ACCOUNTS RECEIVABLE -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Accounts Receivable</MudText>
                            <MudText Class="kpi-value peso">@ArOutstanding.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Customer outstanding</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(255, 193, 7, 0.1); color: #FFC107; font-weight: 600;">
                                To Collect
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- ACCOUNTS PAYABLE -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Accounts Payable</MudText>
                            <MudText Class="kpi-value peso">@ApOutstanding.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Vendor obligations</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(255, 87, 34, 0.1); color: #FF5722; font-weight: 600;">
                                To Pay
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- TOTAL LIABILITIES -->
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="kpi-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="kpi-label">Total Liabilities</MudText>
                            <MudText Class="kpi-value peso">@TotalLiabilities.ToString("N0")</MudText>
                            <MudText Class="kpi-description">Total obligations</MudText>
                            <MudChip T="string" Class="mt-3" Style="background: rgba(96, 125, 139, 0.1); color: #607D8B; font-weight: 600;">
                                Obligations
                            </MudChip>
                        </div>
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <!-- SECTION DIVIDER -->
        <MudDivider Class="my-8" Style="border-color: rgba(22, 84, 127, 0.2); border-width: 2px;" />

        <!-- WORLD BANK ECONOMIC INDICATORS SECTION -->
        <div class="section-title">
            <MudIcon Icon="@Icons.Material.Filled.PublicOff" Size="Size.Large" />
            Philippines Economic Indicators
            <MudChip T="string" Class="ms-3" Style="background: rgba(156, 39, 176, 0.1); color: #9C27B0; font-weight: 600;">
                World Bank Data
            </MudChip>
        </div>

        <MudGrid Spacing="3" Class="mb-10">

            <!-- CURRENT INFLATION RATE -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="worldbank-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="worldbank-label">Current Inflation Rate</MudText>
                            @if (inflationData.Any())
                            {
                                var latest = inflationData.First();
                                <MudText Class="worldbank-value">@(latest.Value?.ToString("N2") ?? "N/A")%</MudText>
                                <MudText Class="worldbank-description">@latest.Date data</MudText>
                                <MudChip T="string" Class="mt-3" 
                                         Style="@GetInflationChipStyle(latest.Value)">
                                    @GetInflationStatus(latest.Value)
                                </MudChip>
                            }
                            else
                            {
                                <MudText Class="worldbank-value">Loading...</MudText>
                                <MudText Class="worldbank-description">Fetching data</MudText>
                            }
                        </div>
                        <div class="worldbank-icon">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- INFLATION TREND (3-YEAR AVG) -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="worldbank-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="worldbank-label">3-Year Average</MudText>
                            @if (inflationData.Any())
                            {
                                var avg = inflationData.Take(3).Where(x => x.Value.HasValue).Average(x => x.Value) ?? 0;
                                <MudText Class="worldbank-value">@avg.ToString("N2")%</MudText>
                                <MudText Class="worldbank-description">Recent trend</MudText>
                                <MudChip T="string" Class="mt-3" Style="background: rgba(63, 81, 181, 0.1); color: #3F51B5; font-weight: 600;">
                                    Historical Average
                                </MudChip>
                            }
                            else
                            {
                                <MudText Class="worldbank-value">Loading...</MudText>
                                <MudText Class="worldbank-description">Calculating trend</MudText>
                            }
                        </div>
                        <div class="worldbank-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- YEAR-OVER-YEAR COMPARISON -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="worldbank-card pa-6">
                    <div class="d-flex justify-space-between align-center">
                        <div class="flex-grow-1">
                            <MudText Class="worldbank-label">YoY Change</MudText>
                            @if (inflationData.Count >= 2)
                            {
                                var current = inflationData[0].Value ?? 0;
                                var previous = inflationData[1].Value ?? 0;
                                var change = current - previous;
                                <MudText Class="worldbank-value">@change.ToString("+0.00;-0.00;0.00")%</MudText>
                                <MudText Class="worldbank-description">vs. previous year</MudText>
                                <MudChip T="string" Class="mt-3" 
                                         Style="@($"background: {(change >= 0 ? "rgba(244, 67, 54, 0.1)" : "rgba(76, 175, 80, 0.1)")}; color: {(change >= 0 ? "#F44336" : "#4CAF50")}; font-weight: 600;")">
                                    @(change >= 0 ? "Increasing" : "Decreasing")
                                </MudChip>
                            }
                            else
                            {
                                <MudText Class="worldbank-value">Loading...</MudText>
                                <MudText Class="worldbank-description">Comparing data</MudText>
                            }
                        </div>
                        <div class="worldbank-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Compare" Size="Size.Large" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <!-- HISTORICAL INFLATION CHART -->
        @if (inflationData.Any())
        {
            <MudPaper Class="worldbank-chart-section pa-6 mb-10" Elevation="0">
                <div class="section-title mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" />
                    Historical Inflation Trend (Philippines)
                </div>
                
                <MudTable Items="@inflationData"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Class="custom-table"
                          Style="border-radius: 12px; overflow: hidden;">

                    <HeaderContent>
                        <MudTh Style="font-size: 0.9rem;">Year</MudTh>
                        <MudTh align="Align.Right" Style="font-size: 0.9rem;">Inflation Rate (%)</MudTh>
                        <MudTh align="Align.Center" Style="font-size: 0.9rem;">Trend</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd Style="padding: 16px 12px;">
                            <MudText Typo="Typo.body2" Class="custom-text-primary" Style="font-weight: 600;">
                                @context.Date
                            </MudText>
                        </MudTd>
                        <MudTd align="Align.Right" Style="padding: 16px 12px;">
                            <MudText Style="font-weight: 700; font-size: 1rem;" Class="custom-text-primary">
                                @(context.Value?.ToString("N2") ?? "N/A")%
                            </MudText>
                        </MudTd>
                        <MudTd align="Align.Center" Style="padding: 16px 12px;">
                            @{
                                var previousValue = GetPreviousInflationValue(context.Date);
                                var currentValue = context.Value ?? 0;
                                var isIncreasing = previousValue.HasValue && currentValue > previousValue.Value;
                                var isDecreasing = previousValue.HasValue && currentValue < previousValue.Value;
                            }
                            @if (isIncreasing)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="color: #F44336;" />
                            }
                            else if (isDecreasing)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Style="color: #4CAF50;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Style="color: #FF9800;" />
                            }
                        </MudTd>
                    </RowTemplate>

                </MudTable>

                <div class="text-center mt-6">
                    <MudText Typo="Typo.caption" Class="custom-text-secondary" Style="font-style: italic;">
                        Data sourced from World Bank Open Data API • Last updated: @DateTime.Now.ToString("MMM dd, yyyy")
                    </MudText>
                </div>
            </MudPaper>
        }

        <!-- LOWER SECTION -->
        <MudGrid Spacing="6">

            <!-- CALENDAR -->
            <MudItem xs="12" lg="8">
                <div class="calendar-section pa-6">
                    <div class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" />
                        Payment & Collection Schedule
                    </div>

                    <div class="d-flex gap-4 mb-6">
                        <div class="legend-item">
                            <MudIcon Icon="@Icons.Material.Filled.CircleNotifications"
                                     Style="color: #4CAF50;" Size="Size.Small" />
                            <span>Invoices Due</span>
                        </div>
                        <div class="legend-item">
                            <MudIcon Icon="@Icons.Material.Filled.CircleNotifications"
                                     Style="color: #F44336;" Size="Size.Small" />
                            <span>Bills Due</span>
                        </div>
                    </div>

                    <MudCalendar Items="_events"
                                 MonthCellMinHeight="80"
                                 Elevation="0"
                                 Outlined="false"
                                 Style="border-radius: 16px; overflow: hidden;" />
                </div>
            </MudItem>

            <!-- LEDGER SNAPSHOT -->
            <MudItem xs="12" lg="4">
                <div class="ledger-section pa-6">
                    <div class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" />
                        Ledger Snapshot
                    </div>

                    <MudTable Items="@(trialBalance?.Accounts.Take(8))"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Class="custom-table"
                              Style="border-radius: 12px; overflow: hidden;">

                        <HeaderContent>
                            <MudTh Style="font-size: 0.9rem;">Account Details</MudTh>
                            <MudTh align="Align.Right" Style="font-size: 0.9rem;">Balance (₱)</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd Style="padding: 16px 12px;">
                                <div>
                                    <MudText Typo="Typo.body2" Class="custom-text-primary" Style="font-weight: 600;">
                                        @context.AccountName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="custom-text-secondary" Style="font-weight: 500;">
                                        @context.AccountCode
                                    </MudText>
                                </div>
                            </MudTd>
                            <MudTd align="Align.Right" Style="padding: 16px 12px;">
                                <MudText Style="font-weight: 700; font-size: 1rem;" Class="custom-text-primary">
                                    @((context.Debit - context.Credit).ToString("N0"))
                                </MudText>
                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                    <div class="text-center mt-6">
                        <MudButton Variant="Variant.Filled"
                                   Class="custom-button"
                                   Href="reports/financials"
                                   StartIcon="@Icons.Material.Filled.Assessment"
                                   Size="Size.Large"
                                   Style="color: white !important;">
                            View Financial Reports
                        </MudButton>
                    </div>
                </div>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@code {
    private TrialBalanceDTO? trialBalance;
    private Dictionary<string, string> accountTypes = new();
    private List<CalendarItem> _events = new();
    private bool isLoading = false;
    private List<WorldBankDataPoint> inflationData = new();

    // --- KPI Properties ---
    private decimal CashBalance;
    private decimal NetProfit;
    private decimal ArOutstanding;
    private decimal ApOutstanding;
    private decimal TotalAssets;
    private decimal TotalLiabilities;

    // --- Dynamic Styling Helpers ---
    private string NetProfitBorderColor =>
        NetProfit >= 0
            ? "var(--theme-primary)"
            : "var(--mud-palette-error)";

    private string NetProfitTextColor =>
        NetProfit >= 0
            ? "var(--mud-palette-success)"
            : "var(--mud-palette-error)";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tbTask = ReportService.GetTrialBalance();
            var acctsTask = LedgerService.GetAccountsAsync();
            var billsTask = PayableService.GetBillsAsync();
            var invoicesTask = ReceivableService.GetInvoicesAsync();
            var worldBankTask = WorldBankService.GetInflationDataAsync();

            await Task.WhenAll(tbTask, acctsTask, billsTask, invoicesTask, worldBankTask);

            trialBalance = tbTask.Result;
            var accountsList = acctsTask.Result;
            accountTypes = accountsList.ToDictionary(a => a.Code, a => a.Type);
            inflationData = worldBankTask.Result.Where(x => x.Value.HasValue).ToList();

            CalculateKPIs(trialBalance!.Accounts);

            _events.Clear();

            foreach (var bill in billsTask.Result.Where(b => b.Balance > 0))
            {
                _events.Add(new CalendarItem
                {
                    Start = bill.DueDate,
                    Text = $"PAY: {bill.VendorName} (₱{bill.Balance:N0})"
                });
            }

            foreach (var inv in invoicesTask.Result.Where(i => i.Balance > 0))
            {
                _events.Add(new CalendarItem
                {
                    Start = inv.DueDate,
                    Text = $"COLLECT: {inv.CustomerName} (₱{inv.Balance:N0})"
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateKPIs(List<AccountBalanceDTO> balances)
    {
        decimal GetBalance(AccountBalanceDTO a)
        {
            if (!accountTypes.ContainsKey(a.AccountCode)) return 0;
            var type = accountTypes[a.AccountCode];
            return (type == "Asset" || type == "Expense")
                ? a.Debit - a.Credit
                : a.Credit - a.Debit;
        }

        CashBalance = balances
            .Where(a => a.AccountCode == "1000" || a.AccountCode == "1010" || a.AccountCode == "1020")
            .Sum(a => a.Debit - a.Credit);

        var arAcct = balances.FirstOrDefault(a => a.AccountCode == "1100");
        ArOutstanding = arAcct != null ? arAcct.Debit - arAcct.Credit : 0;

        var apAcct = balances.FirstOrDefault(a => a.AccountCode == "2000");
        ApOutstanding = apAcct != null ? apAcct.Credit - apAcct.Debit : 0;

        TotalAssets = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Asset")
            .Sum(a => a.Debit - a.Credit);

        TotalLiabilities = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Liability")
            .Sum(a => a.Credit - a.Debit);

        var revenue = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Revenue")
            .Sum(a => a.Credit - a.Debit);

        var expense = balances
            .Where(a => accountTypes.ContainsKey(a.AccountCode) && accountTypes[a.AccountCode] == "Expense")
            .Sum(a => a.Debit - a.Credit);

        NetProfit = revenue - expense;
    }

    private string GetInflationChipStyle(decimal? value)
    {
        if (!value.HasValue) return "background: rgba(96, 125, 139, 0.1); color: #607D8B; font-weight: 600;";
        
        if (value < 2) return "background: rgba(76, 175, 80, 0.1); color: #4CAF50; font-weight: 600;";
        if (value <= 4) return "background: rgba(255, 193, 7, 0.1); color: #FFC107; font-weight: 600;";
        return "background: rgba(244, 67, 54, 0.1); color: #F44336; font-weight: 600;";
    }

    private string GetInflationStatus(decimal? value)
    {
        if (!value.HasValue) return "No Data";
        
        if (value < 2) return "Low";
        if (value <= 4) return "Moderate";
        return "High";
    }

    private decimal? GetPreviousInflationValue(string currentYear)
    {
        if (!int.TryParse(currentYear, out int year)) return null;
        
        var previousYear = (year - 1).ToString();
        var previousData = inflationData.FirstOrDefault(x => x.Date == previousYear);
        return previousData?.Value;
    }
}