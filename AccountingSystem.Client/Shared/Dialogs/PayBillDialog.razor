@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Components
@using AccountingSystem.Shared.Enums
@using MudBlazor
@inject PayableService PayableService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-2" />
            Record Bill Payment
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        <strong>Reference:</strong> @Bill.ReferenceNumber
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="text-right">
                        <strong>Balance:</strong> @Bill.Balance.ToString("C2")
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Payment Date"
                                   @bind-Date="date"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="Payment date is required"
                                   immediate="true"
                                   HelperText="Date the payment was made"
                                   MaxDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Amount to Pay"
                                     @bind-Value="model.Amount"
                                     Format="N2"
                                     Variant="Variant.Outlined"
                                     Min="0.01M"
                                     Max="@Bill.Balance"
                                     Required="true"
                                     RequiredError="Amount is required"
                                     Immediate="true"
                                     HelperText="@($"Maximum: {Bill.Balance:C2}")"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>

                <MudItem xs="12">
                    <AccountSelect @bind-SelectedAccountId="model.AssetAccountId"
                                   TypeFilter="Asset" />
                    <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                        Select the Cash/Bank account to withdraw funds from
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="PaymentMethod"
                               Label="Payment Method"
                               @bind-Value="model.PaymentMethod"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Payment method is required"
                               AnchorOrigin="Origin.BottomCenter"
                               HelperText="How the payment was made">
                        <MudSelectItem Value="@PaymentMethod.Cash">
                            <MudIcon Icon="@Icons.Material.Filled.Money" Size="Size.Small" Class="mr-2" />Cash
                        </MudSelectItem>
                        <MudSelectItem Value="@PaymentMethod.Check">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" />Check
                        </MudSelectItem>
                        <MudSelectItem Value="@PaymentMethod.BankTransfer">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Class="mr-2" />Bank Transfer
                        </MudSelectItem>
                        <MudSelectItem Value="@PaymentMethod.Online">
                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" Class="mr-2" />Online
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Reference Number"
                                  @bind-Value="model.ReferenceNumber"
                                  Variant="Variant.Outlined"
                                  Placeholder="Check No. / Trans ID"
                                  HelperText="Optional transaction reference" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Remarks"
                                  @bind-Value="model.Remarks"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  HelperText="Additional notes about this payment" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">
            Cancel
        </MudButton>
        <MudButton Color="Color.Warning"
                   OnClick="Submit"
                   Variant="Variant.Filled"
                   Disabled="@(!success || isSubmitting)"
                   StartIcon="@(isSubmitting ? null : Icons.Material.Filled.Payment)">
            @if (isSubmitting)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>Processing...</span>
            }
            else
            {
                <span>Pay Bill</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public BillDTO Bill { get; set; } = default!;

    private RecordPaymentDTO model = new();
    private DateTime? date = DateTime.Today;
    private MudForm form = default!;
    private bool success;
    private bool isSubmitting;

    protected override void OnInitialized()
    {
        model.ReferenceId = Bill.Id;
        model.Amount = Bill.Balance;
        model.PaymentMethod = PaymentMethod.Cash;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Please correct the validation errors.", Severity.Warning);
            return;
        }

        if (model.AssetAccountId == 0)
        {
            Snackbar.Add("Please select a source account.", Severity.Error);
            return;
        }

        isSubmitting = true;
        model.PaymentDate = date ?? DateTime.Today;

        try
        {
            await PayableService.PayBillAsync(model);
            Snackbar.Add("Payment recorded successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}