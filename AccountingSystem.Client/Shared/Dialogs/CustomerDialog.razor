@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject ReceivableService ReceivableService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
            @(Customer?.Id > 0 ? "Edit Customer" : "Create New Customer")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" Spacing="4">
            <MudTextField T="string"
                          Label="Customer Name"
                          Required="true"
                          RequiredError="Customer name is required"
                          @bind-Value="model.Name"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          HelperText="Full name or business name of the customer" />

            <MudTextField T="string"
                          Label="Email"
                          @bind-Value="model.Email"
                          Validation="@(new EmailAddressAttribute())"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          HelperText="Primary email address for communications" />

            <MudTextField T="string"
                          Label="Phone"
                          @bind-Value="model.Phone"
                          Variant="Variant.Outlined"
                          InputType="InputType.Telephone"
                          HelperText="Contact phone number" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">
            Cancel
        </MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Variant="Variant.Outlined"
                   Disabled="isSubmitting"
                   StartIcon="@(isSubmitting ? null : (Customer?.Id > 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Add))">
            @if (isSubmitting)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                @(Customer?.Id > 0 ? "Updating..." : "Creating...")
            }
            else
            {
                @(Customer?.Id > 0 ? "Update" : "Create")
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public CustomerDTO? Customer { get; set; }

    private CreateCustomerDTO model = new();
    private bool success;
    private bool isSubmitting;
    private MudForm form = default!;

    protected override void OnInitialized()
    {
        if (Customer != null)
        {
            model.Name = Customer.Name;
            model.Email = Customer.Email;
            model.Phone = Customer.Phone;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Please correct the validation errors.", Severity.Warning);
            return;
        }

        isSubmitting = true;

        try
        {
            if (Customer != null && Customer.Id > 0)
            {
                var updateDto = new UpdateCustomerDTO
                {
                    Id = Customer.Id,
                    Name = model.Name,
                    Email = model.Email,
                    Phone = model.Phone
                };

                await ReceivableService.UpdateCustomerAsync(updateDto);
                Snackbar.Add("Customer updated successfully!", Severity.Success);
            }
            else
            {
                await ReceivableService.CreateCustomerAsync(model);
                Snackbar.Add("Customer created successfully!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}