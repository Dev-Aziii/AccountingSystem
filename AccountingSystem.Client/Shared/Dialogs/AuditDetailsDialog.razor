@using AccountingSystem.Shared.DTOs
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="6">
                <MudText Typo="Typo.caption">User</MudText>
                <MudText><b>@Log.UserEmail</b></MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.caption">Timestamp</MudText>
                <MudText><b>@Log.Timestamp.ToLocalTime().ToString("g")</b></MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.caption">Action</MudText>
                <MudChip T="string" Size="Size.Small" Color="@GetColor(Log.Action)">@Log.Action</MudChip>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.caption">Target</MudText>
                <MudText>@Log.EntityName</MudText>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Request Payload / Changes</MudText>
                <MudPaper Class="pa-3 mud-theme-dark" Elevation="0" Style="max-height: 300px; overflow: auto;">
                    <pre style="font-family: monospace; font-size: 0.8rem; white-space: pre-wrap;">@FormatJson(Log.Changes)</pre>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public AuditLogDTO Log { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private Color GetColor(string action) => action switch
    {
        "POST" => Color.Success,
        "PUT" => Color.Warning,
        "DELETE" => Color.Error,
        "LOGIN" => Color.Info, // NEW: Handle LOGIN color
        _ => Color.Default
    };

    private string FormatJson(string json)
    {
        if (string.IsNullOrEmpty(json)) return "No content";
        try
        {
            // Simple prettify attempt
            var parsed = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json; // Return raw if not valid JSON
        }
    }
}