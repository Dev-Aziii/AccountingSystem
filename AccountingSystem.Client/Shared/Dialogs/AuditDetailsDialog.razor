@using AccountingSystem.Shared.DTOs
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Outlined.History" Class="mr-2" />
            Audit Log Details
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">User</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="mr-1" />
                        <strong>@Log.UserEmail</strong>
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Timestamp</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" Class="mr-1" />
                        <strong>@Log.Timestamp.ToLocalTime().ToString("g")</strong>
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Action</MudText>
                    <div class="mt-1">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetActionColor(Log.Action)"
                                 Icon="@GetActionIcon(Log.Action)">
                            @Log.Action
                        </MudChip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Target Entity</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Outlined.Label" Size="Size.Small" Class="mr-1" />
                        <strong>@Log.EntityName</strong>
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Small" Class="mr-1" />
            Request Payload / Changes
        </MudText>
        <MudPaper Class="pa-3"
                  Elevation="1"
                  Style="max-height: 400px; overflow: auto; background-color: #1e1e1e; border-radius: 4px;">
            <pre style="font-family: 'Courier New', monospace; font-size: 0.85rem; white-space: pre-wrap; color: #d4d4d4; margin: 0;">@FormatJson(Log.Changes)</pre>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AuditLogDTO Log { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private Color GetActionColor(string action)
    {
        if (action == "LOGIN") return Color.Dark;

        if (action.StartsWith("USER-")) return Color.Tertiary;       // Purple for User Mgmt
        if (action.StartsWith("CUSTOMER-")) return Color.Info;       // Blue for AR
        if (action.StartsWith("VENDOR-")) return Color.Warning;      // Orange for AP
        if (action.StartsWith("ACCOUNT-")) return Color.Success;     // Green for GL
        if (action.StartsWith("BILL-")) return Color.Error;          // Red/Pink for Expenses
        if (action.StartsWith("INVOICE-")) return Color.Primary;     // Primary for Revenue
        if (action == "JOURNAL-ENTRY") return Color.Surface;         // Neutral for Journals

        // Fallbacks for raw HTTP methods
        return action switch
        {
            "POST" => Color.Success,
            "PUT" => Color.Warning,
            "DELETE" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetActionIcon(string action)
    {
        if (action == "LOGIN") return Icons.Material.Outlined.Login;

        if (action.StartsWith("USER-")) return Icons.Material.Outlined.Person;
        if (action.StartsWith("CUSTOMER-")) return Icons.Material.Outlined.Person;
        if (action.StartsWith("VENDOR-")) return Icons.Material.Outlined.Business;
        if (action.StartsWith("ACCOUNT-")) return Icons.Material.Outlined.AccountBalance;
        if (action.StartsWith("BILL-")) return Icons.Material.Outlined.Receipt;
        if (action.StartsWith("INVOICE-")) return Icons.Material.Outlined.Receipt;
        if (action == "JOURNAL-ENTRY") return Icons.Material.Outlined.Book;

        // Fallbacks for raw HTTP methods
        return action switch
        {
            "POST" => Icons.Material.Outlined.Add,
            "PUT" => Icons.Material.Outlined.Edit,
            "DELETE" => Icons.Material.Outlined.Delete,
            _ => Icons.Material.Outlined.Circle
        };
    }

    private string FormatJson(string json)
    {
        if (string.IsNullOrEmpty(json)) return "No content";

        try
        {
            var parsed = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                parsed,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                });
        }
        catch
        {
            return json;
        }
    }
}