@using AccountingSystem.Client.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
    @foreach (var toast in toasts)
    {
        <div class="toast show align-items-center text-white @GetBgClass(toast.Level) border-0 mb-2 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="@GetIconClass(toast.Level) me-2"></i> @toast.Message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => RemoveToast(toast)"></button>
            </div>
        </div>
    }
</div>

@code {
    private List<ToastMessage> toasts = new List<ToastMessage>();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private void ShowToast(string message, ToastLevel level)
    {
        var toast = new ToastMessage { Message = message, Level = level, Id = Guid.NewGuid() };
        toasts.Add(toast);
        StateHasChanged();

        // Auto-dismiss after 4 seconds
        var timer = new System.Timers.Timer(4000);
        timer.Elapsed += (sender, args) => { RemoveToast(toast); timer.Dispose(); };
        timer.AutoReset = false;
        timer.Start();
    }

    private void RemoveToast(ToastMessage toast)
    {
        // Use InvokeAsync because this might be called from a Timer thread
        InvokeAsync(() =>
        {
            toasts.Remove(toast);
            StateHasChanged();
        });
    }

    private string GetBgClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bg-success",
        ToastLevel.Error => "bg-danger",
        ToastLevel.Warning => "bg-warning text-dark",
        ToastLevel.Info => "bg-info",
        _ => "bg-primary"
    };

    private string GetIconClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bi bi-check-circle-fill",
        ToastLevel.Error => "bi bi-exclamation-triangle-fill",
        ToastLevel.Warning => "bi bi-exclamation-circle-fill",
        ToastLevel.Info => "bi bi-info-circle-fill",
        _ => "bi bi-info-circle"
    };

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }

    private class ToastMessage
    {
        public Guid Id { get; set; }
        public string Message { get; set; }
        public ToastLevel Level { get; set; }
    }
}