@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@inject PayableService PayableService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="Admin,Accounting">
    <MudSelect T="int" Label="Vendor" Value="SelectedVendorId" ValueChanged="OnValueChanged"
               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Add" OnAdornmentClick="OpenAddDialog"
               Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem Value="0">-- Select Vendor --</MudSelectItem>
        @if (vendors != null)
        {
            foreach (var v in vendors)
            {
                <MudSelectItem Value="@v.Id">@v.Name</MudSelectItem>
            }
        }
    </MudSelect>
</Microsoft.AspNetCore.Components.Authorization.AuthorizeView>

@code {
    [Parameter] public int SelectedVendorId { get; set; }
    [Parameter] public EventCallback<int> SelectedVendorIdChanged { get; set; }

    private List<VendorDTO> vendors;

    protected override async Task OnInitializedAsync() => await LoadVendors();

    private async Task LoadVendors()
    {
        try { vendors = await PayableService.GetVendorsAsync(); }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task OnValueChanged(int id)
    {
        SelectedVendorId = id;
        await SelectedVendorIdChanged.InvokeAsync(id);
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<VendorDialog>("Add New Vendor", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadVendors();
            // The dialog returns true if saved, we assume the last added is the one we want or just let user pick
            // To be precise, we could make the dialog return the ID, but for now we refresh list.
            Snackbar.Add("Vendor list refreshed.", Severity.Info);
        }
    }
}