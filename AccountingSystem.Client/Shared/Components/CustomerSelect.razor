@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@using AccountingSystem.Client.Shared.Dialogs
@inject ReceivableService ReceivableService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="Admin,Accounting,Management">
    <MudSelect T="int" Label="Customer" Value="SelectedCustomerId" ValueChanged="OnValueChanged"
               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Add" OnAdornmentClick="OpenAddDialog"
               Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem Value="0">-- Select Customer --</MudSelectItem>
        @if (customers != null)
        {
            foreach (var c in customers)
            {
                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
            }
        }
    </MudSelect>
</Microsoft.AspNetCore.Components.Authorization.AuthorizeView>

@code {
    [Parameter] public int SelectedCustomerId { get; set; }
    [Parameter] public EventCallback<int> SelectedCustomerIdChanged { get; set; }

    private List<CustomerDTO> customers;

    protected override async Task OnInitializedAsync() => await LoadCustomers();

    private async Task LoadCustomers()
    {
        try { customers = await ReceivableService.GetCustomersAsync(); }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task OnValueChanged(int id)
    {
        SelectedCustomerId = id;
        await SelectedCustomerIdChanged.InvokeAsync(id);
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CustomerDialog>("Add New Customer", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCustomers();
            Snackbar.Add("Customer list refreshed.", Severity.Info);
        }
    }
}