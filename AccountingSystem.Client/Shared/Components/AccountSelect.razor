@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@inject LedgerService LedgerService

<Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="Admin,Accounting">
    <div class="input-group">
        <select class="form-select" value="@SelectedAccountId" @onchange="OnValueChanged">
            <option value="0">-- Select Account --</option>
            @if (accounts != null)
            {
                foreach (var a in accounts)
                {
                    <option value="@a.Id">@a.Code - @a.Name (@a.Type)</option>
                }
            }
        </select>
        <button class="btn btn-outline-success" type="button" @onclick="OpenAddModal" title="Add New Account">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>
</Microsoft.AspNetCore.Components.Authorization.AuthorizeView>

<AccountModal @ref="modal" OnSaved="HandleAccountSaved" />

@code {
    [Parameter] public int SelectedAccountId { get; set; }
    [Parameter] public EventCallback<int> SelectedAccountIdChanged { get; set; }
    [Parameter] public string? TypeFilter { get; set; }

    private List<AccountDTO> accounts;
    private AccountModal modal;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        try
        {
            var allAccounts = await LedgerService.GetAccountsAsync();
            if (!string.IsNullOrEmpty(TypeFilter))
            {
                accounts = allAccounts.Where(a => a.Type.Equals(TypeFilter, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            else
            {
                accounts = allAccounts;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex.Message}");
        }
    }

    private async Task OnValueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out int id))
        {
            SelectedAccountId = id;
            await SelectedAccountIdChanged.InvokeAsync(id);
        }
    }

    private void OpenAddModal()
    {
        modal.OpenCreate();
    }

    private async Task HandleAccountSaved(AccountDTO newAccount)
    {
        // If there is a TypeFilter, ensure the new account matches it before reloading
        if (!string.IsNullOrEmpty(TypeFilter) && !newAccount.Type.Equals(TypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            // Optional: alert user that the account was created but isn't visible in this specific dropdown
        }

        await LoadAccounts();

        // Auto-select if it's in the list
        if (accounts.Any(a => a.Id == newAccount.Id))
        {
            SelectedAccountId = newAccount.Id;
            await SelectedAccountIdChanged.InvokeAsync(newAccount.Id);
        }
    }
}