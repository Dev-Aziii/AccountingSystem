@using AccountingSystem.Shared.DTOs
@using AccountingSystem.Client.Services
@inject ReceivableService ReceivableService

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">@(IsEditMode ? "Edit Customer" : "Add New Customer")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Customer Name</label>
                            <InputText @bind-Value="model.Name" class="form-control" />
                            <ValidationMessage For="@(() => model.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="model.Email" class="form-control" />
                            <ValidationMessage For="@(() => model.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <InputText @bind-Value="model.Phone" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-info text-white" disabled="@isSubmitting">
                                @(isSubmitting ? "Saving..." : "Save Customer")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<CustomerDTO> OnSaved { get; set; }

    private bool ShowModal = false;
    private bool IsEditMode = false;
    private CreateCustomerDTO model = new CreateCustomerDTO();
    private int editingId = 0;
    private string errorMessage;
    private bool isSubmitting = false;

    public void OpenCreate()
    {
        model = new CreateCustomerDTO();
        IsEditMode = false;
        errorMessage = null;
        ShowModal = true;
        StateHasChanged();
    }

    public void OpenEdit(CustomerDTO customer)
    {
        model = new CreateCustomerDTO
        {
            Name = customer.Name,
            Email = customer.Email,
            Phone = customer.Phone
        };
        editingId = customer.Id;
        IsEditMode = true;
        errorMessage = null;
        ShowModal = true;
        StateHasChanged();
    }

    private void Close()
    {
        ShowModal = false;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            CustomerDTO result;
            if (IsEditMode)
            {
                var updateDto = new UpdateCustomerDTO
                {
                    Id = editingId,
                    Name = model.Name,
                    Email = model.Email,
                    Phone = model.Phone
                };
                await ReceivableService.UpdateCustomerAsync(updateDto);
                result = new CustomerDTO { Id = editingId, Name = model.Name, Email = model.Email, Phone = model.Phone };
            }
            else
            {
                result = await ReceivableService.CreateCustomerAsync(model);
            }

            await OnSaved.InvokeAsync(result);
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}